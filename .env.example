# Copia este archivo como .env y rellena los datos de Project Settings → API en Supabase.
# La clave "anon" / "publishable" es pública por diseño: la seguridad la dan las reglas de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
# Email de contacto que aparece en la política de privacidad
VITE_CONTACT_EMAIL=tu-email@ejemplo.com

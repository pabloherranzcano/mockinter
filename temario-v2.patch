-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-J3', 'ANG-05', 'Junior', 'mc', '¿Qué hace `providedIn: ''root''`?', null, 'Crea una única instancia compartida en toda la app y permite tree-shaking', array['Crea una instancia por componente', 'Solo funciona en AppComponent', 'Obliga a declararlo en cada módulo']::text[], 'Si nadie lo inyecta, el build lo elimina.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-J4', 'ANG-05', 'Junior', 'open', '¿Qué es la inyección de dependencias y por qué es útil?', 'What is dependency injection and why is it useful?', null, '{}'::text[], null, null, null, 'class receives dependencies instead of creating them; Angular injector provides instances; loose coupling; easy to test with mocks; singletons/shared instances', 'Dependency injection means a class receives what it needs instead of creating it itself. In Angular, the injector creates the services and gives them to components through the constructor or the inject function. It reduces coupling, makes it easy to share one instance, and above all makes testing easier, because you can replace a real service with a fake one.', 'La inyección de dependencias significa que una clase recibe lo que necesita en lugar de crearlo ella misma. En Angular, el inyector crea los servicios y se los da a los componentes por el constructor o con la función inject. Reduce el acoplamiento, facilita compartir una única instancia y, sobre todo, facilita los tests, porque puedes sustituir un servicio real por uno falso.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-M1', 'ANG-05', 'Mid', 'mc', '¿Cómo haces lazy loading de un componente standalone?', null, 'loadComponent: () => import(''./admin.component'').then(m => m.AdminComponent)', array['component: AdminComponent, lazy: true', 'Importándolo arriba en app.routes.ts', 'children: [AdminComponent]']::text[], 'El import() dinámico genera un chunk aparte que solo se descarga al entrar en la ruta.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-M2', 'ANG-05', 'Mid', 'mc', 'Dentro de un interceptor, ¿cómo añades una cabecera?', null, 'next(req.clone({ setHeaders: { Authorization: `Bearer ${token}` } }))', array['req.headers.set(...) y devolver req', 'Modificar window.fetch', 'Añadirla en cada servicio']::text[], 'HttpRequest es inmutable: hay que clonarla.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-M3', 'ANG-05', 'Mid', 'mc', 'Un CanActivateFn quiere mandar al usuario a /login. ¿Qué devuelve?', null, 'router.createUrlTree([''/login''])', array['false y luego router.navigate', 'Un componente LoginComponent', 'Un error']::text[], 'Devolver un UrlTree es la forma recomendada: evita navegaciones dobles.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-M4', 'ANG-05', 'Mid', 'open', '¿Cómo añadirías un token a todas las peticiones HTTP y qué harías ante un 401?', 'How would you add a token to every HTTP request, and what would you do on a 401?', null, '{}'::text[], null, null, null, 'functional interceptor with withInterceptors; inject auth service; clone with setHeaders; skip public URLs; catchError 401: refresh token and retry once, else logout and redirect', 'I''d write a functional interceptor and register it with provideHttpClient and withInterceptors. It injects the auth service, clones the request and adds the Authorization header, skipping public endpoints like login. On the response I add catchError: if I get a 401, I try to refresh the token once and retry; if that fails, I clear the session and redirect to the login page.', 'Escribiría un interceptor funcional y lo registraría con provideHttpClient y withInterceptors. El interceptor inyecta el servicio de autenticación, clona la petición y añade la cabecera Authorization, salvo en endpoints públicos como el login. En la respuesta añado catchError: si llega un 401, intento refrescar el token una vez y repito la petición; si falla, cierro la sesión y redirijo a la pantalla de login.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-S1', 'ANG-05', 'Senior', 'mc', '¿Qué jerarquías de inyectores existen en Angular?', null, 'Environment injectors (raíz, rutas lazy) y element injectors (componentes y directivas)', array['Solo hay un inyector global', 'Un inyector por petición HTTP', 'Los inyectores solo existen en tests']::text[], 'Proveer un servicio en un componente crea una instancia nueva para ese subárbol.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-S2', 'ANG-05', 'Senior', 'mc', '¿Para qué sirve un InjectionToken?', null, 'Para inyectar valores que no son clases, como configuración o funciones', array['Para cifrar tokens JWT', 'Para crear rutas', 'Para sustituir a los guards']::text[], 'Ejemplo: un token API_URL con el valor que cambia por entorno.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-S3', 'ANG-05', 'Senior', 'mc', '¿Qué estrategia de precarga carga los módulos lazy en segundo plano tras el arranque?', null, 'PreloadAllModules (o una estrategia propia)', array['NoPreloading', 'EagerLoading', 'Server preloading']::text[], 'Una estrategia propia permite precargar solo las rutas con más probabilidad de visitarse.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-S4', 'ANG-05', 'Senior', 'open', '¿Cómo organizarías la capa de acceso a la API en un proyecto grande?', 'How would you organize the API layer in a large project?', null, '{}'::text[], null, null, null, 'typed services per domain; DTOs vs domain models with mapping; generated clients from OpenAPI; interceptors for auth, errors, loading; environment config via injection token; caching strategy; error handling consistent; tests with HttpTestingController', 'I''d create typed services per domain, ideally generated from the backend''s OpenAPI spec so the contracts stay in sync. I''d map the API DTOs to the models the UI needs, so backend changes don''t spread everywhere. Cross-cutting concerns like auth, errors and retries go in interceptors, and the base URL comes from an injection token per environment. And I''d test the services with HttpTestingController.', 'Crearía servicios tipados por dominio, idealmente generados a partir de la especificación OpenAPI del backend, para que los contratos estén siempre sincronizados. Transformaría los DTO de la API en los modelos que necesita la interfaz, para que los cambios del backend no se propaguen por todas partes. Lo transversal, como autenticación, errores y reintentos, iría en interceptores, y la URL base vendría de un injection token por entorno. Y testearía los servicios con HttpTestingController.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-J1', 'ANG-06', 'Junior', 'mc', '¿Qué hace `fixture.detectChanges()`?', null, 'Ejecuta la detección de cambios para que la plantilla refleje el estado (y la primera vez dispara ngOnInit)', array['Reinicia el TestBed', 'Mockea los servicios', 'Compila los estilos']::text[], 'En los tests no hay detección automática: si no lo llamas, el DOM no cambia.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-J2', 'ANG-06', 'Junior', 'mc', '¿Qué es un test unitario?', null, 'Un test que comprueba una pieza aislada (un servicio, un componente) sin dependencias reales', array['Un test que abre la app en un navegador real', 'Una prueba manual', 'Un test de carga']::text[], 'Los E2E prueban la app completa como un usuario; los unitarios, una pieza aislada.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-J3', 'ANG-06', 'Junior', 'fill', 'Para sustituir un servicio real por uno falso en TestBed se usa { provide: UserService, ___: fakeService }.', null, 'useValue', array['useReal', 'inject', 'mock']::text[], 'También existen useClass y useFactory.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-J4', 'ANG-06', 'Junior', 'open', '¿Por qué son importantes los tests en un proyecto frontend?', 'Why are tests important in a frontend project?', null, '{}'::text[], null, null, null, 'catch regressions; confidence to refactor; documentation of behaviour; faster feedback than manual testing; CI; better design', 'Tests catch regressions before users do, and they give you the confidence to refactor without breaking things. They also document how a component is supposed to behave. And when they run in the CI pipeline, the team gets fast feedback on every change, which is much cheaper than finding bugs manually later.', 'Los tests detectan regresiones antes que los usuarios y dan confianza para refactorizar sin romper nada. También documentan cómo debe comportarse un componente. Y cuando se ejecutan en el pipeline de CI, el equipo recibe feedback rápido en cada cambio, que es mucho más barato que encontrar los errores a mano más tarde.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-M1', 'ANG-06', 'Mid', 'mc', '¿Cómo testeas llamadas HTTP sin backend real?', null, 'provideHttpClientTesting() y HttpTestingController (expectOne, flush, verify)', array['Con una API real de pruebas', 'Con setTimeout', 'Con RouterTestingModule']::text[], 'verify() asegura que no quedan peticiones sin responder.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-M2', 'ANG-06', 'Mid', 'mc', '¿Para qué sirven `fakeAsync` y `tick()`?', null, 'Para simular el paso del tiempo (timers, debounceTime) de forma síncrona', array['Para ejecutar tests en paralelo', 'Para medir la red', 'Para saltarse tests']::text[], 'tick(300) adelanta el reloj virtual 300 ms.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-M3', 'ANG-06', 'Mid', 'mc', '¿Qué es mejor comprobar en un test de componente?', null, 'Lo que ve y hace el usuario (texto, botones, eventos), no los detalles internos', array['Que se llamen todos los métodos privados', 'El número de líneas del componente', 'Los estilos CSS exactos']::text[], 'Los tests centrados en comportamiento sobreviven a los refactors.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-M4', 'ANG-06', 'Mid', 'open', '¿Cómo testearías un componente que carga usuarios desde un servicio y los muestra?', 'How would you test a component that loads users from a service and displays them?', null, '{}'::text[], null, null, null, 'TestBed; fake service with useValue returning of([...]); detectChanges; query DOM and assert items; empty, loading and error states (throwError)', 'I''d configure TestBed with the component and a fake UserService provided with useValue, returning of() with two users. I call detectChanges, query the list items and check there are two with the right names. Then separate tests for the empty state and for an error, making the fake return throwError and checking the error message is shown.', 'Configuraría TestBed con el componente y un UserService falso con useValue que devuelva of() con dos usuarios. Llamo a detectChanges, busco los elementos de la lista y compruebo que hay dos con los nombres correctos. Después haría tests aparte para el estado vacío y para un error, haciendo que el servicio falso devuelva throwError y comprobando que aparece el mensaje de error.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-S1', 'ANG-06', 'Senior', 'mc', '¿Qué describe la pirámide de tests?', null, 'Muchos tests unitarios, menos de integración y pocos E2E, por coste y velocidad', array['Muchos E2E y pocos unitarios', 'Solo tests manuales', 'Un test por archivo']::text[], 'Los E2E son caros y lentos; se reservan para los flujos críticos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-S2', 'ANG-06', 'Senior', 'mc', 'Un test E2E falla de vez en cuando sin cambios en el código (flaky). ¿Qué haces?', null, 'Investigar la causa (esperas fijas, datos compartidos, dependencias externas) y corregirla; aislarlo mientras tanto', array['Añadir reintentos infinitos', 'Borrarlo', 'Ignorar el pipeline']::text[], 'Los tests flaky destruyen la confianza en la suite. Esperar a condiciones, no a tiempos fijos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-S3', 'ANG-06', 'Senior', 'mc', '¿Qué es cierto sobre la cobertura de código?', null, 'Es una señal útil pero no garantiza calidad: puedes tener 90% sin comprobar nada importante', array['100% de cobertura significa cero bugs', 'No sirve para nada', 'Solo se mide en E2E']::text[], 'Mejor fijar mínimos razonables y revisar qué se prueba, no solo cuánto.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-06-S4', 'ANG-06', 'Senior', 'open', '¿Cómo definirías la estrategia de testing de un equipo frontend?', 'How would you define the testing strategy for a frontend team?', null, '{}'::text[], null, null, null, 'test pyramid; unit for logic and components; integration for features; few E2E for critical flows (Playwright/Cypress); runner choice (Vitest/Jest/Karma); CI gates; coverage as guide; testing behaviour not implementation; fixtures/mocks; code review', 'I''d follow the test pyramid: unit tests for services and components focused on behaviour, some integration tests for full features, and a small set of E2E tests with Playwright or Cypress for the critical flows like login or checkout. All of them run in CI and block merges when they fail. Coverage is a guide, not a goal. And tests are part of code review, so the whole team owns them.', 'Seguiría la pirámide de tests: tests unitarios de servicios y componentes centrados en el comportamiento, algunos tests de integración de funcionalidades completas y un conjunto pequeño de E2E con Playwright o Cypress para los flujos críticos, como el login o el pago. Todos se ejecutan en CI y bloquean el merge si fallan. La cobertura es una guía, no un objetivo. Y los tests forman parte de la code review, para que todo el equipo se responsabilice de ellos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-J1', 'REA-01', 'Junior', 'mc', '¿Qué es JSX?', null, 'Una sintaxis parecida a HTML que se compila a llamadas de JavaScript para crear elementos', array['Un lenguaje distinto de JavaScript que el navegador entiende directamente', 'Un motor de plantillas del servidor', 'Un framework CSS']::text[], 'El navegador no entiende JSX: un compilador (Babel, SWC, esbuild) lo transforma.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-J2', 'REA-01', 'Junior', 'mc', '¿Diferencia entre props y estado?', null, 'Las props llegan del padre y son de solo lectura; el estado es interno y el componente lo cambia', array['Son lo mismo', 'El estado llega del padre', 'Las props solo pueden ser strings']::text[], 'Si cambia el estado o llegan props nuevas, el componente se vuelve a renderizar.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-J3', 'REA-01', 'Junior', 'fill', 'Al pintar una lista con map(), cada elemento necesita una prop ___ única y estable.', null, 'key', array['id', 'ref', 'index']::text[], 'Usar el índice como key da problemas si la lista se reordena o se filtra.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-J4', 'REA-01', 'Junior', 'open', '¿Qué es un componente en React?', 'What is a component in React?', null, '{}'::text[], null, null, null, 'reusable piece of UI; function that receives props and returns JSX; can have state with hooks; composition', 'A component is a reusable piece of the user interface. In modern React it''s just a function that receives props and returns JSX describing what to show. It can have its own state with hooks like useState, and you build the app by composing small components into bigger ones.', 'Un componente es una pieza reutilizable de la interfaz. En React moderno es simplemente una función que recibe props y devuelve JSX describiendo lo que hay que mostrar. Puede tener su propio estado con hooks como useState, y la aplicación se construye combinando componentes pequeños en otros más grandes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-M1', 'REA-01', 'Mid', 'mc', '¿Por qué no se debe mutar el estado directamente (p. ej. `items.push(x)`)?', null, 'React compara referencias: si mutas, la referencia no cambia y puede no volver a renderizar', array['Porque push no existe en React', 'Porque el estado es una constante de TypeScript', 'No hay ningún problema']::text[], 'Crea copias: setItems([...items, x]).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-M2', 'REA-01', 'Mid', 'mc', '¿Qué es un componente controlado en un formulario?', null, 'Un input cuyo valor viene del estado de React y se actualiza con onChange', array['Un input que gestiona el DOM por su cuenta', 'Un componente con PropTypes', 'Un componente sin props']::text[], 'El no controlado guarda el valor en el DOM y se lee con una ref.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-M3', 'REA-01', 'Mid', 'mc', '¿Qué es el ''lifting state up''?', null, 'Subir el estado al ancestro común cuando varios componentes lo necesitan', array['Guardar el estado en localStorage', 'Usar Redux siempre', 'Pasar el estado a un hijo']::text[], 'El padre guarda el estado y lo pasa por props, junto con funciones para cambiarlo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-M4', 'REA-01', 'Mid', 'open', '¿Qué pasa cuando cambia el estado de un componente?', 'What happens when a component''s state changes?', null, '{}'::text[], null, null, null, 'React schedules a re-render; component function runs again; new virtual tree compared with previous (reconciliation); minimal DOM updates; children re-render too unless memoized; batching', 'When state changes, React schedules a re-render: it calls the component function again and gets a new description of the UI. Then it compares it with the previous one, which is called reconciliation, and only updates the parts of the DOM that actually changed. By default the children re-render too, and several state updates in the same event are batched together.', 'Cuando cambia el estado, React programa un nuevo renderizado: vuelve a llamar a la función del componente y obtiene una nueva descripción de la interfaz. Después la compara con la anterior, lo que se llama reconciliación, y solo actualiza en el DOM lo que ha cambiado de verdad. Por defecto también se vuelven a renderizar los hijos, y varias actualizaciones de estado en el mismo evento se agrupan.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-S1', 'REA-01', 'Senior', 'mc', '¿Qué es la reconciliación?', null, 'El proceso por el que React compara el árbol anterior con el nuevo y decide qué cambiar en el DOM', array['Un patrón de Redux', 'La fusión de ramas en Git', 'La hidratación del servidor']::text[], 'Las keys y el tipo de elemento guían ese algoritmo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-S2', 'REA-01', 'Senior', 'mc', '¿Qué ventaja tiene la composición (children, props de render) frente a la herencia en React?', null, 'Componentes más flexibles y reutilizables sin jerarquías rígidas', array['Mejor rendimiento siempre', 'Es obligatoria en TypeScript', 'Ninguna']::text[], 'React recomienda composición; la herencia entre componentes casi nunca se usa.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-S3', 'REA-01', 'Senior', 'mc', '¿Qué aportan los Server Components (p. ej. en Next.js)?', null, 'Se renderizan en el servidor, pueden acceder a datos directamente y no envían su JavaScript al cliente', array['Sustituyen a los hooks en el cliente', 'Funcionan sin servidor', 'Solo sirven para CSS']::text[], 'Los componentes interactivos siguen siendo de cliente (''use client'').', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-01-S4', 'REA-01', 'Senior', 'open', '¿Cómo estructurarías una aplicación React grande?', 'How would you structure a large React application?', null, '{}'::text[], null, null, null, 'feature-based folders; shared UI/design system; separation of server state and UI state; routing; data layer; TypeScript; linting and testing; conventions documented; avoid premature abstraction', 'I''d organize it by features instead of by file type, with a shared design system for common UI. I''d separate server state, handled with something like TanStack Query, from local UI state. TypeScript everywhere, a clear routing structure, and a data layer that hides the API details. Plus linting, tests and written conventions, so the codebase stays consistent as the team grows.', 'La organizaría por funcionalidades en lugar de por tipo de archivo, con un design system compartido para la interfaz común. Separaría el estado del servidor, gestionado con algo como TanStack Query, del estado local de la interfaz. TypeScript en todo el proyecto, una estructura de rutas clara y una capa de datos que oculte los detalles de la API. Además, linting, tests y convenciones por escrito, para que el código siga siendo coherente a medida que crece el equipo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-J1', 'REA-02', 'Junior', 'mc', '¿Qué devuelve `useState`?', null, 'Un array con el valor actual y una función para cambiarlo', array['Solo el valor', 'Una promesa', 'Un objeto con get y set']::text[], 'const [count, setCount] = useState(0).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-J2', 'REA-02', 'Junior', 'mc', '¿Cuándo se ejecuta `useEffect(() => {...}, [])`?', null, 'Una vez tras el primer render (y su limpieza al desmontar)', array['En cada render', 'Antes del primer render', 'Nunca']::text[], 'En desarrollo con StrictMode se ejecuta dos veces a propósito para detectar efectos mal limpiados.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-J3', 'REA-02', 'Junior', 'fill', 'Los hooks solo se pueden llamar en el nivel superior de un componente, nunca dentro de ___.', null, 'condiciones o bucles', array['funciones flecha', 'archivos .tsx', 'componentes']::text[], 'React identifica cada hook por su orden de llamada; si cambia el orden, se rompe.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-J4', 'REA-02', 'Junior', 'open', '¿Qué son los hooks?', 'What are hooks?', null, '{}'::text[], null, null, null, 'functions that let function components use state and other React features; useState, useEffect, useContext; rules of hooks; custom hooks to reuse logic', 'Hooks are functions that let function components use React features like state and side effects. The most common are useState, useEffect and useContext. They have two rules: call them at the top level, and only from components or other hooks. You can also write custom hooks to reuse logic between components.', 'Los hooks son funciones que permiten a los componentes de función usar características de React como el estado o los efectos secundarios. Los más comunes son useState, useEffect y useContext. Tienen dos reglas: llamarlos siempre en el nivel superior y solo desde componentes u otros hooks. También puedes crear hooks propios para reutilizar lógica entre componentes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-M1', 'REA-02', 'Mid', 'mc', '¿Para qué sirve la función de limpieza de useEffect?', null, 'Para deshacer lo que hizo el efecto (desuscribirse, cancelar timers o peticiones) antes del siguiente efecto o al desmontar', array['Para limpiar el estado', 'Para borrar el DOM', 'Para reiniciar el componente']::text[], 'Sin limpieza aparecen fugas y actualizaciones de estado en componentes desmontados.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-M2', 'REA-02', 'Mid', 'mc', '¿Diferencia entre `useMemo` y `useCallback`?', null, 'useMemo memoriza un valor calculado; useCallback memoriza una función', array['Son lo mismo', 'useCallback memoriza valores y useMemo funciones', 'Solo funcionan en clases']::text[], 'useCallback(fn, deps) equivale a useMemo(() => fn, deps).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-M3', 'REA-02', 'Mid', 'mc', '¿Para qué se usa `useRef`?', null, 'Guardar un valor que persiste entre renders sin provocar re-render, o referenciar un elemento del DOM', array['Para el estado global', 'Para hacer peticiones', 'Para memorizar funciones']::text[], 'Cambiar ref.current no vuelve a renderizar.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-M4', 'REA-02', 'Mid', 'open', '¿Cómo harías un custom hook para pedir datos a una API?', 'How would you write a custom hook to fetch data from an API?', null, '{}'::text[], null, null, null, 'useState for data, loading, error; useEffect depending on url; AbortController to cancel; cleanup; return object; mention TanStack Query for real apps (caching, retries)', 'I''d create a useFetch hook with state for data, loading and error. Inside a useEffect that depends on the URL, I''d start the request with an AbortController and cancel it in the cleanup, so we don''t update state after unmount or with stale responses. It returns data, loading and error. In a real project, though, I''d probably use TanStack Query, because it adds caching, retries and refetching for free.', 'Crearía un hook useFetch con estado para los datos, la carga y el error. Dentro de un useEffect que depende de la URL, lanzaría la petición con un AbortController y la cancelaría en la función de limpieza, para no actualizar el estado tras desmontar el componente ni con respuestas antiguas. Devuelve data, loading y error. Aunque en un proyecto real seguramente usaría TanStack Query, porque ya trae caché, reintentos y recarga de datos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-S1', 'REA-02', 'Senior', 'mc', 'Un useEffect se ejecuta en bucle infinito. ¿Causa más probable?', null, 'Una dependencia que se recrea en cada render (objeto, array o función) o un setState que cambia una dependencia', array['React está mal instalado', 'Falta un key', 'El componente es demasiado grande']::text[], 'Soluciones: memorizar la dependencia, mover el objeto fuera o replantear si el efecto es necesario.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-02-S2', 'REA-02', 'Senior', 'mc', '¿Qué dice la guía ''You might not need an effect''?', null, 'Muchos efectos sobran: los valores derivados se calculan en el render y las acciones del usuario van en los manejadores de eventos', array['Hay que usar efectos para todo', 'Los efectos están obsoletos', 'Solo se usan efectos en clases']::text[], 'Los efectos son para sincronizar con sistemas externos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;

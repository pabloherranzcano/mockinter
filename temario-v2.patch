-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-01-M4', 'ANG-01', 'Mid', 'open', '¿Cómo diseñarías un componente reutilizable, por ejemplo una tabla, para usarlo en varias pantallas?', 'How would you design a reusable component, for example a table, to use across several screens?', null, '{}'::text[], null, null, null, 'clear inputs/outputs API; presentational (dumb) component without business logic; content projection or ng-template for custom cells; OnPush; typed inputs; accessibility; documented and tested', 'I''d make it a presentational component: it receives data and configuration through inputs and emits events like sort or row click through outputs, without calling services itself. For custom cells I''d accept templates with ng-template, so each screen decides how to render them. I''d use OnPush, strong typing for the column config, and make sure it''s accessible. Then I''d document the API and write tests for the main behaviours.', 'Lo haría como un componente de presentación: recibe los datos y la configuración por inputs y emite eventos, como ordenar o hacer clic en una fila, por outputs, sin llamar a servicios. Para celdas personalizadas aceptaría plantillas con ng-template, para que cada pantalla decida cómo pintarlas. Usaría OnPush, tiparía bien la configuración de columnas y cuidaría la accesibilidad. Después documentaría su API y le haría tests de los comportamientos principales.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-01-S1', 'ANG-01', 'Senior', 'mc', 'En una app grande, ¿cuál es una buena forma de organizar el código?', null, 'Por funcionalidades (feature folders) con límites claros, librerías compartidas y carga perezosa', array['Una carpeta por tipo de archivo: todos los componentes juntos, todos los servicios juntos', 'Todo en un único módulo para evitar imports', 'Un repositorio por componente']::text[], 'Agrupar por dominio escala mejor. Herramientas como Nx ayudan a imponer los límites entre módulos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-01-S2', 'ANG-01', 'Senior', 'mc', '¿Qué aportan los microfrontends y cuál es su principal coste?', null, 'Despliegues independientes por equipo, a cambio de más complejidad (versionado, dependencias compartidas, consistencia visual)', array['Siempre mejoran el rendimiento', 'Eliminan la necesidad de un design system', 'Solo sirven para apps pequeñas']::text[], 'Tienen sentido con varios equipos autónomos. Para un solo equipo suelen ser sobreingeniería.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-01-S3', 'ANG-01', 'Senior', 'mc', 'Vas a migrar una app grande de NgModules a standalone. ¿Cómo lo harías?', null, 'De forma incremental, empezando por las hojas, con el schematic oficial de migración y tests en cada paso', array['De golpe en una rama larga', 'Reescribiendo la app desde cero', 'No se puede convivir con ambos sistemas']::text[], 'Standalone y NgModules conviven, así que se puede migrar poco a poco sin parar el desarrollo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-01-S4', 'ANG-01', 'Senior', 'open', 'Cuéntame cómo decidirías la arquitectura frontend de un proyecto nuevo.', 'Tell me how you would decide the frontend architecture for a new project.', null, '{}'::text[], null, null, null, 'start from requirements and team size; folder/feature structure; state management choice; design system; routing and lazy loading; API layer; testing strategy; CI and linting; document decisions (ADRs); keep it simple and evolve', 'I''d start from the requirements and the team: how big the app will get and how many people will work on it. Then I''d define a feature-based structure with lazy-loaded routes, a shared UI library or design system, and a clear API layer. For state I''d begin with signals and services, and only add something like NgRx if the complexity justifies it. I''d set up linting, a testing strategy and CI from day one, and write down the key decisions so the team understands why.', 'Empezaría por los requisitos y el equipo: cuánto va a crecer la aplicación y cuántas personas van a trabajar en ella. Después definiría una estructura por funcionalidades con rutas de carga diferida, una librería de UI o design system compartido y una capa clara de acceso a la API. Para el estado empezaría con signals y servicios, y solo añadiría algo como NgRx si la complejidad lo justifica. Montaría linting, una estrategia de testing y CI desde el primer día, y dejaría por escrito las decisiones clave para que el equipo entienda el porqué.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-J1', 'ANG-02', 'Junior', 'mc', '¿Qué hace Zone.js en una app Angular clásica?', null, 'Avisa a Angular cuando termina un evento asíncrono para que revise la vista', array['Gestiona las rutas', 'Compila las plantillas', 'Guarda el estado global']::text[], 'Parchea clics, timers y peticiones HTTP. Las apps nuevas pueden funcionar sin él (zoneless).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-J2', 'ANG-02', 'Junior', 'mc', '¿Para qué sirve el pipe `async`?', null, 'Se suscribe a un observable en la plantilla y se desuscribe solo al destruirse el componente', array['Hace la petición HTTP más rápida', 'Convierte valores a mayúsculas', 'Ejecuta código en segundo plano']::text[], 'Evita fugas de memoria por suscripciones olvidadas y funciona bien con OnPush.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-J3', 'ANG-02', 'Junior', 'fill', 'En @for, la expresión ___ permite a Angular reutilizar los elementos del DOM en vez de recrearlos.', null, 'track', array['key', 'index', 'trackBy()']::text[], 'Con un identificador estable, Angular solo toca los elementos que cambian.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-J4', 'ANG-02', 'Junior', 'open', '¿Qué es la detección de cambios en Angular, explicado de forma sencilla?', 'What is change detection in Angular, in simple terms?', null, '{}'::text[], null, null, null, 'process that keeps the view in sync with component data; triggered after events/async tasks; checks bindings top-down; Default vs OnPush; signals', 'Change detection is how Angular keeps the screen in sync with the data. When something happens, like a click or an HTTP response, Angular goes through the components and checks if any value used in the template has changed, and if so it updates the DOM. You can make it more efficient with the OnPush strategy or with signals.', 'La detección de cambios es cómo Angular mantiene la pantalla sincronizada con los datos. Cuando pasa algo, como un clic o la respuesta de una petición HTTP, Angular recorre los componentes, comprueba si ha cambiado algún valor usado en la plantilla y, si es así, actualiza el DOM. Se puede hacer más eficiente con la estrategia OnPush o con signals.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-M1', 'ANG-02', 'Mid', 'mc', 'Con OnPush, ¿qué NO provoca que se revise el componente?', null, 'Mutar una propiedad de un objeto @Input sin cambiar la referencia', array['Un nuevo objeto en un @Input', 'Un evento de la propia plantilla', 'Un signal leído en la plantilla que cambia']::text[], 'OnPush compara referencias. Mutar no cambia la referencia, así que hay que trabajar con datos inmutables o signals.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-M2', 'ANG-02', 'Mid', 'mc', '¿Diferencia entre `markForCheck()` y `detectChanges()`?', null, 'markForCheck marca el componente y sus ancestros para el próximo ciclo; detectChanges lo revisa al momento', array['Son idénticos', 'detectChanges solo funciona con Default', 'markForCheck destruye la vista']::text[], 'markForCheck es lo habitual con OnPush; detectChanges se usa en casos puntuales o en tests.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-M3', 'ANG-02', 'Mid', 'mc', 'Una lista de 10.000 filas va lenta. ¿Qué es lo más efectivo?', null, 'Virtual scrolling (CDK) más track y OnPush', array['Aumentar la memoria del navegador', 'Pasar todo a setTimeout', 'Usar más pipes impuros']::text[], 'El virtual scroll solo pinta las filas visibles, así el DOM sigue pequeño.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-M4', 'ANG-02', 'Mid', 'open', 'La aplicación va lenta. ¿Cómo investigarías el problema de rendimiento?', 'The application is slow. How would you investigate the performance problem?', null, '{}'::text[], null, null, null, 'measure first: Angular DevTools profiler, Chrome Performance tab, Lighthouse; identify cause: too many change detection cycles, heavy templates/functions in templates, large bundles, big lists; fixes: OnPush/signals, track, virtual scroll, lazy loading, defer blocks; measure again', 'First I''d measure instead of guessing. I''d use the Angular DevTools profiler to see which components are checked too often, and the Chrome Performance tab and Lighthouse for loading issues. Typical causes are function calls in templates, Default change detection everywhere, big lists, or large bundles. Depending on the cause, I''d apply OnPush or signals, add track, virtual scrolling, lazy loading or defer blocks, and then measure again to confirm the improvement.', 'Primero mediría en vez de suponer. Usaría el profiler de Angular DevTools para ver qué componentes se revisan demasiado, y la pestaña Performance de Chrome y Lighthouse para los problemas de carga. Las causas típicas son llamadas a funciones en las plantillas, detección Default en todas partes, listas muy grandes o bundles pesados. Según la causa, aplicaría OnPush o signals, track, virtual scroll, lazy loading o bloques defer, y volvería a medir para confirmar la mejora.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-S1', 'ANG-02', 'Senior', 'mc', '¿Qué implica pasar una app a zoneless?', null, 'La detección de cambios la disparan signals, eventos de plantilla y markForCheck; el código que dependía de Zone.js para refrescar la vista hay que adaptarlo', array['No cambia nada', 'Desaparece la necesidad de OnPush y de signals', 'Solo afecta a los tests']::text[], 'Sin Zone.js se gana en rendimiento y en tamaño, pero los setTimeout o librerías externas ya no refrescan la vista solos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-S2', 'ANG-02', 'Senior', 'mc', '¿Para qué sirven los bloques `@defer`?', null, 'Cargar de forma diferida partes de la plantilla y su código según un disparador (viewport, interacción, idle…)', array['Retrasar la detección de cambios', 'Diferir peticiones HTTP', 'Ejecutar código en un Web Worker']::text[], 'Reducen el bundle inicial sin crear rutas nuevas, por ejemplo para un gráfico pesado bajo el pliegue.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-S3', 'ANG-02', 'Senior', 'mc', '¿Qué aporta el SSR con hidratación en Angular?', null, 'Primer pintado más rápido y mejor SEO; la hidratación reutiliza el DOM del servidor en vez de recrearlo', array['Elimina el JavaScript del cliente', 'Solo sirve para apps sin datos', 'Sustituye al lazy loading']::text[], 'Hay que cuidar el código que usa APIs del navegador (window, localStorage) porque en el servidor no existen.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-02-S4', 'ANG-02', 'Senior', 'open', '¿Cómo establecerías y vigilarías un presupuesto de rendimiento en un equipo?', 'How would you set and monitor a performance budget in a team?', null, '{}'::text[], null, null, null, 'define metrics (Core Web Vitals, bundle size); budgets in angular.json; Lighthouse CI in the pipeline; real user monitoring; dashboards; review in PRs; fail the build when exceeded; culture', 'I''d agree on a few metrics with the team, like bundle size and Core Web Vitals such as LCP and INP. Then I''d make them automatic: size budgets in angular.json that fail the build, and Lighthouse CI in the pipeline. For real users I''d add monitoring to see the field data. And I''d make performance part of code reviews, so regressions are caught early instead of fixed later.', 'Acordaría con el equipo unas pocas métricas, como el tamaño del bundle y las Core Web Vitals, por ejemplo LCP e INP. Después las automatizaría: presupuestos de tamaño en angular.json que rompan el build y Lighthouse CI en el pipeline. Para los usuarios reales añadiría monitorización y vería los datos de campo. Y haría del rendimiento parte de las code reviews, para detectar empeoramientos pronto en lugar de arreglarlos después.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-J1', 'ANG-03', 'Junior', 'mc', '¿Qué es un Observable?', null, 'Un flujo de valores que llegan a lo largo del tiempo y al que te suscribes', array['Una promesa que siempre devuelve un valor', 'Una variable global', 'Un tipo de componente']::text[], 'A diferencia de una Promise, puede emitir muchos valores y es perezoso: no hace nada hasta que alguien se suscribe.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-J2', 'ANG-03', 'Junior', 'mc', '¿Qué operador transforma cada valor emitido?', null, 'map', array['filter', 'take', 'tap']::text[], 'map transforma, filter descarta, take limita y tap sirve para efectos secundarios como logs.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-J3', 'ANG-03', 'Junior', 'fill', 'Para no tener fugas de memoria hay que ___ de los observables que no se completan solos.', null, 'desuscribirse', array['suscribirse dos veces', 'reiniciar', 'compilar']::text[], 'Formas habituales: pipe async, takeUntilDestroyed() o toSignal().', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-J4', 'ANG-03', 'Junior', 'open', '¿Diferencia entre una Promise y un Observable?', 'What''s the difference between a Promise and an Observable?', null, '{}'::text[], null, null, null, 'promise: single value, eager, not cancellable; observable: multiple values over time, lazy, cancellable via unsubscribe, operators', 'A Promise gives you one value and starts running as soon as you create it, and you can''t cancel it. An Observable can emit many values over time, it''s lazy so nothing happens until you subscribe, and you can cancel it by unsubscribing. Observables also come with operators like map, filter or switchMap to transform the stream.', 'Una Promise devuelve un único valor, empieza a ejecutarse en cuanto la creas y no se puede cancelar. Un Observable puede emitir muchos valores a lo largo del tiempo, es perezoso, así que no hace nada hasta que te suscribes, y se cancela desuscribiéndote. Además, los Observables tienen operadores como map, filter o switchMap para transformar el flujo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-M1', 'ANG-03', 'Mid', 'mc', 'Buscador: solo importa la última petición. ¿Qué operador?', null, 'switchMap', array['mergeMap', 'concatMap', 'exhaustMap']::text[], 'switchMap cancela la petición anterior al llegar un valor nuevo. Se combina con debounceTime y distinctUntilChanged.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-M2', 'ANG-03', 'Mid', 'mc', 'Botón de pagar: ignorar clics mientras la primera petición está en curso.', null, 'exhaustMap', array['switchMap', 'mergeMap', 'concatMap']::text[], 'exhaustMap ignora lo que llega mientras hay algo en marcha.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-M3', 'ANG-03', 'Mid', 'mc', '¿Qué hace `combineLatest`?', null, 'Emite cada vez que cualquiera emite, con el último valor de cada uno (cuando todos han emitido al menos una vez)', array['Espera a que todos se completen y emite una vez', 'Emite los valores en orden de suscripción', 'Cancela los demás observables']::text[], 'forkJoin es el que espera a que todos terminen; combineLatest va combinando en vivo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-M4', 'ANG-03', 'Mid', 'open', '¿Cómo implementarías un buscador con autocompletado usando RxJS?', 'How would you implement a search box with autocomplete using RxJS?', null, '{}'::text[], null, null, null, 'valueChanges or input events; debounceTime; distinctUntilChanged; filter min length; switchMap to HTTP; catchError so the stream doesn''t die; loading state; async pipe or toSignal', 'I''d take the valueChanges of the input, then use debounceTime to wait a few hundred milliseconds, distinctUntilChanged to skip repeated terms, and filter out very short queries. Then switchMap to the HTTP call, so older requests are cancelled. Inside the switchMap I''d add catchError, so one failed request doesn''t kill the whole stream. Finally I''d expose the results with the async pipe or toSignal.', 'Tomaría los valueChanges del input y aplicaría debounceTime para esperar unos cientos de milisegundos, distinctUntilChanged para no repetir términos y un filtro para descartar búsquedas muy cortas. Después, switchMap hacia la llamada HTTP, para cancelar las peticiones anteriores. Dentro del switchMap pondría catchError, para que un error no rompa todo el flujo. Por último, mostraría los resultados con el pipe async o con toSignal.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-S1', 'ANG-03', 'Senior', 'mc', '¿Qué es cierto sobre los observables hot y cold?', null, 'Un cold crea su productor por cada suscriptor (p. ej. HTTP); un hot comparte un productor ya existente (p. ej. eventos del DOM, Subjects)', array['Hot significa que da error', 'Cold significa que ya está completado', 'No hay diferencia práctica']::text[], 'Por eso cada suscripción a un http.get repite la petición, salvo que la compartas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-S2', 'ANG-03', 'Senior', 'mc', '¿Qué hace `shareReplay({ bufferSize: 1, refCount: true })`?', null, 'Comparte una única ejecución entre suscriptores, repite el último valor y se desuscribe del origen cuando no queda nadie', array['Repite la petición en cada suscripción', 'Guarda todos los valores para siempre', 'Convierte el observable en una promesa']::text[], 'Con refCount: false la suscripción al origen se mantiene viva aunque no haya suscriptores, lo que puede dejar fugas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-S3', 'ANG-03', 'Senior', 'mc', '¿Cuál es un problema típico de anidar `subscribe` dentro de otro `subscribe`?', null, 'Pierdes la cancelación y el control de errores, y aparecen condiciones de carrera y fugas', array['Es más rápido', 'Angular lo prohíbe en compilación', 'No hay ningún problema']::text[], 'La solución es aplanar con operadores como switchMap, concatMap o mergeMap.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-03-S4', 'ANG-03', 'Senior', 'open', '¿Cómo gestionarías los errores y los reintentos en flujos RxJS de una app grande?', 'How would you handle errors and retries in RxJS streams in a large app?', null, '{}'::text[], null, null, null, 'catchError at the right level so the outer stream survives; retry with delay/backoff only for idempotent requests; global HTTP interceptor for common errors; user feedback; logging/monitoring; finalize for cleanup; don''t swallow errors silently', 'I''d handle errors at the right level: inside the inner observable with catchError, so the main stream keeps working. For network errors I''d use retry with a delay and a limit, but only for idempotent requests. Common cases like 401 or 500 go into an HTTP interceptor, with a consistent message for the user. And I''d always log errors to a monitoring tool instead of swallowing them silently.', 'Gestionaría los errores en el nivel adecuado: dentro del observable interno con catchError, para que el flujo principal siga funcionando. Para errores de red usaría retry con espera y límite, pero solo en peticiones idempotentes. Los casos comunes, como un 401 o un 500, irían a un interceptor HTTP con un mensaje coherente para el usuario. Y siempre registraría los errores en una herramienta de monitorización en lugar de ocultarlos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-J1', 'ANG-04', 'Junior', 'mc', '¿Cómo lees el valor de un signal `count`?', null, 'count()', array['count.value', 'count.get', 'await count']::text[], 'Un signal es una función: se lee llamándola. Para escribir: set() o update().', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-J2', 'ANG-04', 'Junior', 'fill', 'Para cambiar un signal a partir de su valor anterior se usa ___.', null, 'update()', array['set()', 'next()', 'patch()']::text[], 'set() pone un valor nuevo; update() recibe el valor actual y devuelve el nuevo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-J3', 'ANG-04', 'Junior', 'mc', '¿Qué es `computed()`?', null, 'Un signal de solo lectura derivado de otros, que se recalcula cuando cambian', array['Un signal que hace peticiones HTTP', 'Un efecto secundario', 'Un observable']::text[], 'Por ejemplo: total = computed(() => items().length).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-J4', 'ANG-04', 'Junior', 'open', '¿Qué son los signals y por qué los ha añadido Angular?', 'What are signals and why did Angular add them?', null, '{}'::text[], null, null, null, 'reactive values that notify consumers when they change; set/update, computed, effect; fine-grained change detection; simpler than RxJS for state; path to zoneless', 'Signals are reactive values: when a signal changes, everything that reads it, like a template or a computed value, is notified. You write them with set or update and derive values with computed. Angular added them because they give fine-grained change detection, they''re simpler than RxJS for local state, and they make apps without Zone.js possible.', 'Los signals son valores reactivos: cuando un signal cambia, todo lo que lo lee, como una plantilla o un valor computed, se entera. Se escriben con set o update y se derivan valores con computed. Angular los añadió porque permiten una detección de cambios mucho más precisa, son más sencillos que RxJS para el estado local y hacen posibles las aplicaciones sin Zone.js.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-M1', 'ANG-04', 'Mid', 'mc', '¿Para qué se usa `effect()`?', null, 'Para efectos secundarios cuando cambian signals (logs, guardar en localStorage, sincronizar con una API externa)', array['Para derivar valores', 'Para sustituir a computed', 'Para hacer el binding de la plantilla']::text[], 'No se debe usar para copiar un signal en otro: para eso está computed (o linkedSignal).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-M2', 'ANG-04', 'Mid', 'mc', '¿Qué hacen `input()` y `model()` frente a @Input?', null, 'input() expone el input como signal de solo lectura; model() crea un input con two-way binding escribible', array['Son alias de @Output', 'Solo funcionan en NgModules', 'Sustituyen a los servicios']::text[], 'Al ser signals, puedes usarlos directamente en computed sin ngOnChanges.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-M3', 'ANG-04', 'Mid', 'mc', '¿Dónde guardarías un estado compartido sencillo entre varios componentes?', null, 'En un servicio inyectable con signals privados y métodos para modificarlos', array['En variables globales de window', 'En el localStorage leído en cada render', 'En un @Input que pase por toda la jerarquía']::text[], 'Exponer signals de solo lectura (asReadonly) evita que cualquiera modifique el estado sin pasar por el servicio.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-M4', 'ANG-04', 'Mid', 'open', '¿Cuándo usarías signals y cuándo observables?', 'When would you use signals and when would you use observables?', null, '{}'::text[], null, null, null, 'signals: synchronous state, derived values, templates; observables: async streams over time, HTTP, websockets, complex operators; interop with toSignal/toObservable', 'I use signals for state: the selected item, a filter, a loading flag, and derived values with computed. I use observables for things that happen over time and need coordination, like HTTP, websockets, or a search with debounceTime and switchMap. They work well together: I build the async flow with RxJS and expose the result to the template with toSignal.', 'Uso signals para el estado: el elemento seleccionado, un filtro, un indicador de carga, y valores derivados con computed. Uso observables para lo que ocurre a lo largo del tiempo y necesita coordinación, como HTTP, websockets o un buscador con debounceTime y switchMap. Se combinan bien: construyo el flujo asíncrono con RxJS y expongo el resultado en la plantilla con toSignal.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-S1', 'ANG-04', 'Senior', 'mc', '¿Cuándo tendría sentido NgRx (o una store similar)?', null, 'Cuando muchas partes de la app comparten estado complejo y conviene un flujo predecible, trazable y con herramientas de depuración', array['Siempre, en cualquier app', 'Nunca, los signals lo sustituyen del todo', 'Solo para formularios']::text[], 'Para estado sencillo, un servicio con signals basta. NgRx Signal Store es una opción intermedia.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-S2', 'ANG-04', 'Senior', 'mc', '¿Qué ventaja tiene que el estado se modifique solo desde un servicio con métodos claros?', null, 'Un único punto de cambio: más fácil de depurar, testear y razonar', array['Es más rápido de escribir', 'Evita usar TypeScript', 'Permite mutar desde cualquier componente']::text[], 'Es el principio de la mayoría de librerías de estado: lectura libre, escritura controlada.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-S3', 'ANG-04', 'Senior', 'fill', 'Para crear un signal que depende de otro pero que también puede editarse a mano se usa ___.', null, 'linkedSignal()', array['computed()', 'effect()', 'toSignal()']::text[], 'Útil, por ejemplo, para una opción seleccionada que se reinicia cuando cambia la lista.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-04-S4', 'ANG-04', 'Senior', 'open', '¿Cómo diseñarías la gestión del estado de una app mediana-grande?', 'How would you design state management for a medium-to-large app?', null, '{}'::text[], null, null, null, 'classify state: local UI, shared feature, server/cache, URL; keep state close to where it''s used; services with signals; server state with caching; store (NgRx) only if needed; immutability; single source of truth; testing', 'First I''d separate the types of state: local UI state stays in the component, shared feature state goes into services with signals, server data needs caching and loading/error handling, and some state belongs in the URL. I''d keep each piece as close as possible to where it''s used. Only if many features share complex state would I add a store like NgRx. In all cases: one source of truth, immutable updates and good tests.', 'Primero separaría los tipos de estado: el de UI local se queda en el componente, el compartido de una funcionalidad va en servicios con signals, los datos del servidor necesitan caché y gestión de carga y errores, y parte del estado pertenece a la URL. Mantendría cada pieza lo más cerca posible de donde se usa. Solo si muchas funcionalidades comparten un estado complejo añadiría una store como NgRx. En todos los casos: una única fuente de verdad, actualizaciones inmutables y buenos tests.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('ANG-05-J1', 'ANG-05', 'Junior', 'fill', 'En la plantilla, las rutas se pintan dentro de ___.', null, '<router-outlet>', array['<ng-content>', '<router-view>', '<app-root>']::text[], 'routerLink navega y router-outlet es el hueco donde se pinta la ruta activa.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;

-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-M4', 'REA-03', 'Mid', 'open', '¿Qué tipos de estado hay en una app React y dónde guardarías cada uno?', 'What kinds of state are there in a React app and where would you keep each one?', null, '{}'::text[], null, null, null, 'local UI state (useState); shared client state (Context, Zustand, Redux); server state (TanStack Query); URL state (router params/search); form state (form library)', 'I separate it into four kinds. Local UI state, like whether a modal is open, stays in useState. Shared client state, like the logged-in user, goes in Context or a small store like Zustand. Server data goes in TanStack Query, which handles caching and refetching. And things like filters or the current page belong in the URL, so they survive a refresh and can be shared.', 'Lo separo en cuatro tipos. El estado local de interfaz, como si un modal está abierto, se queda en useState. El estado compartido del cliente, como el usuario que ha iniciado sesión, va en Context o en una store pequeña como Zustand. Los datos del servidor van en TanStack Query, que gestiona la caché y la recarga. Y cosas como los filtros o la página actual pertenecen a la URL, para que sobrevivan a una recarga y se puedan compartir.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-S1', 'REA-03', 'Senior', 'mc', '¿Qué es una actualización optimista?', null, 'Actualizar la UI antes de que responda el servidor y revertir si la petición falla', array['Esperar siempre al servidor', 'Cachear para siempre', 'Hacer dos peticiones']::text[], 'Mejora la sensación de velocidad; TanStack Query y useOptimistic lo facilitan.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-S2', 'REA-03', 'Senior', 'mc', '¿Cuándo elegirías Redux Toolkit frente a Zustand?', null, 'Redux si necesitas convenciones estrictas, middleware y devtools en un equipo grande; Zustand si buscas algo mínimo y sencillo', array['Zustand siempre es mejor', 'Redux siempre es mejor', 'Son incompatibles con TypeScript']::text[], 'No hay una respuesta única: depende del tamaño del equipo y la complejidad.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-S3', 'REA-03', 'Senior', 'mc', '¿Cómo evitas mostrar datos antiguos tras una mutación?', null, 'Invalidando las queries afectadas o actualizando la caché con la respuesta', array['Recargando la página', 'Desactivando la caché', 'Usando setTimeout']::text[], 'queryClient.invalidateQueries o setQueryData.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-S4', 'REA-03', 'Senior', 'open', '¿Cómo diseñarías la capa de datos de una app con muchas pantallas que comparten información?', 'How would you design the data layer of an app with many screens sharing data?', null, '{}'::text[], null, null, null, 'server state library with caching and query keys; typed API client (OpenAPI); normalized or keyed cache; invalidation strategy; optimistic updates; error/loading conventions; avoid duplicating server data in global store', 'I''d use a server state library like TanStack Query as the single source for API data, with consistent query keys, so screens share the cache instead of refetching. A typed API client, ideally generated from OpenAPI. Clear rules for invalidation after mutations, optimistic updates where it helps, and shared components for loading and error states. And I''d avoid copying server data into a global store, because that creates two sources of truth.', 'Usaría una librería de estado del servidor como TanStack Query como única fuente de los datos de la API, con claves de consulta coherentes para que las pantallas compartan la caché en lugar de volver a pedir los datos. Un cliente de API tipado, idealmente generado desde OpenAPI. Reglas claras de invalidación tras cada mutación, actualizaciones optimistas donde aporten y componentes comunes para los estados de carga y error. Y evitaría copiar datos del servidor en una store global, porque crea dos fuentes de verdad.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-J1', 'REA-04', 'Junior', 'mc', '¿Qué hace `React.memo`?', null, 'Evita volver a renderizar un componente si sus props no han cambiado', array['Guarda datos en localStorage', 'Memoriza peticiones HTTP', 'Hace el componente asíncrono']::text[], 'Compara las props de forma superficial.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-J2', 'REA-04', 'Junior', 'mc', '¿Qué herramienta usarías para ver qué componentes se renderizan y cuánto tardan?', null, 'El Profiler de React DevTools', array['La consola de Node', 'npm audit', 'Git']::text[], 'Permite ver cada commit de render y su coste.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-J3', 'REA-04', 'Junior', 'fill', 'Cargar un componente solo cuando se necesita se hace con React.___ y Suspense.', null, 'lazy', array['memo', 'use', 'defer']::text[], 'const Admin = React.lazy(() => import(''./Admin'')).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-J4', 'REA-04', 'Junior', 'open', '¿Qué harías si una página de React va lenta?', 'What would you do if a React page is slow?', null, '{}'::text[], null, null, null, 'measure with React DevTools Profiler and browser tools; find unnecessary re-renders or heavy computations; memo/useMemo; virtualize long lists; code splitting; measure again', 'First I''d measure with the React Profiler and the browser''s performance tools, to find out if the problem is unnecessary re-renders, a heavy calculation or a big bundle. Then I''d apply the right fix: memo for components that re-render for no reason, useMemo for expensive calculations, virtualization for long lists, or lazy loading for big pages. And I''d measure again to confirm it helped.', 'Primero mediría con el Profiler de React y las herramientas de rendimiento del navegador, para saber si el problema son renderizados innecesarios, un cálculo pesado o un bundle grande. Después aplicaría la solución adecuada: memo para componentes que se renderizan sin motivo, useMemo para cálculos costosos, virtualización para listas largas o carga diferida para páginas grandes. Y volvería a medir para confirmar la mejora.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-M1', 'REA-04', 'Mid', 'mc', 'Pasas una función nueva como prop a un hijo con React.memo en cada render. ¿Qué ocurre?', null, 'El hijo se vuelve a renderizar igualmente, porque la referencia de la función cambia', array['No pasa nada', 'React lanza un error', 'El hijo deja de renderizar']::text[], 'useCallback mantiene la misma referencia entre renders.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-M2', 'REA-04', 'Mid', 'mc', 'Para listas de miles de elementos, lo más efectivo es…', null, 'Virtualizar (react-window, TanStack Virtual)', array['Usar más keys', 'Añadir más useEffect', 'Pasar a clases']::text[], 'Solo se pinta lo visible.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-M3', 'REA-04', 'Mid', 'mc', '¿Qué mide el INP (Interaction to Next Paint)?', null, 'Cuánto tarda la página en responder visualmente a las interacciones del usuario', array['El tiempo de descarga del HTML', 'El tamaño del bundle', 'La memoria usada']::text[], 'Es una de las Core Web Vitals, junto a LCP y CLS.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-M4', 'REA-04', 'Mid', 'open', '¿Qué es el code splitting y cómo lo aplicarías?', 'What is code splitting and how would you apply it?', null, '{}'::text[], null, null, null, 'split bundle into chunks loaded on demand; route-based splitting with lazy + Suspense; heavy components/libraries loaded lazily; dynamic import; analyze bundle', 'Code splitting means breaking the JavaScript bundle into smaller chunks that are loaded only when needed. The easiest win is splitting by route, using lazy and Suspense, so each page loads its own code. I''d also lazy load heavy components like charts or editors. And I''d use a bundle analyzer to find the biggest dependencies.', 'El code splitting consiste en dividir el bundle de JavaScript en trozos más pequeños que se cargan solo cuando hacen falta. Lo más fácil es dividir por rutas, con lazy y Suspense, para que cada página cargue su propio código. También cargaría de forma diferida componentes pesados como gráficos o editores. Y usaría un analizador de bundle para encontrar las dependencias más grandes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-S1', 'REA-04', 'Senior', 'mc', '¿Qué hace el React Compiler?', null, 'Añade memorización automáticamente en tiempo de compilación, reduciendo la necesidad de useMemo/useCallback manuales', array['Convierte React a Vue', 'Elimina el virtual DOM', 'Compila a WebAssembly']::text[], 'Exige que el código siga las reglas de React (componentes puros, hooks bien usados).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-S2', 'REA-04', 'Senior', 'mc', '¿Qué aporta el streaming SSR con Suspense?', null, 'El servidor envía el HTML por partes y la página se muestra antes, sin esperar a los datos más lentos', array['Sustituye al CDN', 'Elimina el JavaScript', 'Solo sirve para vídeo']::text[], 'Las partes lentas muestran un fallback hasta que llegan.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-S3', 'REA-04', 'Senior', 'mc', '¿Por qué conviene medir en producción (RUM) además de en local?', null, 'Porque los usuarios reales tienen dispositivos y redes muy distintos a tu máquina', array['Porque en local no funciona el Profiler', 'No conviene', 'Por obligación legal']::text[], 'Los datos de campo (RUM) muestran lo que de verdad sufren los usuarios.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-04-S4', 'REA-04', 'Senior', 'open', '¿Cómo mejorarías el tiempo de carga inicial de una aplicación React grande?', 'How would you improve the initial load time of a large React application?', null, '{}'::text[], null, null, null, 'measure LCP/bundle; route and component code splitting; remove/replace heavy dependencies; tree shaking; SSR/SSG or streaming; image optimization; caching/CDN; preload critical resources; budgets in CI', 'I''d start by measuring LCP and analyzing the bundle. Then: split code by route, replace or lazy load heavy libraries, and make sure tree shaking works. If SEO or first paint matter, I''d consider server rendering or static generation with a framework like Next.js. Images optimized and served from a CDN, critical resources preloaded, and performance budgets in CI to avoid going backwards.', 'Empezaría midiendo el LCP y analizando el bundle. Después: dividir el código por rutas, sustituir o cargar de forma diferida las librerías pesadas y asegurarme de que el tree shaking funciona. Si importan el SEO y el primer pintado, consideraría el renderizado en servidor o la generación estática con un framework como Next.js. Imágenes optimizadas y servidas desde un CDN, recursos críticos precargados y presupuestos de rendimiento en CI para no ir hacia atrás.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-J1', 'REA-05', 'Junior', 'mc', '¿Qué librería se usa habitualmente para la navegación en una SPA de React?', null, 'React Router (o el router de un framework como Next.js)', array['Express', 'Axios', 'Jest']::text[], 'React no trae router propio.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-J2', 'REA-05', 'Junior', 'fill', 'En React Router, para navegar sin recargar la página se usa el componente ___.', null, '<Link>', array['<a>', '<Route>', '<Navigate>']::text[], 'Un <a> normal recargaría la página entera.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-J3', 'REA-05', 'Junior', 'mc', '¿Qué es una SPA?', null, 'Una aplicación de una sola página que cambia el contenido sin recargar el documento', array['Una web con un solo archivo HTML y sin JavaScript', 'Un servidor de APIs', 'Una app nativa']::text[], 'El routing ocurre en el cliente.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-J4', 'REA-05', 'Junior', 'open', '¿Diferencia entre React y Next.js?', 'What''s the difference between React and Next.js?', null, '{}'::text[], null, null, null, 'React is a UI library; Next.js is a framework on top: file-based routing, SSR/SSG, server components, API routes, optimizations', 'React is a library for building user interfaces, so you still need to choose a router, a build setup and so on. Next.js is a framework built on top of React that gives you file-based routing, server-side rendering and static generation, server components, API routes and lots of built-in optimizations. It''s a full solution for production apps.', 'React es una librería para construir interfaces, así que todavía tienes que elegir router, configuración de build, etc. Next.js es un framework construido sobre React que te da rutas basadas en archivos, renderizado en servidor y generación estática, server components, rutas de API y muchas optimizaciones integradas. Es una solución completa para aplicaciones en producción.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-M1', 'REA-05', 'Mid', 'mc', '¿Cómo proteges una ruta privada en React Router?', null, 'Con un componente o loader que comprueba la sesión y redirige con <Navigate> o redirect si no hay usuario', array['Ocultando el enlace en el menú', 'Con CSS', 'No se puede']::text[], 'Ocultar el enlace no basta: el usuario puede escribir la URL. Y la seguridad real está en el backend.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-M2', 'REA-05', 'Mid', 'mc', '¿Qué son los loaders de React Router (data routers)?', null, 'Funciones que cargan datos antes de renderizar la ruta', array['Spinners de carga', 'Componentes de error', 'Hooks de estado']::text[], 'Evitan cascadas de peticiones y simplifican los estados de carga.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-M3', 'REA-05', 'Mid', 'mc', '¿Dónde guardarías los filtros de una tabla para poder compartir el enlace?', null, 'En los query params de la URL', array['En useState', 'En una variable global', 'En sessionStorage']::text[], 'useSearchParams los lee y escribe.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-M4', 'REA-05', 'Mid', 'open', '¿Cómo organizarías las carpetas de un proyecto React mediano?', 'How would you organize the folders of a medium-sized React project?', null, '{}'::text[], null, null, null, 'feature-based folders (components, hooks, api, tests together); shared components/ui; lib/utils; routes/pages; consistent naming; avoid deep nesting; colocation', 'I''d group by feature: each feature folder contains its components, hooks, API calls and tests together, so related code lives side by side. Then a shared folder for the UI kit and common hooks, a lib folder for utilities and the API client, and a routes or pages folder. The key is colocation and consistent naming, without too many nested levels.', 'Agruparía por funcionalidades: cada carpeta contiene sus componentes, hooks, llamadas a la API y tests, de modo que el código relacionado está junto. Después, una carpeta compartida para el kit de UI y los hooks comunes, una carpeta lib para utilidades y el cliente de la API, y una carpeta de rutas o páginas. La clave es tener junto lo que va junto y nombrar de forma coherente, sin demasiados niveles de anidación.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-S1', 'REA-05', 'Senior', 'mc', '¿Qué diferencia hay entre SSR, SSG e ISR?', null, 'SSR genera el HTML en cada petición; SSG en el build; ISR regenera páginas estáticas cada cierto tiempo o bajo demanda', array['Son sinónimos', 'SSG es solo para APIs', 'ISR elimina el servidor']::text[], 'Se elige según lo dinámicos que sean los datos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-S2', 'REA-05', 'Senior', 'mc', '¿Qué ventaja tiene un monorepo (Nx, Turborepo) para varios frontends?', null, 'Compartir código y configuración, cambios atómicos entre paquetes y builds incrementales', array['Despliegues más lentos', 'Elimina la necesidad de tests', 'Obliga a usar un solo framework']::text[], 'A cambio exige buenas herramientas y reglas de dependencias.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-S3', 'REA-05', 'Senior', 'mc', '¿Qué es un design system y por qué ayuda?', null, 'Un conjunto de componentes, tokens y reglas compartidas que hace la UI consistente y acelera el desarrollo', array['Un tipo de base de datos', 'Un framework de testing', 'Una librería de estado']::text[], 'Suele vivir en su propio paquete con Storybook y tests visuales.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-05-S4', 'REA-05', 'Senior', 'open', '¿Cómo elegirías entre una SPA pura y un framework con SSR como Next.js?', 'How would you choose between a pure SPA and an SSR framework like Next.js?', null, '{}'::text[], null, null, null, 'SEO and first load needs; public vs internal app; data freshness; infrastructure and cost; team experience; complexity; hybrid options', 'It depends on the product. For a public site where SEO and the first load matter, like an e-commerce or a blog, I''d go with Next.js and server rendering. For an internal dashboard behind a login, a SPA is simpler and cheaper to host. I''d also consider the team''s experience and the infrastructure. And many frameworks let you mix both approaches page by page.', 'Depende del producto. Para una web pública donde importan el SEO y la primera carga, como un e-commerce o un blog, iría con Next.js y renderizado en servidor. Para un panel interno detrás de un login, una SPA es más sencilla y más barata de alojar. También tendría en cuenta la experiencia del equipo y la infraestructura. Y muchos frameworks permiten combinar los dos enfoques página a página.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-J1', 'REA-06', 'Junior', 'mc', '¿Qué filosofía sigue React Testing Library?', null, 'Testear como lo usaría un usuario: buscar por texto o rol y simular interacciones', array['Testear el estado interno y los métodos privados', 'Hacer snapshots de todo', 'Testear solo el CSS']::text[], 'Cuanto más se parezca el test al uso real, más confianza da.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-J2', 'REA-06', 'Junior', 'fill', 'Para buscar un botón accesible por su rol se usa screen.___(''button'', { name: /guardar/i }).', null, 'getByRole', array['getByClass', 'querySelector', 'findByCss']::text[], 'getByRole es la consulta preferida porque además comprueba accesibilidad.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-J3', 'REA-06', 'Junior', 'mc', '¿Qué herramientas se usan habitualmente para tests unitarios en React?', null, 'Jest o Vitest con React Testing Library', array['Selenium y JUnit', 'Postman', 'Webpack']::text[], 'Para E2E: Playwright o Cypress.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-J4', 'REA-06', 'Junior', 'open', '¿Qué testearías en un componente de formulario de login?', 'What would you test in a login form component?', null, '{}'::text[], null, null, null, 'renders fields; validation messages; submit calls handler/API with values; disabled button while loading; error message on failure; accessible labels', 'I''d check that the email and password fields render with accessible labels, that validation messages appear when the fields are empty or invalid, and that submitting calls the login function with the right values. I''d also test that the button is disabled while loading, and that an error message appears if the login fails.', 'Comprobaría que los campos de email y contraseña se muestran con etiquetas accesibles, que aparecen los mensajes de validación cuando están vacíos o son incorrectos y que al enviar se llama a la función de login con los valores correctos. También probaría que el botón se desactiva mientras carga y que aparece un mensaje de error si el login falla.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-M1', 'REA-06', 'Mid', 'mc', '¿Diferencia entre getBy, queryBy y findBy?', null, 'getBy lanza error si no existe; queryBy devuelve null; findBy espera de forma asíncrona', array['Son iguales', 'findBy es síncrono', 'queryBy lanza error']::text[], 'queryBy sirve para comprobar que algo NO está; findBy para lo que aparece tras una petición.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-M2', 'REA-06', 'Mid', 'mc', '¿Cómo simulas las peticiones HTTP en los tests de forma realista?', null, 'Con MSW (Mock Service Worker), interceptando las peticiones de red', array['Llamando a la API real', 'Borrando fetch', 'Con setTimeout']::text[], 'MSW permite reutilizar los mismos mocks en tests y en desarrollo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-M3', 'REA-06', 'Mid', 'mc', '¿Por qué se prefiere `userEvent` frente a `fireEvent`?', null, 'Simula interacciones completas como un usuario real (foco, teclado, clics) en vez de disparar un único evento', array['Es más rápido', 'fireEvent está prohibido', 'No hay diferencia']::text[], 'Por ejemplo, userEvent.type escribe letra a letra disparando todos los eventos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-M4', 'REA-06', 'Mid', 'open', '¿Cómo testearías un custom hook?', 'How would you test a custom hook?', null, '{}'::text[], null, null, null, 'renderHook from Testing Library; act for updates; mock dependencies/network (MSW); test returned values over time; or test through a component that uses it', 'I''d use renderHook from Testing Library, which renders the hook inside a test component. Then I check the returned values, and wrap updates in act. If the hook fetches data, I mock the network with MSW and wait for the result with waitFor. Sometimes it''s even more meaningful to test it through a real component that uses it.', 'Usaría renderHook de Testing Library, que renderiza el hook dentro de un componente de prueba. Después compruebo los valores que devuelve y envuelvo las actualizaciones en act. Si el hook pide datos, simulo la red con MSW y espero el resultado con waitFor. A veces tiene más sentido probarlo a través de un componente real que lo use.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-S1', 'REA-06', 'Senior', 'mc', '¿Qué problema tienen los tests de snapshot grandes?', null, 'Se actualizan sin revisarlos y acaban sin detectar nada útil', array['Son demasiado lentos siempre', 'No funcionan con TypeScript', 'Ninguno']::text[], 'Mejor snapshots pequeños y concretos, o aserciones explícitas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-S2', 'REA-06', 'Senior', 'mc', '¿Qué son los tests de regresión visual?', null, 'Comparar capturas de pantalla de componentes entre versiones para detectar cambios visuales no deseados', array['Tests de rendimiento', 'Tests de accesibilidad', 'Tests de carga']::text[], 'Herramientas como Chromatic o Playwright lo automatizan.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-S3', 'REA-06', 'Senior', 'mc', '¿Qué es el ''testing trophy'' de Kent C. Dodds?', null, 'Una propuesta que da más peso a los tests de integración, con análisis estático en la base', array['Un premio de testing', 'Una herramienta de cobertura', 'Un tipo de E2E']::text[], 'Es una alternativa a la pirámide clásica pensada para frontend.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-06-S4', 'REA-06', 'Senior', 'open', '¿Cómo asegurarías la calidad de un frontend React en un equipo de 10 personas?', 'How would you ensure the quality of a React frontend in a team of 10 people?', null, '{}'::text[], null, null, null, 'TypeScript strict and ESLint; automated tests at several levels; CI gates; code review guidelines; design system and Storybook; visual and accessibility tests; monitoring errors in production; shared conventions', 'I''d combine automation and team practices. Strict TypeScript and ESLint catch a lot of problems early. Tests at several levels, mainly integration tests with Testing Library and a few E2E for critical flows, all running in CI and blocking merges. A design system with Storybook, plus visual and accessibility checks. Clear code review guidelines. And error monitoring in production, so we learn from real issues.', 'Combinaría automatización y prácticas de equipo. TypeScript estricto y ESLint detectan muchos problemas pronto. Tests en varios niveles, sobre todo de integración con Testing Library y unos pocos E2E para los flujos críticos, todos en CI y bloqueando el merge. Un design system con Storybook, más pruebas visuales y de accesibilidad. Pautas claras de code review. Y monitorización de errores en producción, para aprender de los problemas reales.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-J1', 'CLD-01', 'Junior', 'mc', '¿Qué es una Availability Zone?', null, 'Uno o varios centros de datos aislados dentro de una región', array['Un país donde AWS tiene clientes', 'Un tipo de instancia EC2', 'Una cuenta de AWS']::text[], 'Una región tiene varias AZ. Repartir recursos entre AZ da alta disponibilidad.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-J2', 'CLD-01', 'Junior', 'mc', '¿Qué servicio usarías para guardar archivos como imágenes o backups?', null, 'Amazon S3', array['Amazon EC2', 'Amazon RDS', 'AWS Lambda']::text[], 'S3 es almacenamiento de objetos, muy duradero y barato.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-J3', 'CLD-01', 'Junior', 'fill', 'En IAM, el principio de mínimo ___ dice que cada identidad debe tener solo los permisos que necesita.', null, 'privilegio', array['coste', 'acceso root', 'riesgo']::text[], 'Nunca uses la cuenta root para el día a día.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-J4', 'CLD-01', 'Junior', 'open', '¿Qué es el cloud computing y qué ventajas tiene frente a servidores propios?', 'What is cloud computing and what are its advantages over your own servers?', null, '{}'::text[], null, null, null, 'on-demand resources over the internet; pay as you go; scalability/elasticity; no upfront hardware; global reach; managed services; shared responsibility', 'Cloud computing means using computing resources, like servers, storage or databases, on demand over the internet and paying only for what you use. Compared to your own servers, you don''t buy hardware upfront, you can scale up or down in minutes, you can deploy close to users anywhere in the world, and you can use managed services so you spend less time on maintenance.', 'El cloud computing es usar recursos informáticos, como servidores, almacenamiento o bases de datos, bajo demanda a través de internet y pagando solo por lo que usas. Frente a tener tus propios servidores, no compras hardware por adelantado, puedes escalar en minutos, puedes desplegar cerca de los usuarios en cualquier parte del mundo y puedes usar servicios gestionados para dedicar menos tiempo al mantenimiento.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-M1', 'CLD-01', 'Mid', 'mc', '¿Diferencia entre un rol de IAM y un usuario de IAM?', null, 'El rol se asume temporalmente y da credenciales temporales; el usuario tiene credenciales permanentes', array['Son lo mismo', 'Los roles solo son para personas', 'Los usuarios no pueden tener políticas']::text[], 'Para servicios (EC2, Lambda) se usan siempre roles, nunca claves guardadas en el código.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-M2', 'CLD-01', 'Mid', 'mc', '¿Qué clase de S3 elegirías para backups que casi nunca se consultan?', null, 'S3 Glacier (Flexible Retrieval o Deep Archive)', array['S3 Standard', 'S3 Express One Zone', 'EBS']::text[], 'Las clases de archivo son mucho más baratas, a cambio de tiempos de recuperación largos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-M3', 'CLD-01', 'Mid', 'mc', '¿Qué es el modelo de responsabilidad compartida?', null, 'AWS se encarga de la seguridad DE la nube (hardware, infraestructura); el cliente, de la seguridad EN la nube (datos, configuración, accesos)', array['AWS se encarga de todo', 'El cliente se encarga de todo', 'Solo aplica a EC2']::text[], 'Cuanto más gestionado es el servicio, más responsabilidad asume AWS.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-M4', 'CLD-01', 'Mid', 'open', '¿Cuándo usarías EC2, Lambda o un contenedor en ECS/Fargate?', 'When would you use EC2, Lambda or a container on ECS/Fargate?', null, '{}'::text[], null, null, null, 'EC2: full control, long-running, special OS needs; Lambda: event-driven, short tasks, scale to zero, pay per use, limits (15 min); containers: portable apps, microservices, long-running without managing servers with Fargate', 'I''d use Lambda for event-driven, short tasks, like processing a file when it''s uploaded to S3, because it scales automatically and you pay only when it runs, but it has a time limit of fifteen minutes. For long-running services or microservices, I''d use containers on ECS with Fargate, so I don''t manage servers. And EC2 when I need full control of the operating system or special software.', 'Usaría Lambda para tareas cortas y basadas en eventos, como procesar un archivo cuando se sube a S3, porque escala sola y solo pagas cuando se ejecuta, aunque tiene un límite de quince minutos. Para servicios de larga duración o microservicios, usaría contenedores en ECS con Fargate, para no gestionar servidores. Y EC2 cuando necesito control total del sistema operativo o software especial.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-S1', 'CLD-01', 'Senior', 'mc', '¿Para qué sirve AWS Organizations con Service Control Policies?', null, 'Para gestionar muchas cuentas de forma centralizada y limitar lo que se puede hacer en cada una', array['Para facturar a clientes', 'Para crear VPCs', 'Para monitorizar logs']::text[], 'Una estrategia multicuenta (por entorno o equipo) aísla riesgos y costes.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-S2', 'CLD-01', 'Senior', 'mc', '¿Qué estrategia ayuda más a reducir costes en cargas estables y predecibles?', null, 'Savings Plans o instancias reservadas', array['Instancias Spot para todo', 'Subir el tamaño de las instancias', 'Desactivar el autoscaling']::text[], 'Spot es ideal para cargas tolerantes a interrupciones, no para todo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-S3', 'CLD-01', 'Senior', 'mc', '¿Qué son los pilares del Well-Architected Framework?', null, 'Excelencia operativa, seguridad, fiabilidad, eficiencia de rendimiento, optimización de costes y sostenibilidad', array['Velocidad, precio y diseño', 'Solo seguridad y coste', 'EC2, S3, RDS y Lambda']::text[], 'Son la base para revisar cualquier arquitectura en AWS.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-01-S4', 'CLD-01', 'Senior', 'open', '¿Cómo diseñarías una estrategia multicuenta en AWS para una empresa?', 'How would you design a multi-account strategy in AWS for a company?', null, '{}'::text[], null, null, null, 'AWS Organizations; separate accounts per environment/team/workload; OUs; SCP guardrails; centralized logging and security accounts; IAM Identity Center for SSO; Control Tower landing zone; consolidated billing; tagging', 'I''d use AWS Organizations with a landing zone, for example with Control Tower. Separate accounts for production, staging and development, grouped in organizational units, plus dedicated accounts for security and centralized logging. Service Control Policies as guardrails, IAM Identity Center for single sign-on, consolidated billing and a tagging policy, so we can track costs per team.', 'Usaría AWS Organizations con una landing zone, por ejemplo con Control Tower. Cuentas separadas para producción, preproducción y desarrollo, agrupadas en unidades organizativas, y cuentas dedicadas para seguridad y logs centralizados. Service Control Policies como barreras, IAM Identity Center para el inicio de sesión único, facturación consolidada y una política de etiquetado para seguir los costes por equipo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-J1', 'CLD-02', 'Junior', 'mc', '¿Qué es una VPC?', null, 'Una red privada virtual y aislada dentro de AWS donde despliegas tus recursos', array['Un tipo de base de datos', 'Una VPN para empleados', 'Un balanceador']::text[], 'Dentro creas subredes, tablas de rutas y reglas de seguridad.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-J2', 'CLD-02', 'Junior', 'mc', '¿Qué diferencia una subred pública de una privada?', null, 'La pública tiene ruta a un Internet Gateway; la privada no tiene acceso directo desde internet', array['La pública es más barata', 'La privada no puede tener instancias', 'No hay diferencia']::text[], 'Las bases de datos y backends suelen ir en subredes privadas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-J3', 'CLD-02', 'Junior', 'fill', 'Un ___ es un firewall a nivel de instancia que controla el tráfico de entrada y salida.', null, 'Security Group', array['Internet Gateway', 'Route Table', 'Load Balancer']::text[], 'Los Security Groups son stateful: si permites la entrada, la respuesta sale automáticamente.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-J4', 'CLD-02', 'Junior', 'open', 'Explica cómo llega una petición de un usuario a una aplicación web en AWS.', 'Explain how a user''s request reaches a web application on AWS.', null, '{}'::text[], null, null, null, 'DNS (Route 53) resolves domain; optionally CDN (CloudFront); load balancer in public subnet; security groups; app servers/containers in private subnets; database in private subnet; response back', 'The user types the domain, and Route 53 resolves it. The request can go first through CloudFront, a CDN. Then it reaches an Application Load Balancer in a public subnet, which forwards it to the application servers or containers in private subnets, allowed by the security groups. The application queries the database, also in a private subnet, and the response goes back the same way.', 'El usuario escribe el dominio y Route 53 lo resuelve. La petición puede pasar primero por CloudFront, un CDN. Después llega a un Application Load Balancer en una subred pública, que la reenvía a los servidores o contenedores de la aplicación en subredes privadas, permitido por los security groups. La aplicación consulta la base de datos, también en una subred privada, y la respuesta vuelve por el mismo camino.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-M1', 'CLD-02', 'Mid', 'mc', '¿Para qué sirve un NAT Gateway?', null, 'Para que recursos en subredes privadas salgan a internet (p. ej. actualizaciones) sin ser accesibles desde fuera', array['Para recibir tráfico de internet', 'Para conectar dos regiones', 'Para balancear carga']::text[], 'Ojo: tiene coste por hora y por GB procesado.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-M2', 'CLD-02', 'Mid', 'mc', '¿Diferencia entre Security Group y Network ACL?', null, 'El SG actúa a nivel de instancia y es stateful; la NACL actúa a nivel de subred y es stateless', array['Son lo mismo', 'La NACL es a nivel de instancia', 'El SG es stateless']::text[], 'En la NACL hay que permitir explícitamente también el tráfico de vuelta.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-M3', 'CLD-02', 'Mid', 'mc', '¿Qué balanceador elegirías para enrutar por ruta HTTP (/api, /web)?', null, 'Application Load Balancer', array['Network Load Balancer', 'Gateway Load Balancer', 'Classic Load Balancer']::text[], 'El ALB trabaja en capa 7; el NLB en capa 4 con latencia ultrabaja.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-M4', 'CLD-02', 'Mid', 'open', '¿Cómo diseñarías la red de una aplicación de tres capas en AWS?', 'How would you design the network for a three-tier application on AWS?', null, '{}'::text[], null, null, null, 'VPC across at least two AZs; public subnets for ALB and NAT; private subnets for app; isolated/private subnets for DB; security groups chaining (ALB→app→DB); NACLs; VPC endpoints for S3; flow logs', 'I''d create a VPC spread across at least two availability zones. Public subnets hold the load balancer and the NAT gateways. Private subnets hold the application, and separate private subnets hold the database. Security groups are chained: the load balancer can reach the app, and only the app can reach the database. I''d add VPC endpoints for services like S3 and enable flow logs for troubleshooting.', 'Crearía una VPC repartida en al menos dos zonas de disponibilidad. Las subredes públicas tendrían el balanceador y los NAT gateways. Las subredes privadas, la aplicación, y otras subredes privadas separadas, la base de datos. Los security groups irían encadenados: el balanceador llega a la aplicación y solo la aplicación llega a la base de datos. Añadiría VPC endpoints para servicios como S3 y activaría los flow logs para diagnosticar problemas.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-S1', 'CLD-02', 'Senior', 'mc', '¿Qué solución conecta muchas VPCs y redes on-premise de forma centralizada?', null, 'AWS Transit Gateway', array['VPC Peering entre todas', 'Un NAT Gateway', 'CloudFront']::text[], 'El peering no es transitivo: con muchas VPCs se vuelve inmanejable.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-S2', 'CLD-02', 'Senior', 'mc', '¿Qué ventaja tienen los VPC endpoints?', null, 'Acceder a servicios de AWS desde subredes privadas sin salir a internet ni pasar por NAT', array['Aumentan el ancho de banda de internet', 'Sustituyen a los Security Groups', 'Son obligatorios']::text[], 'Mejoran la seguridad y pueden ahorrar coste de NAT.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-S3', 'CLD-02', 'Senior', 'mc', '¿Cuándo usarías Direct Connect en lugar de una VPN Site-to-Site?', null, 'Cuando necesitas una conexión dedicada con ancho de banda y latencia más estables', array['Siempre, es más barato', 'Para conectar dos VPCs', 'Para usuarios remotos']::text[], 'La VPN es rápida de montar; Direct Connect tarda semanas pero es más estable.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-02-S4', 'CLD-02', 'Senior', 'open', '¿Cómo plantearías una arquitectura de red híbrida entre un CPD y AWS?', 'How would you approach a hybrid network architecture between an on-premise data center and AWS?', null, '{}'::text[], null, null, null, 'connectivity: Site-to-Site VPN and/or Direct Connect with VPN backup; Transit Gateway hub; non-overlapping CIDR planning; Route 53 Resolver for hybrid DNS; security and segmentation; monitoring', 'First I''d plan the IP ranges so they don''t overlap. For connectivity, Direct Connect for stable bandwidth, with a Site-to-Site VPN as backup. A Transit Gateway as the central hub connecting the VPCs and the data center. Route 53 Resolver endpoints for DNS in both directions. And clear segmentation with route tables and security groups, plus monitoring of the links.', 'Primero planificaría los rangos de IP para que no se solapen. Para la conectividad, Direct Connect para un ancho de banda estable, con una VPN Site-to-Site de respaldo. Un Transit Gateway como nodo central que conecte las VPC y el centro de datos. Endpoints de Route 53 Resolver para el DNS en ambas direcciones. Y una segmentación clara con tablas de rutas y security groups, además de monitorizar los enlaces.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-J1', 'CLD-03', 'Junior', 'mc', '¿Qué es un contenedor?', null, 'Un paquete con la aplicación y sus dependencias que se ejecuta aislado compartiendo el kernel del sistema', array['Una máquina virtual completa', 'Un servidor físico', 'Un lenguaje de programación']::text[], 'Es más ligero que una VM porque no incluye un sistema operativo completo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-J2', 'CLD-03', 'Junior', 'fill', 'Las instrucciones para construir una imagen de Docker se escriben en un ___.', null, 'Dockerfile', array['docker-compose.yml', 'package.json', 'Makefile']::text[], 'docker build lo lee y genera la imagen.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-J3', 'CLD-03', 'Junior', 'mc', '¿Diferencia entre imagen y contenedor?', null, 'La imagen es la plantilla inmutable; el contenedor es una instancia en ejecución de esa imagen', array['Son lo mismo', 'El contenedor es la plantilla', 'La imagen solo existe en producción']::text[], 'Como una clase (imagen) y sus objetos (contenedores).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-J4', 'CLD-03', 'Junior', 'open', '¿Qué ventajas aporta Docker a un equipo de desarrollo?', 'What advantages does Docker bring to a development team?', null, '{}'::text[], null, null, null, 'same environment everywhere (works on my machine); fast setup; isolation; reproducible builds; easier CI/CD; portability across clouds', 'Docker gives everyone the same environment, from a developer''s laptop to production, so you avoid the ''it works on my machine'' problem. New people can run the whole project with one command. Each service is isolated with its own dependencies, builds are reproducible, and the same image can run in CI, on any cloud or on Kubernetes.', 'Docker da a todo el mundo el mismo entorno, desde el portátil de un desarrollador hasta producción, y evita el problema de «en mi máquina funciona». Las personas nuevas pueden arrancar todo el proyecto con un comando. Cada servicio está aislado con sus dependencias, los builds son reproducibles y la misma imagen puede ejecutarse en CI, en cualquier nube o en Kubernetes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-M1', 'CLD-03', 'Mid', 'mc', '¿Qué ventaja tiene un build multi-stage en Docker?', null, 'Imágenes finales más pequeñas y seguras, sin herramientas de compilación', array['Builds más lentos pero más bonitos', 'Permite usar varios Dockerfiles', 'Ninguna']::text[], 'Compilas en una etapa y copias solo el resultado a una imagen base mínima.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-M2', 'CLD-03', 'Mid', 'mc', 'En Kubernetes, ¿qué es un Deployment?', null, 'Un objeto que mantiene un número de réplicas de pods y gestiona sus actualizaciones', array['Un servidor físico', 'Una imagen de Docker', 'Un balanceador externo']::text[], 'Si un pod muere, el Deployment crea otro.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-M3', 'CLD-03', 'Mid', 'mc', '¿Qué hace un Service de Kubernetes?', null, 'Da una dirección estable para acceder a un grupo de pods y reparte el tráfico entre ellos', array['Construye imágenes', 'Guarda secretos', 'Escala los nodos']::text[], 'Los pods cambian de IP; el Service no.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-M4', 'CLD-03', 'Mid', 'open', '¿Cuándo elegirías ECS con Fargate y cuándo EKS?', 'When would you choose ECS with Fargate and when EKS?', null, '{}'::text[], null, null, null, 'ECS/Fargate: simpler, AWS-native, no cluster management, smaller teams; EKS: Kubernetes standard, portability, ecosystem (Helm, operators), complex workloads, team with K8s skills, more operational cost', 'I''d choose ECS with Fargate when the team wants something simple and AWS-native: no cluster or nodes to manage, and it integrates well with the rest of AWS. I''d choose EKS when we need Kubernetes specifically, for portability between clouds, the ecosystem like Helm and operators, or because the team already has Kubernetes experience. EKS is more powerful but has a higher operational cost.', 'Elegiría ECS con Fargate cuando el equipo quiere algo sencillo y nativo de AWS: sin clúster ni nodos que gestionar y bien integrado con el resto de AWS. Elegiría EKS cuando necesitamos Kubernetes específicamente, por portabilidad entre nubes, por su ecosistema como Helm y los operadores, o porque el equipo ya tiene experiencia con Kubernetes. EKS es más potente, pero tiene más coste operativo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-S1', 'CLD-03', 'Senior', 'mc', '¿Qué hacen las readiness y liveness probes?', null, 'Readiness indica si el pod puede recibir tráfico; liveness, si hay que reiniciarlo', array['Son lo mismo', 'Miden el coste', 'Solo sirven en desarrollo']::text[], 'Una liveness mal configurada puede provocar reinicios en cadena.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-S2', 'CLD-03', 'Senior', 'mc', '¿Para qué sirve el Horizontal Pod Autoscaler?', null, 'Para aumentar o reducir el número de pods según métricas como CPU o métricas propias', array['Para añadir CPU a un pod', 'Para crear nodos nuevos directamente', 'Para hacer backups']::text[], 'Para escalar nodos se usa Cluster Autoscaler o Karpenter.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-S3', 'CLD-03', 'Senior', 'mc', '¿Cómo gestionarías secretos en Kubernetes en AWS de forma segura?', null, 'Guardarlos en Secrets Manager o Parameter Store y sincronizarlos (p. ej. External Secrets) con permisos por pod', array['En variables de entorno dentro de la imagen', 'En el repositorio cifrados en base64', 'En un ConfigMap']::text[], 'Base64 no es cifrado. IRSA o Pod Identity dan permisos de IAM por pod.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-03-S4', 'CLD-03', 'Senior', 'open', '¿Cómo harías un despliegue sin caída de servicio de una aplicación en contenedores?', 'How would you deploy a containerized application with zero downtime?', null, '{}'::text[], null, null, null, 'rolling update with proper readiness probes; or blue/green or canary (CodeDeploy, Argo Rollouts); backward-compatible DB migrations; health checks; automatic rollback on metrics; graceful shutdown', 'I''d use a rolling update, or for critical services a blue/green or canary deployment. The key is good readiness probes, so traffic only goes to healthy pods, and graceful shutdown, so pods finish their requests before stopping. Database migrations must be backward compatible. And I''d watch error rates and latency during the rollout, with automatic rollback if they get worse.', 'Usaría un rolling update o, para servicios críticos, un despliegue blue/green o canary. La clave son unas buenas readiness probes, para que el tráfico solo vaya a pods sanos, y un apagado ordenado, para que los pods terminen sus peticiones antes de parar. Las migraciones de base de datos tienen que ser compatibles hacia atrás. Y vigilaría la tasa de errores y la latencia durante el despliegue, con vuelta atrás automática si empeoran.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-J1', 'CLD-04', 'Junior', 'mc', '¿Qué es CI (integración continua)?', null, 'Integrar cambios con frecuencia y validarlos automáticamente con build y tests', array['Desplegar a mano los viernes', 'Un tipo de servidor', 'Una metodología de diseño']::text[], 'CD (entrega o despliegue continuo) lleva esos cambios hasta los entornos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-J2', 'CLD-04', 'Junior', 'mc', '¿Qué es la infraestructura como código (IaC)?', null, 'Definir la infraestructura en archivos versionados y crearla de forma automática', array['Programar dentro de los servidores', 'Documentar la infraestructura en Word', 'Usar solo la consola web']::text[], 'Herramientas: Terraform, CloudFormation, CDK.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-J3', 'CLD-04', 'Junior', 'fill', 'En Terraform, el comando que muestra qué cambios se van a aplicar sin aplicarlos es terraform ___.', null, 'plan', array['apply', 'init', 'show']::text[], 'init prepara, plan previsualiza y apply ejecuta.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-J4', 'CLD-04', 'Junior', 'open', 'Describe un pipeline de CI/CD típico.', 'Describe a typical CI/CD pipeline.', null, '{}'::text[], null, null, null, 'trigger on push/PR; install dependencies; lint; tests; build artifact/image; security scan; push to registry; deploy to staging; tests; approval; deploy to production; notifications', 'When someone pushes code or opens a pull request, the pipeline starts. It installs dependencies, runs the linter and the tests, and builds the artifact or Docker image. Then a security scan, and the image is pushed to a registry. It deploys automatically to a staging environment, runs some tests there, and after an approval it deploys to production. The team gets notified if anything fails.', 'Cuando alguien sube código o abre una pull request, arranca el pipeline. Instala las dependencias, pasa el linter y los tests, y construye el artefacto o la imagen de Docker. Después hace un análisis de seguridad y sube la imagen a un registro. Despliega automáticamente en un entorno de preproducción, ejecuta algunas pruebas ahí y, tras una aprobación, despliega en producción. El equipo recibe un aviso si algo falla.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-M1', 'CLD-04', 'Mid', 'mc', '¿Qué es el state de Terraform y dónde guardarlo en equipo?', null, 'El registro de lo que Terraform gestiona; se guarda en un backend remoto (S3) con bloqueo', array['Una variable de entorno', 'Se guarda en el repositorio sin problema', 'No hace falta guardarlo']::text[], 'Sin bloqueo, dos personas pueden aplicar a la vez y corromperlo. El state puede contener secretos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-M2', 'CLD-04', 'Mid', 'mc', '¿Qué es el ''drift'' en infraestructura?', null, 'Diferencias entre lo definido en código y lo que existe realmente, por cambios manuales', array['Un tipo de despliegue', 'Un error de red', 'La latencia entre regiones']::text[], 'Se detecta con terraform plan periódicos o detección de drift de CloudFormation.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-M3', 'CLD-04', 'Mid', 'mc', '¿Cómo se autentica de forma segura un pipeline de GitHub Actions en AWS?', null, 'Con OIDC asumiendo un rol de IAM, sin claves de larga duración', array['Con las claves del usuario root', 'Con claves de acceso guardadas en el código', 'No necesita autenticarse']::text[], 'OIDC da credenciales temporales por ejecución.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-M4', 'CLD-04', 'Mid', 'open', '¿Cómo organizarías el código Terraform para varios entornos?', 'How would you organize Terraform code for several environments?', null, '{}'::text[], null, null, null, 'reusable modules; separate state per environment; environment folders or workspaces with tfvars; remote backend with locking; pipeline running plan on PR and apply after approval; version pinning', 'I''d write reusable modules for the common pieces, like the network or a service, and then one configuration per environment that uses those modules with different variables. Each environment has its own remote state in S3 with locking. The pipeline runs terraform plan on every pull request so reviewers see the changes, and apply only after approval. And I''d pin the provider and module versions.', 'Escribiría módulos reutilizables para las piezas comunes, como la red o un servicio, y una configuración por entorno que use esos módulos con distintas variables. Cada entorno tiene su propio state remoto en S3 con bloqueo. El pipeline ejecuta terraform plan en cada pull request para que se vean los cambios en la revisión, y apply solo tras la aprobación. Y fijaría las versiones de los providers y de los módulos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-S1', 'CLD-04', 'Senior', 'mc', '¿Qué es GitOps?', null, 'Usar Git como fuente de verdad del estado deseado; un agente (Argo CD, Flux) sincroniza el clúster con el repositorio', array['Hacer commits directamente en producción', 'Una herramienta de Git', 'Un tipo de rama']::text[], 'Cada cambio queda auditado y revertir es hacer revert.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-S2', 'CLD-04', 'Senior', 'mc', '¿Qué diferencia hay entre despliegue canary y blue/green?', null, 'Canary manda un porcentaje creciente de tráfico a la versión nueva; blue/green cambia todo el tráfico de un entorno completo a otro', array['Son lo mismo', 'Canary no usa tráfico real', 'Blue/green solo sirve para bases de datos']::text[], 'Ambos permiten revertir rápido; canary limita el impacto de un error.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-S3', 'CLD-04', 'Senior', 'mc', '¿Qué son las métricas DORA?', null, 'Frecuencia de despliegue, lead time de cambios, tasa de fallos en cambios y tiempo de recuperación', array['Métricas de coste en AWS', 'Indicadores de seguridad de red', 'Métricas de uso de CPU']::text[], 'Miden el rendimiento de la entrega de software de un equipo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-04-S4', 'CLD-04', 'Senior', 'open', '¿Cómo mejorarías un proceso de despliegue lento y manual en una empresa?', 'How would you improve a slow and manual deployment process in a company?', null, '{}'::text[], null, null, null, 'measure current state (DORA); automate build/test first; infrastructure as code; standard pipeline templates; smaller and more frequent releases; feature flags; progressive delivery; automated rollback; involve teams, change culture gradually', 'First I''d measure the current situation, for example with the DORA metrics, and talk to the teams about the pain points. Then I''d automate step by step: builds and tests first, then infrastructure as code, then deployments with standard pipeline templates. I''d push for smaller, more frequent releases, with feature flags and canary deployments to reduce risk. The cultural part matters as much as the tools.', 'Primero mediría la situación actual, por ejemplo con las métricas DORA, y hablaría con los equipos sobre los puntos de dolor. Después automatizaría paso a paso: primero builds y tests, luego infraestructura como código y luego despliegues con plantillas de pipeline estándar. Impulsaría releases más pequeñas y frecuentes, con feature flags y despliegues canary para reducir el riesgo. La parte cultural importa tanto como las herramientas.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-J1', 'CLD-05', 'Junior', 'mc', '¿Qué comando muestra los procesos en ejecución?', null, 'ps (o top / htop)', array['ls', 'cd', 'chmod']::text[], 'top y htop se actualizan en tiempo real.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-J2', 'CLD-05', 'Junior', 'fill', 'Para dar permisos de ejecución a un script se usa ___ +x script.sh.', null, 'chmod', array['chown', 'sudo', 'mv']::text[], 'chown cambia el propietario; chmod, los permisos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-J3', 'CLD-05', 'Junior', 'mc', '¿Qué hace `tail -f /var/log/app.log`?', null, 'Muestra el final del archivo y sigue mostrando las líneas nuevas en tiempo real', array['Borra el log', 'Muestra el principio del archivo', 'Comprime el log']::text[], 'Muy útil para seguir logs mientras reproduces un problema.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-J4', 'CLD-05', 'Junior', 'open', '¿Cómo comprobarías por qué un servidor Linux va lento?', 'How would you check why a Linux server is slow?', null, '{}'::text[], null, null, null, 'top/htop for CPU and memory; free -h; df -h for disk space; iostat for disk I/O; check logs; network (ss, ping); identify the process', 'I''d start with top or htop to see CPU and memory usage and which process is using them. Then free to check memory and swap, df to check if a disk is full, and iostat if I suspect disk activity. I''d look at the system and application logs, and check the network if it seems related. The goal is to find which resource is the bottleneck and which process causes it.', 'Empezaría con top o htop para ver el uso de CPU y memoria y qué proceso los consume. Después free para revisar la memoria y el swap, df para ver si algún disco está lleno, e iostat si sospecho de la actividad del disco. Miraría los logs del sistema y de la aplicación, y revisaría la red si parece relacionado. El objetivo es encontrar qué recurso es el cuello de botella y qué proceso lo provoca.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-M1', 'CLD-05', 'Mid', 'mc', '¿Qué hace `set -euo pipefail` al principio de un script de Bash?', null, 'Hace que el script falle ante errores, variables no definidas y fallos dentro de pipes', array['Activa el modo debug', 'Hace el script más rápido', 'Lo ejecuta como root']::text[], 'Evita que un script siga adelante tras un fallo silencioso.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-M2', 'CLD-05', 'Mid', 'mc', '¿Con qué gestionas un servicio en un Linux moderno?', null, 'systemctl (systemd)', array['crontab', 'apt', 'ssh']::text[], 'systemctl status/start/restart/enable, y journalctl para sus logs.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-M3', 'CLD-05', 'Mid', 'mc', '¿Qué hace `grep -r "ERROR" /var/log | wc -l`?', null, 'Cuenta las líneas que contienen ERROR en los logs, de forma recursiva', array['Borra los errores', 'Muestra solo el primer error', 'Comprime los logs']::text[], 'Las tuberías encadenan comandos pequeños.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-M4', 'CLD-05', 'Mid', 'open', 'Escribiste un script que funciona a mano pero falla en un cron. ¿Qué revisarías?', 'You wrote a script that works manually but fails in cron. What would you check?', null, '{}'::text[], null, null, null, 'cron has minimal environment: PATH and variables; use absolute paths; working directory; permissions and user; redirect output to a log to see errors; shebang', 'Cron runs with a very minimal environment, so the first thing I''d check is the PATH and environment variables: I''d use absolute paths for commands and files. Also the working directory, which isn''t the same as when I run it by hand, and the user and permissions. And I''d redirect the output and errors to a log file, so I can see what''s actually failing.', 'Cron se ejecuta con un entorno mínimo, así que lo primero es revisar el PATH y las variables de entorno: usaría rutas absolutas para comandos y archivos. También el directorio de trabajo, que no es el mismo que cuando lo lanzo a mano, y el usuario y los permisos. Y redirigiría la salida y los errores a un archivo de log para ver qué falla realmente.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-S1', 'CLD-05', 'Senior', 'mc', '¿Qué indica un load average alto con CPU casi ociosa?', null, 'Procesos esperando I/O (disco o red), por ejemplo en estado D', array['Que todo va bien', 'Que falta CPU', 'Que el kernel está desactualizado']::text[], 'El load average cuenta también procesos bloqueados esperando I/O.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-S2', 'CLD-05', 'Senior', 'mc', '¿Qué herramienta usarías para ver qué llamadas al sistema hace un proceso?', null, 'strace', array['ls', 'cat', 'uptime']::text[], 'Útil para depurar procesos que se cuelgan o fallan sin log.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-S3', 'CLD-05', 'Senior', 'mc', '¿Por qué preferir herramientas de gestión de configuración o imágenes inmutables a conectarse por SSH a cambiar cosas?', null, 'Cambios reproducibles, auditables y sin servidores ''copo de nieve'' distintos entre sí', array['Porque SSH es lento', 'Porque SSH está prohibido en AWS', 'No hay diferencia']::text[], 'Con SSM Session Manager ni siquiera hace falta abrir el puerto 22.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-05-S4', 'CLD-05', 'Senior', 'open', 'Cuéntame cómo automatizarías tareas operativas repetitivas en una plataforma.', 'Tell me how you would automate repetitive operational tasks on a platform.', null, '{}'::text[], null, null, null, 'identify toil and measure it; scripts in version control with tests; idempotent automation; runbooks as code (SSM Automation, Lambda); event-driven remediation; logging and alerts; self-service for developers', 'I''d first identify the toil: the manual tasks the team repeats most and how much time they take. Then automate them with versioned, idempotent scripts, or with tools like SSM Automation or Lambda triggered by events, for example to restart a service or clean up disks automatically. Everything logged and with alerts if the automation fails. And where possible, I''d give developers self-service tools, so they don''t need to open tickets.', 'Primero identificaría el trabajo manual repetitivo: las tareas que más repite el equipo y cuánto tiempo consumen. Después las automatizaría con scripts versionados e idempotentes, o con herramientas como SSM Automation o Lambda activadas por eventos, por ejemplo para reiniciar un servicio o limpiar discos automáticamente. Todo con logs y alertas si la automatización falla. Y, donde se pueda, daría herramientas de autoservicio a los desarrolladores para que no tengan que abrir tickets.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-J1', 'CLD-06', 'Junior', 'mc', '¿Qué servicio de AWS recoge métricas, logs y alarmas?', null, 'Amazon CloudWatch', array['Amazon S3', 'AWS IAM', 'Amazon Route 53']::text[], 'CloudTrail, en cambio, registra quién hizo qué llamada a la API.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-J2', 'CLD-06', 'Junior', 'mc', '¿Qué son los tres pilares de la observabilidad?', null, 'Logs, métricas y trazas', array['CPU, memoria y disco', 'Dev, QA y producción', 'Alarmas, emails y SMS']::text[], 'Las trazas siguen una petición a través de varios servicios.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-J3', 'CLD-06', 'Junior', 'fill', 'Una alarma de CloudWatch puede enviar notificaciones a través de ___.', null, 'SNS', array['S3', 'EBS', 'VPC']::text[], 'SNS reparte el aviso por email, SMS, Slack (vía integraciones) o Lambda.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-J4', 'CLD-06', 'Junior', 'open', '¿Qué harías si te avisan de que la web de producción no responde?', 'What would you do if you were told the production website is down?', null, '{}'::text[], null, null, null, 'confirm and assess impact; communicate; check recent changes/deployments; dashboards, health checks, logs; rollback if a deploy caused it; mitigate first, root cause later; postmortem', 'First I''d confirm the problem and its impact, and let the team know I''m on it. Then I''d check what changed recently, because a new deployment is the most common cause, and look at the dashboards, health checks and logs. If a deploy caused it, I''d roll back first and investigate later. The priority is to restore the service, and afterwards do a blameless postmortem to prevent it from happening again.', 'Primero confirmaría el problema y su impacto, y avisaría al equipo de que me ocupo. Después revisaría qué ha cambiado recientemente, porque un despliegue nuevo es la causa más habitual, y miraría los dashboards, los health checks y los logs. Si lo ha provocado un despliegue, volvería atrás primero e investigaría después. La prioridad es recuperar el servicio y, después, hacer un postmortem sin culpables para que no se repita.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-M1', 'CLD-06', 'Mid', 'mc', '¿Qué diferencia hay entre RTO y RPO?', null, 'RTO es cuánto tiempo puedes estar caído; RPO, cuántos datos puedes permitirte perder (medido en tiempo)', array['Son lo mismo', 'RTO mide coste y RPO rendimiento', 'RPO es el tiempo de despliegue']::text[], 'Ambos definen qué estrategia de recuperación ante desastres necesitas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-M2', 'CLD-06', 'Mid', 'mc', '¿Qué hace un Auto Scaling Group con health checks del balanceador?', null, 'Sustituye automáticamente las instancias que dejan de estar sanas', array['Borra la aplicación', 'Solo reduce costes', 'Hace backups']::text[], 'Combinado con varias AZ, da recuperación automática ante fallos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-M3', 'CLD-06', 'Mid', 'mc', '¿Qué es un SLO?', null, 'Un objetivo interno de fiabilidad, por ejemplo 99,9% de peticiones correctas al mes', array['Un contrato con penalizaciones', 'Un tipo de log', 'Una alarma de coste']::text[], 'El SLA es el compromiso contractual; el SLI, la métrica que se mide.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-M4', 'CLD-06', 'Mid', 'open', '¿Qué alarmas configurarías para una API en producción?', 'What alarms would you set up for an API in production?', null, '{}'::text[], null, null, null, 'user-facing symptoms: error rate (5xx), latency (p95/p99), availability; saturation: CPU, memory, connections, queue depth; dependencies (DB); avoid alert fatigue; actionable alerts with runbooks; severity levels', 'I''d focus on symptoms that users notice: the error rate, especially 5xx responses, latency at p95 or p99, and availability. Then saturation metrics like CPU, memory, database connections or queue depth, which warn before things break. Every alert should be actionable and link to a runbook, with different severity levels, so the team doesn''t get alert fatigue.', 'Me centraría en los síntomas que notan los usuarios: la tasa de errores, sobre todo respuestas 5xx, la latencia en p95 o p99 y la disponibilidad. Después, métricas de saturación como CPU, memoria, conexiones a la base de datos o profundidad de las colas, que avisan antes de que algo se rompa. Cada alerta debe permitir actuar y enlazar a un runbook, con distintos niveles de gravedad, para que el equipo no acabe saturado de alertas.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-S1', 'CLD-06', 'Senior', 'mc', '¿Qué es el error budget?', null, 'El margen de fallos que permite el SLO; si se agota, se prioriza la fiabilidad sobre funcionalidades nuevas', array['El presupuesto para comprar servidores', 'Un tipo de alarma', 'El número de bugs permitidos en QA']::text[], 'Equilibra la velocidad de desarrollo y la estabilidad.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-S2', 'CLD-06', 'Senior', 'mc', '¿Qué estrategia de DR tiene menor RTO?', null, 'Multi-site activo-activo', array['Backup and restore', 'Pilot light', 'Warm standby']::text[], 'También es la más cara. De más barata a más rápida: backup, pilot light, warm standby, activo-activo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-S3', 'CLD-06', 'Senior', 'mc', '¿Qué es el chaos engineering?', null, 'Introducir fallos controlados para comprobar que el sistema resiste como se espera', array['Desplegar sin tests', 'Romper producción sin avisar', 'Un tipo de monitorización']::text[], 'AWS Fault Injection Service permite hacerlo de forma controlada.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('CLD-06-S4', 'CLD-06', 'Senior', 'open', '¿Cómo diseñarías una arquitectura de alta disponibilidad para una aplicación crítica?', 'How would you design a high-availability architecture for a critical application?', null, '{}'::text[], null, null, null, 'eliminate single points of failure; multi-AZ for compute and database (RDS Multi-AZ/Aurora); load balancer and auto scaling; stateless services; queues to decouple; backups and DR plan with RTO/RPO; multi-region if needed; health checks; observability; test failures', 'I''d remove single points of failure: stateless services behind a load balancer with auto scaling across at least two availability zones, and a database with Multi-AZ, like Aurora. I''d decouple components with queues, so a slow service doesn''t bring everything down. A disaster recovery plan based on the agreed RTO and RPO, and multiple regions only if the business needs it. Plus good observability and regular failure tests to make sure it really works.', 'Eliminaría los puntos únicos de fallo: servicios sin estado detrás de un balanceador con autoescalado en al menos dos zonas de disponibilidad, y una base de datos Multi-AZ, como Aurora. Desacoplaría componentes con colas, para que un servicio lento no tumbe todo. Un plan de recuperación ante desastres según el RTO y el RPO acordados, y varias regiones solo si el negocio lo necesita. Además, buena observabilidad y pruebas de fallos periódicas para asegurar que realmente funciona.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-J1', 'BCK-01', 'Junior', 'mc', '¿Diferencia entre `==` y `equals()` con objetos?', null, '== compara referencias; equals() compara el contenido (si está bien implementado)', array['Son iguales', 'equals() compara referencias', '== solo funciona con Strings']::text[], 'Clásico con Strings: usa siempre equals().', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-J2', 'BCK-01', 'Junior', 'mc', '¿Qué colección usarías para no tener elementos repetidos?', null, 'Set (por ejemplo HashSet)', array['ArrayList', 'LinkedList', 'Array']::text[], 'Un Map guarda pares clave-valor con claves únicas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-J3', 'BCK-01', 'Junior', 'fill', 'Una excepción que el compilador obliga a capturar o declarar es una excepción ___.', null, 'checked', array['unchecked', 'runtime', 'final']::text[], 'IOException es checked; NullPointerException es unchecked (RuntimeException).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-J4', 'BCK-01', 'Junior', 'open', '¿Qué son los cuatro pilares de la programación orientada a objetos?', 'What are the four pillars of object-oriented programming?', null, '{}'::text[], null, null, null, 'encapsulation, inheritance, polymorphism, abstraction; short example of each', 'The four pillars are encapsulation, which means hiding the internal state and exposing methods; inheritance, which lets a class reuse another class''s behaviour; polymorphism, which lets you treat different objects through the same interface; and abstraction, which means exposing only what''s necessary and hiding the details.', 'Los cuatro pilares son la encapsulación, que consiste en ocultar el estado interno y exponer métodos; la herencia, que permite a una clase reutilizar el comportamiento de otra; el polimorfismo, que permite tratar objetos distintos a través de la misma interfaz; y la abstracción, que consiste en exponer solo lo necesario y ocultar los detalles.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-M1', 'BCK-01', 'Mid', 'mc', 'Si sobrescribes `equals()`, ¿qué más debes sobrescribir?', null, 'hashCode()', array['toString()', 'finalize()', 'clone()']::text[], 'Si no, los objetos iguales irían a buckets distintos en un HashMap.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-M2', 'BCK-01', 'Mid', 'mc', '¿Qué hace `Optional`?', null, 'Representa un valor que puede o no existir, para evitar null y NullPointerException', array['Hace un campo opcional en la base de datos', 'Optimiza el rendimiento', 'Sustituye a las excepciones']::text[], 'Úsalo sobre todo como tipo de retorno, no en campos ni parámetros.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-M3', 'BCK-01', 'Mid', 'mc', '¿Qué hace este código: `list.stream().filter(x -> x > 5).map(x -> x * 2).toList()`?', null, 'Filtra los mayores que 5, los duplica y devuelve una lista nueva', array['Modifica la lista original', 'Devuelve un número', 'Lanza una excepción']::text[], 'Los streams no modifican la colección original.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-M4', 'BCK-01', 'Mid', 'open', '¿Qué novedades de Java moderno (17 o posterior) usas o conoces?', 'What features of modern Java (17 or later) do you use or know?', null, '{}'::text[], null, null, null, 'records; sealed classes; pattern matching for instanceof and switch; text blocks; var; virtual threads (21); sequenced collections', 'I like records for immutable data classes, because they remove a lot of boilerplate. Pattern matching for instanceof and switch makes the code cleaner, and sealed classes let you control which classes can extend a type. Text blocks are useful for SQL or JSON. And in Java 21, virtual threads make it much easier to handle many concurrent requests.', 'Me gustan los records para clases de datos inmutables, porque eliminan mucho código repetitivo. El pattern matching en instanceof y switch hace el código más limpio, y las sealed classes permiten controlar qué clases pueden extender un tipo. Los text blocks son útiles para SQL o JSON. Y en Java 21, los virtual threads facilitan mucho atender muchas peticiones concurrentes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-S1', 'BCK-01', 'Senior', 'mc', '¿Qué aportan los virtual threads de Java 21?', null, 'Hilos muy ligeros gestionados por la JVM que permiten miles de tareas concurrentes bloqueantes sin agotar recursos', array['Hacen el código más rápido en CPU', 'Sustituyen a la base de datos', 'Eliminan el garbage collector']::text[], 'Ideales para servicios con mucho I/O; no aceleran el cálculo intensivo.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-S2', 'BCK-01', 'Senior', 'mc', 'Una aplicación consume cada vez más memoria hasta caerse. ¿Qué harías primero?', null, 'Sacar un heap dump y analizarlo (p. ej. con Eclipse MAT) para ver qué objetos se acumulan', array['Aumentar la memoria sin más', 'Reiniciar cada noche', 'Cambiar a otro lenguaje']::text[], 'Fugas típicas: cachés sin límite, listeners sin eliminar, colecciones estáticas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-S3', 'BCK-01', 'Senior', 'mc', '¿Qué colección es segura para acceso concurrente y eficiente?', null, 'ConcurrentHashMap', array['HashMap', 'TreeMap', 'ArrayList']::text[], 'Collections.synchronizedMap también es segura, pero bloquea todo el mapa.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-01-S4', 'BCK-01', 'Senior', 'open', '¿Cómo afrontarías problemas de concurrencia en una aplicación Java?', 'How would you deal with concurrency problems in a Java application?', null, '{}'::text[], null, null, null, 'prefer immutability and stateless services; thread-safe collections; avoid shared mutable state; synchronized/locks only when needed; atomic classes; executors/CompletableFuture/virtual threads; database-level locking; testing and thread dumps', 'My first rule is to avoid shared mutable state: immutable objects and stateless services remove most problems. When state must be shared, I use thread-safe structures like ConcurrentHashMap or atomic classes, and locks only where really needed. For async work I use executors, CompletableFuture or virtual threads. And for data consistency, often the right place is the database, with transactions or optimistic locking.', 'Mi primera regla es evitar el estado mutable compartido: los objetos inmutables y los servicios sin estado eliminan la mayoría de los problemas. Cuando hay que compartir estado, uso estructuras seguras para hilos como ConcurrentHashMap o las clases atómicas, y bloqueos solo donde son realmente necesarios. Para trabajo asíncrono uso executors, CompletableFuture o virtual threads. Y para la consistencia de los datos, a menudo el sitio correcto es la base de datos, con transacciones o bloqueo optimista.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-J1', 'BCK-02', 'Junior', 'mc', '¿Qué hace la anotación `@SpringBootApplication`?', null, 'Combina configuración, autoconfiguración y escaneo de componentes para arrancar la aplicación', array['Crea la base de datos', 'Define un endpoint', 'Hace los tests']::text[], 'Incluye @Configuration, @EnableAutoConfiguration y @ComponentScan.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-J2', 'BCK-02', 'Junior', 'mc', '¿Qué forma de inyectar dependencias se recomienda en Spring?', null, 'Por constructor', array['Con @Autowired en campos privados', 'Con new dentro de la clase', 'Con variables estáticas']::text[], 'Facilita los tests y permite campos final.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-J3', 'BCK-02', 'Junior', 'fill', 'Para marcar una clase de lógica de negocio como bean de Spring se usa ___.', null, '@Service', array['@Entity', '@Value', '@Bean']::text[], '@Component es la genérica; @Service, @Repository y @Controller son especializaciones.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-J4', 'BCK-02', 'Junior', 'open', '¿Qué es Spring Boot y qué aporta frente a Spring ''clásico''?', 'What is Spring Boot and what does it add compared to ''classic'' Spring?', null, '{}'::text[], null, null, null, 'autoconfiguration; starters; embedded server; convention over configuration; production-ready features with Actuator; less XML/boilerplate', 'Spring Boot is built on top of Spring to make it much faster to start a project. It gives you autoconfiguration based on the dependencies you add, starters that group common libraries, and an embedded server, so you just run a jar. It follows convention over configuration, and with Actuator you get health checks and metrics ready for production.', 'Spring Boot se construye sobre Spring para que arrancar un proyecto sea mucho más rápido. Te da autoconfiguración según las dependencias que añades, starters que agrupan librerías habituales y un servidor embebido, así que solo ejecutas un jar. Sigue el principio de convención sobre configuración, y con Actuator tienes health checks y métricas listos para producción.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-M1', 'BCK-02', 'Mid', 'mc', '¿Qué ámbito (scope) tiene por defecto un bean de Spring?', null, 'Singleton', array['Prototype', 'Request', 'Session']::text[], 'Por eso los beans no deben guardar estado de una petición en sus campos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-M2', 'BCK-02', 'Mid', 'mc', '¿Para qué sirven los perfiles (`@Profile`, application-dev.yml)?', null, 'Para tener configuración y beans distintos según el entorno', array['Para gestionar usuarios', 'Para medir rendimiento', 'Para crear roles de seguridad']::text[], 'Se activan con spring.profiles.active.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-M3', 'BCK-02', 'Mid', 'mc', '¿Por qué `@Transactional` puede no funcionar al llamar a un método de la misma clase?', null, 'Porque funciona mediante un proxy, y la llamada interna no pasa por él', array['Porque solo funciona en métodos estáticos', 'Porque necesita XML', 'Siempre funciona']::text[], 'Solución: mover el método a otro bean o reestructurar.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-M4', 'BCK-02', 'Mid', 'open', 'Explica cómo funciona la autoconfiguración de Spring Boot.', 'Explain how Spring Boot autoconfiguration works.', null, '{}'::text[], null, null, null, 'autoconfiguration classes loaded from the classpath; conditional annotations (@ConditionalOnClass, @ConditionalOnMissingBean, @ConditionalOnProperty); you can override with your own beans or properties; debug report', 'Spring Boot ships with many autoconfiguration classes. At startup, it checks conditions: for example, if a database driver is on the classpath and you haven''t defined a DataSource yourself, it creates one using your properties. These conditions use annotations like ConditionalOnClass or ConditionalOnMissingBean. So you can always override the defaults by defining your own bean, and you can see what was applied with the debug report.', 'Spring Boot incluye muchas clases de autoconfiguración. Al arrancar comprueba condiciones: por ejemplo, si hay un driver de base de datos en el classpath y no has definido tú un DataSource, crea uno con tus propiedades. Esas condiciones usan anotaciones como ConditionalOnClass o ConditionalOnMissingBean. Así que siempre puedes sustituir lo que viene por defecto definiendo tu propio bean, y puedes ver qué se ha aplicado con el informe de depuración.', 'pending', true, null, null, null, null) on conflict (id) do nothing;

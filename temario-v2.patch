+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-J2', 'com-star', 'Junior', 'order', 'Ordena esta respuesta STAR', null, 'En las prácticas, el formulario de registro tenía muchos abandonos. | Me pidieron averiguar por qué y proponer una mejora. | Analicé los errores de validación y simplifiqué el formulario de 9 a 5 campos. | Los registros completados subieron un 30% el mes siguiente.', '{}'::text[], 'Situación → Tarea → Acción → Resultado. Cierra siempre con un resultado medible.', null, null, 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-J3', 'com-star', 'Junior', 'mc', '¿Cuál es la mejor estructura para "Tell me about yourself"?', null, 'Presente → pasado → futuro', array['Infancia → estudios → aficiones', 'Todo el CV, trabajo por trabajo', 'Fortalezas → debilidades → salario']::text[], 'Quién eres hoy, cómo llegaste y por qué este puesto encaja. Entre 60 y 90 segundos.', 'I''m a junior developer who recently finished my training in web development. During my internship I worked on a real product with a team, which taught me a lot about code reviews and teamwork. Now I''m looking for a team where I can keep learning and start contributing from the first weeks.', 'Soy desarrollador junior y acabo de terminar mi formación en desarrollo web. En las prácticas trabajé en un producto real con un equipo, lo que me enseñó mucho sobre code reviews y trabajo en equipo. Ahora busco un equipo donde seguir aprendiendo y empezar a aportar desde las primeras semanas.', 'pending', true, '¿Cuál es la mejor estructura para responder a «Háblame de ti»?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-M1', 'com-star', 'Mid', 'mc', '¿Qué respuesta a "What''s your greatest weakness?" funciona mejor?', null, 'I sometimes go too deep into details, so now I timebox research and check in with the team earlier.', array['I''m a perfectionist and I work too hard.', 'I don''t really have weaknesses.', 'I''m not very good at working in teams.']::text[], 'Una debilidad real pero no crítica para el puesto, más lo que haces para mejorarla.', 'Sometimes I go too deep into details before asking for help. Now I timebox my research, and if I''m stuck after an hour or so, I check in with the team. It''s made me much faster.', 'A veces profundizo demasiado en los detalles antes de pedir ayuda. Ahora me pongo un límite de tiempo y, si sigo atascado tras una hora, lo comento con el equipo. Me ha hecho mucho más rápido.', 'pending', true, 'Te preguntan «¿Cuál es tu mayor debilidad?». ¿Qué respuesta funciona mejor?', 'A veces profundizo demasiado en los detalles, así que ahora me pongo un límite de tiempo y consulto antes con el equipo.', array['Soy perfeccionista y trabajo demasiado.', 'La verdad es que no tengo debilidades.', 'No se me da muy bien trabajar en equipo.']::text[], null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-M2', 'com-star', 'Mid', 'mc', 'Te preguntan por un conflicto con un compañero. ¿Qué enfoque es mejor?', null, 'Contar un desacuerdo real, cómo lo hablasteis con datos y cómo se resolvió, sin culpar a nadie', array['Decir que nunca has tenido conflictos', 'Explicar por qué el compañero estaba equivocado', 'Cambiar de tema']::text[], 'Buscan madurez: escuchar, argumentar con datos y priorizar el objetivo del equipo.', 'In a project, a colleague and I disagreed about how to structure the state. Instead of arguing, we each wrote down pros and cons and built a quick proof of concept. We went with his approach, with one idea from mine, and it worked well. Since then we''ve worked really well together.', 'En un proyecto, un compañero y yo no estábamos de acuerdo en cómo estructurar el estado. En vez de discutir, apuntamos pros y contras y montamos una prueba de concepto rápida. Elegimos su enfoque con una idea del mío y funcionó bien. Desde entonces trabajamos muy bien juntos.', 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-M3', 'com-star', 'Mid', 'fill', 'En una respuesta STAR, habla de lo que hiciste ___, no solo de lo que hizo el equipo.', null, 'tú', array['el jefe', 'el cliente', 'la empresa']::text[], 'Di "I" más que "we": quieren saber cuál fue tu aportación.', null, null, 'pending', true, null, null, null, 'Habla en primera persona («yo propuse», «yo implementé») más que en plural: quieren saber cuál fue tu aportación.') on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-S1', 'com-star', 'Senior', 'mc', 'Te preguntan cómo has ayudado a crecer a otras personas. ¿Qué incluyes?', null, 'Un ejemplo concreto de mentoring con acciones (pair programming, feedback, delegar retos) y su resultado', array['Que siempre ayudas cuando te preguntan', 'Que el crecimiento es responsabilidad de cada uno', 'Una lista de cursos que recomiendas']::text[], 'En perfiles senior buscan impacto en el equipo, no solo en el código.', 'I mentored a junior developer who was struggling with RxJS. We did pair programming twice a week, I gave her small but real tasks, and I reviewed her pull requests with explanations, not just corrections. After three months she was leading a feature on her own.', 'Fui mentor de una desarrolladora junior a la que le costaba RxJS. Hacíamos pair programming dos veces por semana, le daba tareas pequeñas pero reales y revisaba sus pull requests explicando, no solo corrigiendo. A los tres meses lideraba ella sola una funcionalidad.', 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-S2', 'com-star', 'Senior', 'mc', '¿Cómo respondes a "Tell me about a technical decision you regret"?', null, 'Con una decisión real, por qué tenía sentido entonces, qué aprendiste y qué harías distinto', array['Diciendo que nunca te arrepientes de nada', 'Culpando al equipo de producto', 'Con un error trivial sin consecuencias']::text[], 'Demuestra criterio y capacidad de aprender, que es lo que se espera de un senior.', 'We added a global state library very early in a project, when the app was still small. It slowed the team down with a lot of boilerplate. Now I start with the simplest option and only add complexity when there''s a clear need.', 'Añadimos una librería de estado global muy pronto en un proyecto, cuando la app aún era pequeña. Ralentizó al equipo con mucho código repetitivo. Ahora empiezo por la opción más sencilla y solo añado complejidad cuando hay una necesidad clara.', 'pending', true, '¿Cómo respondes a «Cuéntame una decisión técnica de la que te arrepientas»?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-star-S3', 'com-star', 'Senior', 'fill', 'Para un senior, una buena respuesta STAR muestra el impacto en el ___, no solo en el código.', null, 'negocio', array['framework', 'IDE', 'linter']::text[], 'Habla de usuarios, costes, tiempos de entrega o ventas cuando puedas.', null, null, 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-J1', 'com-dificiles', 'Junior', 'mc', '"Why should we hire you?" (¿por qué deberíamos contratarte?) ¿Qué enfoque es mejor?', null, 'Unir dos o tres cosas concretas tuyas con lo que pide la oferta, y tu ganas de aprender', array['Decir que necesitas el trabajo', 'Decir que eres el mejor candidato sin más', 'Hablar de lo que no te gusta de tu trabajo actual']::text[], 'Relaciona tus fortalezas con las necesidades del puesto.', 'You''re looking for someone who knows Angular and can learn fast. I''ve built two projects with Angular and TypeScript, I''m used to working with Git in a team from my internship, and I''m someone who asks questions and learns quickly.', 'Buscáis a alguien que conozca Angular y aprenda rápido. He hecho dos proyectos con Angular y TypeScript, estoy acostumbrado a trabajar con Git en equipo desde las prácticas y soy alguien que pregunta y aprende rápido.', 'pending', true, '«¿Por qué deberíamos contratarte?» ¿Qué enfoque es mejor?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-J2', 'com-dificiles', 'Junior', 'mc', 'Te preguntan algo técnico que no sabes. ¿Qué haces?', null, 'Reconocerlo con naturalidad, explicar cómo lo averiguarías o razonar en voz alta lo que sí sabes', array['Inventarte la respuesta', 'Quedarte en silencio', 'Decir que no es importante']::text[], 'Inventar se nota y resta mucho; razonar suma.', 'I haven''t worked with that directly, but I''d guess it works similarly to X. In a real situation, I''d check the official documentation and try a small example.', 'No he trabajado con eso directamente, pero imagino que funciona de forma parecida a X. En una situación real, miraría la documentación oficial y probaría con un ejemplo pequeño.', 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-J3', 'com-dificiles', 'Junior', 'mc', '¿Qué buena pregunta puedes hacer tú al final?', null, 'What does a typical day look like for someone in this role?', array['How many vacation days do I get?', 'So, what does your company do?', 'No, I don''t have any questions.']::text[], 'Demuestra interés real y te da información para decidir.', 'What does a typical day look like for someone in this role? And how do new people get support during their first months?', '¿Cómo es un día normal en este puesto? ¿Y cómo apoyáis a las personas nuevas durante los primeros meses?', 'pending', true, null, '¿Cómo es un día normal para alguien en este puesto?', array['¿Cuántos días de vacaciones tendría?', 'Entonces, ¿a qué se dedica vuestra empresa?', 'No, no tengo ninguna pregunta.']::text[], null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-M1', 'com-dificiles', 'Mid', 'mc', '"I see a gap in your recent experience." (veo un hueco en tu experiencia reciente) ¿Cómo lo enfocas?', null, 'Breve y sincero, y luego centrarte en lo que hiciste para seguir en forma y por qué estás listo ahora', array['Cambiar de tema rápido', 'Explicar con detalle todo lo que salió mal', 'Echar la culpa a tu anterior empresa']::text[], 'Una frase de contexto, sin dramas, y enseguida a lo positivo.', 'Yes, my last project had very little development work, so I decided to use that time to retrain. I''ve been learning new technologies and catching up with the latest versions of my stack. Now I''m really keen to get back into a team and build things.', 'Sí, mi último proyecto tenía muy poco desarrollo, así que decidí aprovechar ese tiempo para formarme. He estado aprendiendo tecnologías nuevas y poniéndome al día con las últimas versiones de mi stack. Ahora tengo muchas ganas de volver a un equipo y construir cosas.', 'pending', true, '«Veo un hueco en tu experiencia reciente.» ¿Cómo lo enfocas?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-M2', 'com-dificiles', 'Mid', 'mc', '"Why did you leave your last job?" (¿por qué dejaste tu último trabajo?) ¿Qué respondes?', null, 'I wanted more hands-on coding and growth, and that wasn''t possible on that project.', array['My manager was terrible.', 'Honestly, I just needed any job.', 'I got bored.']::text[], 'Nunca hables mal de una empresa anterior. Enmárcalo en lo que buscas, no en lo que huyes.', 'I was on a project where I wasn''t getting much hands-on development, and I want to keep growing as a developer. So I''m looking for a team where I can build features every day and learn from good engineers.', 'Estaba en un proyecto donde apenas hacía desarrollo, y quiero seguir creciendo como desarrollador. Por eso busco un equipo donde pueda construir funcionalidades cada día y aprender de buenos ingenieros.', 'pending', true, '«¿Por qué dejaste tu último trabajo?» ¿Qué respondes?', 'Quería programar más y seguir creciendo, y en ese proyecto no era posible.', array['Mi jefe era horrible.', 'Sinceramente, necesitaba cualquier trabajo.', 'Me aburría.']::text[], null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-M3', 'com-dificiles', 'Mid', 'mc', '"What are your salary expectations?" (¿qué expectativas salariales tienes?) ¿Cómo lo enfocas?', null, 'Dar un rango investigado para el puesto y la ciudad, y mostrar algo de flexibilidad', array['Decir "lo que os parezca justo"', 'Negarte a responder', 'Decir una cifra muy por encima del mercado']::text[], 'Un rango investigado te protege de pedir poco y no cierra la puerta.', 'Based on what I''ve seen for similar roles, I''m looking for something between X and Y a year. But I''m flexible, it depends on the whole package and the remote options.', 'Por lo que he visto en puestos similares, busco algo entre X e Y al año. Pero soy flexible: depende del paquete completo y de las opciones de teletrabajo. (Sustituye X e Y por tu rango real.)', 'pending', true, '«¿Qué expectativas salariales tienes?» ¿Cómo lo enfocas?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-S1', 'com-dificiles', 'Senior', 'mc', 'Tienes otra oferta y te preguntan si estás en otros procesos. ¿Qué haces?', null, 'Ser sincero sin dar detalles innecesarios, y dejar claro por qué te interesa especialmente este puesto', array['Mentir y decir que no', 'Usarlo para presionar de forma agresiva', 'Negarte a responder']::text[], 'La transparencia genera confianza y puede acelerar el proceso.', 'Yes, I''m in a couple of other processes, one of them at an advanced stage. But this role is my first choice because of the product and the team, so I''d be happy to move forward quickly if it works for you.', 'Sí, estoy en un par de procesos más, uno de ellos bastante avanzado. Pero este puesto es mi primera opción por el producto y el equipo, así que me encantaría avanzar rápido si os encaja.', 'pending', true, null, null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-S2', 'com-dificiles', 'Senior', 'mc', '"How do you handle disagreement with your manager about a technical decision?" ¿Qué enfoque es mejor?', null, 'Plantear tu postura con datos y riesgos, escuchar sus motivos y, si se decide lo contrario, comprometerte con la decisión', array['Hacer lo que tú crees sin decir nada', 'Escalar directamente a su jefe', 'Aceptar siempre sin opinar']::text[], 'Es el principio de "disagree and commit".', 'I''d explain my concerns with data, for example the risks or the cost of each option, and listen to the reasons behind the decision. If we still go another way, I commit to it fully, and we agree on a point to review whether it''s working.', 'Explicaría mis dudas con datos, por ejemplo los riesgos o el coste de cada opción, y escucharía los motivos de la decisión. Si aun así se elige otro camino, me comprometo del todo y acordamos un momento para revisar si está funcionando.', 'pending', true, '«¿Cómo gestionas un desacuerdo con tu responsable sobre una decisión técnica?» ¿Qué enfoque es mejor?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;
+insert into public.questions (id, topic_id, level, type, prompt, code, correct, wrong, explanation, say_en, say_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('com-dificiles-S3', 'com-dificiles', 'Senior', 'mc', '"Why are you looking for a change after so many years?" ¿Qué respuesta funciona mejor?', null, 'Hablar de lo que buscas ahora (impacto, retos, liderazgo) y por qué este puesto lo ofrece', array['Decir que estás quemado', 'Quejarte de tu empresa actual', 'Decir que es solo por dinero']::text[], 'Enfoque positivo y orientado al futuro.', 'I''ve learned a lot in my current company, but I feel I''ve reached a point where I want a bigger impact, for example shaping the architecture of a product from the start. This role offers exactly that.', 'He aprendido mucho en mi empresa actual, pero siento que he llegado a un punto en el que quiero más impacto, por ejemplo definir la arquitectura de un producto desde el principio. Este puesto me ofrece justo eso.', 'pending', true, '«¿Por qué buscas un cambio después de tantos años?» ¿Qué respuesta funciona mejor?', null, null, null) on conflict (id) do update set topic_id = excluded.topic_id, level = excluded.level, type = excluded.type, prompt = excluded.prompt, code = excluded.code, correct = excluded.correct, wrong = excluded.wrong, explanation = excluded.explanation, say_en = excluded.say_en, say_es = excluded.say_es, status = excluded.status, active = excluded.active, es_prompt = excluded.es_prompt, es_correct = excluded.es_correct, es_wrong = excluded.es_wrong, es_explanation = excluded.es_explanation;

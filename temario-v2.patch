-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-J3', 'REA-03', 'Junior', 'mc', '¿Dónde es mejor hacer una petición inicial de datos en un componente de cliente sencillo?', null, 'En un useEffect (o mejor, con una librería como TanStack Query)', array['Directamente en el cuerpo del componente', 'En el constructor', 'En el CSS']::text[], 'Hacerla en el cuerpo la lanzaría en cada render.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-J4', 'REA-03', 'Junior', 'open', '¿Qué es el prop drilling y cómo lo evitas?', 'What is prop drilling and how do you avoid it?', null, '{}'::text[], null, null, null, 'passing props through many layers that don''t use them; solutions: component composition, Context, state management library; keep state close', 'Prop drilling is when you pass a prop through many components that don''t need it, just to reach a deep child. To avoid it, I first try composition, passing components as children. If the data is really global, like the user or the theme, I use Context. And for complex shared state, a library like Zustand or Redux Toolkit.', 'El prop drilling es pasar una prop por muchos componentes que no la necesitan solo para que llegue a un hijo profundo. Para evitarlo, primero pruebo con composición, pasando componentes como children. Si el dato es realmente global, como el usuario o el tema, uso Context. Y para un estado compartido complejo, una librería como Zustand o Redux Toolkit.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-M1', 'REA-03', 'Mid', 'mc', '¿Qué aporta TanStack Query (React Query)?', null, 'Gestión del estado del servidor: caché, reintentos, refetch, estados de carga y error', array['Un sistema de routing', 'Un framework CSS', 'Sustituye a useState para todo']::text[], 'Separa el estado del servidor del estado de la UI.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('REA-03-M2', 'REA-03', 'Mid', 'mc', 'Un problema de rendimiento típico de Context es…', null, 'Todos los consumidores se vuelven a renderizar cuando cambia el valor, aunque solo usen una parte', array['No funciona con TypeScript', 'Solo admite strings', 'No se puede anidar']::text[], 'Se mitiga dividiendo contextos o memorizando el valor.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;

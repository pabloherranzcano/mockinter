-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-S3', 'BCK-02', 'Senior', 'mc', '¿Dónde guardarías la configuración sensible (contraseñas, claves) de un servicio Spring en la nube?', null, 'En un gestor de secretos (Vault, AWS Secrets Manager) inyectado en tiempo de ejecución', array['En application.yml dentro del repositorio', 'En el código', 'En un comentario']::text[], 'Nunca secretos en el repositorio, ni siquiera en privado.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-02-S4', 'BCK-02', 'Senior', 'open', '¿Cómo harías que un servicio Spring Boot esté listo para producción?', 'How would you make a Spring Boot service production-ready?', null, '{}'::text[], null, null, null, 'externalized config and secrets; health checks (Actuator) and graceful shutdown; structured logging with correlation IDs; metrics and tracing (Micrometer, OpenTelemetry); error handling; security; resource limits; timeouts/retries/circuit breakers; tests and CI', 'I''d externalize the configuration and keep secrets in a secrets manager. Actuator health endpoints for the load balancer, and graceful shutdown. Structured logs with correlation IDs, metrics with Micrometer and tracing with OpenTelemetry. Consistent error handling and security from the start. Timeouts, retries and circuit breakers for every external call. And good tests running in CI before every deployment.', 'Sacaría la configuración fuera del código y guardaría los secretos en un gestor de secretos. Endpoints de salud de Actuator para el balanceador y apagado ordenado. Logs estructurados con IDs de correlación, métricas con Micrometer y trazas con OpenTelemetry. Gestión de errores coherente y seguridad desde el principio. Timeouts, reintentos y circuit breakers en cada llamada externa. Y buenos tests ejecutándose en CI antes de cada despliegue.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-J1', 'BCK-03', 'Junior', 'mc', '¿Qué método HTTP usarías para crear un recurso nuevo?', null, 'POST', array['GET', 'DELETE', 'HEAD']::text[], 'GET lee, POST crea, PUT reemplaza, PATCH modifica parcialmente, DELETE borra.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-J2', 'BCK-03', 'Junior', 'mc', '¿Qué significa un código de estado 404?', null, 'El recurso no existe', array['Error interno del servidor', 'No autenticado', 'Creado correctamente']::text[], '2xx éxito, 4xx error del cliente, 5xx error del servidor.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-J3', 'BCK-03', 'Junior', 'fill', 'En Spring, para crear un controlador REST que devuelve JSON se usa ___.', null, '@RestController', array['@Controller', '@Service', '@Repository']::text[], '@RestController = @Controller + @ResponseBody.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-J4', 'BCK-03', 'Junior', 'open', '¿Qué es una API REST?', 'What is a REST API?', null, '{}'::text[], null, null, null, 'architectural style over HTTP; resources identified by URLs; HTTP methods; stateless; representations like JSON; status codes', 'A REST API is a way to design web services using HTTP. Each resource, like a user or an order, has a URL, and you use the HTTP methods to work with it: GET to read, POST to create, PUT or PATCH to update and DELETE to remove. It''s stateless, so each request contains all the information needed, data is usually exchanged as JSON, and status codes tell you the result.', 'Una API REST es una forma de diseñar servicios web sobre HTTP. Cada recurso, como un usuario o un pedido, tiene una URL, y se usan los métodos HTTP para trabajar con él: GET para leer, POST para crear, PUT o PATCH para actualizar y DELETE para borrar. No guarda estado entre peticiones, así que cada petición lleva toda la información necesaria; los datos suelen intercambiarse en JSON y los códigos de estado indican el resultado.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-M1', 'BCK-03', 'Mid', 'mc', '¿Qué métodos HTTP son idempotentes?', null, 'GET, PUT y DELETE (repetirlos deja el mismo resultado)', array['Solo POST', 'POST y PATCH', 'Ninguno']::text[], 'POST no es idempotente: repetirlo puede crear duplicados.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-M2', 'BCK-03', 'Mid', 'mc', '¿Cómo gestionarías los errores de forma centralizada en Spring?', null, 'Con @RestControllerAdvice y @ExceptionHandler, devolviendo un formato común (p. ej. ProblemDetail)', array['Con try/catch en cada controlador', 'Devolviendo siempre 200', 'Con System.out.println']::text[], 'ProblemDetail sigue el estándar RFC 9457 para errores HTTP.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-M3', 'BCK-03', 'Mid', 'mc', '¿Para qué sirven los DTOs?', null, 'Para separar lo que expone la API del modelo interno (entidades), controlando qué datos entran y salen', array['Para conectarse a la base de datos', 'Para cifrar datos', 'No sirven para nada']::text[], 'Exponer entidades directamente filtra campos y acopla la API a la base de datos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-M4', 'BCK-03', 'Mid', 'open', '¿Cómo diseñarías la paginación y el versionado de una API?', 'How would you design pagination and versioning for an API?', null, '{}'::text[], null, null, null, 'pagination: page/size or cursor-based for large/changing data, total metadata, limits; versioning: URL (/v1) or header, avoid breaking changes, deprecation policy, documentation (OpenAPI)', 'For pagination, I''d use page and size parameters with a maximum size, and return metadata like the total. For large or constantly changing data, cursor-based pagination is better. For versioning, I prefer a version in the URL, like v1, because it''s simple and visible. The main goal is to avoid breaking changes: add fields instead of changing them, and when a breaking change is needed, publish a new version with a deprecation period, all documented with OpenAPI.', 'Para la paginación usaría parámetros de página y tamaño con un tamaño máximo, y devolvería metadatos como el total. Para datos muy grandes o que cambian constantemente, es mejor la paginación por cursor. Para el versionado prefiero la versión en la URL, como v1, porque es sencilla y visible. El objetivo principal es evitar cambios que rompan a los clientes: añadir campos en lugar de modificarlos y, cuando no haya más remedio, publicar una nueva versión con un periodo de retirada, todo documentado con OpenAPI.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-S1', 'BCK-03', 'Senior', 'mc', '¿Cómo evitas cobros duplicados si el cliente reintenta un POST de pago?', null, 'Con una clave de idempotencia enviada por el cliente y guardada en el servidor', array['Pidiendo al usuario que no pulse dos veces', 'Usando GET en vez de POST', 'Con un timeout más largo']::text[], 'Si llega la misma clave, se devuelve el resultado original sin repetir la operación.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-S2', 'BCK-03', 'Senior', 'mc', '¿Cuándo elegirías gRPC frente a REST?', null, 'Para comunicación interna entre servicios con alto rendimiento y contratos tipados', array['Para APIs públicas consumidas desde el navegador sin más', 'Nunca', 'Solo para archivos grandes']::text[], 'REST sigue siendo lo más cómodo para APIs públicas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-S3', 'BCK-03', 'Senior', 'mc', '¿Qué es el rate limiting y por qué aplicarlo?', null, 'Limitar las peticiones por cliente en un periodo para proteger el servicio de abusos y picos', array['Una forma de cobrar', 'Comprimir respuestas', 'Cachear respuestas']::text[], 'Se suele devolver 429 Too Many Requests.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-03-S4', 'BCK-03', 'Senior', 'open', '¿Cómo diseñarías una API pública que vayan a usar terceros?', 'How would you design a public API that third parties will use?', null, '{}'::text[], null, null, null, 'contract-first with OpenAPI; consistent naming and errors; authentication (OAuth2/API keys); rate limiting and quotas; versioning and deprecation policy; idempotency; pagination; documentation and SDKs; monitoring; security', 'I''d go contract-first: define the API in OpenAPI and review it before writing code. Consistent naming, errors in a standard format, and authentication with OAuth2 or API keys. Rate limiting and quotas per client, idempotency keys for critical operations, and pagination everywhere. A clear versioning and deprecation policy, because external clients can''t update quickly. And good documentation, plus monitoring of how each client uses it.', 'Diseñaría primero el contrato: definir la API en OpenAPI y revisarla antes de escribir código. Nombres coherentes, errores en un formato estándar y autenticación con OAuth2 o API keys. Límites de peticiones y cuotas por cliente, claves de idempotencia para las operaciones críticas y paginación en todas partes. Una política clara de versionado y de retirada, porque los clientes externos no pueden actualizarse rápido. Y buena documentación, además de monitorizar cómo la usa cada cliente.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-J1', 'BCK-04', 'Junior', 'mc', '¿Qué es una clave primaria?', null, 'Una columna (o varias) que identifica de forma única cada fila', array['Una contraseña de la base de datos', 'Un índice opcional', 'Una relación entre tablas']::text[], 'La clave foránea apunta a la primaria de otra tabla.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-J2', 'BCK-04', 'Junior', 'mc', '¿Qué hace un `JOIN` en SQL?', null, 'Combina filas de dos tablas relacionadas', array['Borra filas duplicadas', 'Crea una tabla nueva', 'Ordena resultados']::text[], 'INNER JOIN devuelve solo coincidencias; LEFT JOIN también las filas sin pareja de la izquierda.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-J3', 'BCK-04', 'Junior', 'fill', 'En Spring Data JPA, basta con extender ___ para tener findAll, save o deleteById.', null, 'JpaRepository', array['JpaEntity', 'CrudController', 'DataSource']::text[], 'Además puedes crear consultas por nombre de método, como findByEmail.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-J4', 'BCK-04', 'Junior', 'open', '¿Qué es un ORM y qué ventajas e inconvenientes tiene?', 'What is an ORM and what are its pros and cons?', null, '{}'::text[], null, null, null, 'maps objects to tables (JPA/Hibernate); pros: less boilerplate, portability, productivity; cons: hidden queries, N+1, performance issues, learning curve', 'An ORM, like Hibernate with JPA, maps Java objects to database tables, so you work with objects instead of writing all the SQL by hand. It saves a lot of boilerplate and speeds up development. The downside is that it hides the queries, so you can get performance problems like the N+1 problem if you don''t understand what it''s doing underneath.', 'Un ORM, como Hibernate con JPA, relaciona objetos Java con tablas de la base de datos, así que trabajas con objetos en lugar de escribir todo el SQL a mano. Ahorra mucho código repetitivo y acelera el desarrollo. El inconveniente es que oculta las consultas, y puedes tener problemas de rendimiento como el N+1 si no entiendes qué está haciendo por debajo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-M1', 'BCK-04', 'Mid', 'mc', '¿Qué es el problema N+1?', null, 'Hacer una consulta para una lista y luego una consulta extra por cada elemento al acceder a sus relaciones', array['Tener N+1 tablas', 'Un error de clave primaria', 'Una consulta con N+1 columnas']::text[], 'Soluciones: JOIN FETCH, @EntityGraph o consultas por lotes.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-M2', 'BCK-04', 'Mid', 'mc', '¿Para qué sirve un índice?', null, 'Para acelerar búsquedas y ordenaciones, a costa de más espacio y escrituras algo más lentas', array['Para cifrar datos', 'Para hacer backups', 'Para evitar duplicados siempre']::text[], 'Un índice único sí evita duplicados, pero no es su función general.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-M3', 'BCK-04', 'Mid', 'mc', '¿Qué es el bloqueo optimista en JPA?', null, 'Un campo @Version que detecta si otro proceso modificó el registro y hace fallar la actualización', array['Bloquear toda la tabla', 'Confiar en que no habrá conflictos sin comprobar nada', 'Un tipo de índice']::text[], 'Ideal cuando los conflictos son poco frecuentes.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-M4', 'BCK-04', 'Mid', 'open', 'Una consulta va muy lenta en producción. ¿Cómo la investigarías?', 'A query is very slow in production. How would you investigate it?', null, '{}'::text[], null, null, null, 'reproduce and get the actual SQL (logs, slow query log); EXPLAIN/EXPLAIN ANALYZE; missing indexes, full scans; N+1 from ORM; data volume; fix: indexes, rewrite query, pagination, projections; measure', 'First I''d get the exact SQL, from the slow query log or the application logs, and run EXPLAIN ANALYZE to see the execution plan. Usually the cause is a missing index, a full table scan, or the ORM generating too many queries. Depending on what I find, I''d add an index, rewrite the query, fetch only the columns I need, or add pagination. Then I''d measure again with production-like data.', 'Primero obtendría el SQL exacto, desde el log de consultas lentas o los logs de la aplicación, y ejecutaría EXPLAIN ANALYZE para ver el plan de ejecución. Normalmente la causa es un índice que falta, un recorrido completo de la tabla o el ORM generando demasiadas consultas. Según lo que encuentre, añadiría un índice, reescribiría la consulta, traería solo las columnas necesarias o añadiría paginación. Después volvería a medir con datos parecidos a los de producción.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-S1', 'BCK-04', 'Senior', 'mc', '¿Qué nivel de aislamiento evita las lecturas no repetibles pero no siempre los fantasmas (según el estándar SQL)?', null, 'Repeatable Read', array['Read Uncommitted', 'Read Committed', 'Serializable']::text[], 'Cada motor lo implementa a su manera: en PostgreSQL, Repeatable Read también evita fantasmas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-S2', 'BCK-04', 'Senior', 'mc', '¿Cómo harías migraciones de esquema sin parar el servicio?', null, 'Cambios compatibles hacia atrás en varias fases (expand and contract) con Flyway o Liquibase', array['Parar el servicio cada vez', 'Modificar las tablas a mano en producción', 'Borrar y recrear la base de datos']::text[], 'Ejemplo: añadir columna nueva, escribir en ambas, migrar datos, y solo después borrar la vieja.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-S3', 'BCK-04', 'Senior', 'mc', '¿Cuándo elegirías una base de datos NoSQL en lugar de relacional?', null, 'Con patrones de acceso conocidos, gran escala o datos poco estructurados, donde no necesitas joins ni transacciones complejas', array['Siempre, es más moderna', 'Nunca', 'Cuando hay muchas relaciones entre entidades']::text[], 'Para la mayoría de aplicaciones de negocio, una relacional es la opción por defecto.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-04-S4', 'BCK-04', 'Senior', 'open', '¿Cómo escalarías una base de datos que se ha convertido en el cuello de botella?', 'How would you scale a database that has become the bottleneck?', null, '{}'::text[], null, null, null, 'measure first; optimize queries and indexes; caching (Redis); read replicas for reads; connection pooling; vertical scaling; partitioning; sharding as last resort; CQRS; archive old data', 'First I''d measure to know whether the problem is reads, writes or a few bad queries, and optimize those queries and indexes, which is often enough. Then a cache like Redis for frequent reads, and read replicas to spread the read load. Connection pooling tuned properly, and a bigger instance if needed. Partitioning or archiving old data helps with large tables. Sharding I''d keep as a last resort, because it adds a lot of complexity.', 'Primero mediría para saber si el problema son las lecturas, las escrituras o unas pocas consultas malas, y optimizaría esas consultas e índices, que a menudo es suficiente. Después, una caché como Redis para las lecturas frecuentes y réplicas de lectura para repartir esa carga. Un pool de conexiones bien ajustado y una instancia más grande si hace falta. Particionar o archivar los datos antiguos ayuda con tablas muy grandes. El sharding lo dejaría como último recurso, porque añade mucha complejidad.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-J1', 'BCK-05', 'Junior', 'mc', '¿Qué es una arquitectura en capas típica en un backend?', null, 'Controlador → servicio (lógica de negocio) → repositorio (acceso a datos)', array['Todo en el controlador', 'Base de datos → controlador → vista', 'Un solo archivo por aplicación']::text[], 'Cada capa tiene una responsabilidad y solo habla con la siguiente.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-J2', 'BCK-05', 'Junior', 'mc', '¿Qué es un microservicio?', null, 'Un servicio pequeño e independiente que se despliega por separado y se encarga de una parte del negocio', array['Una función de Java muy corta', 'Un servidor muy pequeño', 'Un tipo de base de datos']::text[], 'Cada uno suele tener su propia base de datos.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-J3', 'BCK-05', 'Junior', 'fill', 'El principio SOLID que dice que una clase debe tener una sola razón para cambiar es el de responsabilidad ___.', null, 'única', array['abierta', 'sustituible', 'invertida']::text[], 'Single Responsibility Principle.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-J4', 'BCK-05', 'Junior', 'open', '¿Qué diferencias hay entre un monolito y microservicios?', 'What are the differences between a monolith and microservices?', null, '{}'::text[], null, null, null, 'monolith: single deployable, simpler, easier transactions; microservices: independent deployment and scaling, team autonomy, but distributed complexity (network, consistency, observability)', 'A monolith is one application deployed as a single unit, which is simpler to develop, test and deploy at the beginning. Microservices split the application into independent services that can be deployed and scaled separately, which gives teams more autonomy. But they add the complexity of a distributed system: network failures, data consistency and much harder debugging.', 'Un monolito es una aplicación que se despliega como una sola unidad, lo que al principio es más sencillo de desarrollar, probar y desplegar. Los microservicios dividen la aplicación en servicios independientes que se despliegan y escalan por separado, lo que da más autonomía a los equipos. Pero añaden la complejidad de un sistema distribuido: fallos de red, consistencia de los datos y una depuración mucho más difícil.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-M1', 'BCK-05', 'Mid', 'mc', '¿Para qué sirve un circuit breaker (p. ej. Resilience4j)?', null, 'Para dejar de llamar temporalmente a un servicio que falla y evitar fallos en cascada', array['Para cifrar comunicaciones', 'Para balancear carga', 'Para guardar logs']::text[], 'Tras un tiempo deja pasar algunas llamadas de prueba para ver si se recuperó.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-M2', 'BCK-05', 'Mid', 'mc', '¿Qué ventaja tiene la comunicación asíncrona con colas o eventos (Kafka, RabbitMQ, SQS)?', null, 'Desacopla servicios y absorbe picos: el emisor no depende de que el receptor esté disponible en ese momento', array['Es siempre más rápida', 'Garantiza el orden sin configuración', 'Elimina la necesidad de bases de datos']::text[], 'A cambio, la consistencia es eventual y hay que gestionar reintentos y duplicados.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-M3', 'BCK-05', 'Mid', 'mc', '¿Qué es un API Gateway?', null, 'Un punto de entrada único que enruta peticiones a los servicios y aplica autenticación, límites o logs', array['Una base de datos', 'Un framework de tests', 'Un servidor de correo']::text[], 'Evita que los clientes conozcan la topología interna.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-M4', 'BCK-05', 'Mid', 'open', '¿Cómo gestionarías una operación que afecta a varios microservicios, como un pedido con pago y stock?', 'How would you handle an operation that spans several microservices, like an order with payment and stock?', null, '{}'::text[], null, null, null, 'no distributed transactions; saga pattern (choreography with events or orchestration); compensating actions; idempotent consumers; outbox pattern for reliable events; eventual consistency; monitoring', 'I''d avoid distributed transactions and use the saga pattern. The order service creates the order as pending and publishes an event; the payment and stock services react, and if one step fails, the others run compensating actions, like refunding the payment. To publish events reliably I''d use the outbox pattern, and make every consumer idempotent, because messages can arrive twice. The result is eventually consistent, so the UI must show intermediate states.', 'Evitaría las transacciones distribuidas y usaría el patrón saga. El servicio de pedidos crea el pedido como pendiente y publica un evento; los servicios de pago y de stock reaccionan y, si un paso falla, los demás ejecutan acciones de compensación, como devolver el pago. Para publicar los eventos de forma fiable usaría el patrón outbox, y haría idempotentes a todos los consumidores, porque un mensaje puede llegar dos veces. El resultado es consistente a la larga, así que la interfaz debe mostrar los estados intermedios.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-S1', 'BCK-05', 'Senior', 'mc', '¿Qué es el patrón Outbox?', null, 'Guardar el evento en una tabla dentro de la misma transacción que el cambio de negocio y publicarlo después de forma fiable', array['Enviar correos a la bandeja de salida', 'Un tipo de caché', 'Un balanceador']::text[], 'Evita el problema de guardar en base de datos pero no publicar el evento (o al revés).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-S2', 'BCK-05', 'Senior', 'mc', '¿Qué aporta Domain-Driven Design a la hora de dividir microservicios?', null, 'Usar bounded contexts del negocio para definir límites con sentido y un lenguaje común', array['Dividir por tablas de la base de datos', 'Un microservicio por clase', 'Dividir por capas técnicas']::text[], 'Dividir mal genera servicios muy acoplados: un ''monolito distribuido''.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-S3', 'BCK-05', 'Senior', 'mc', '¿Qué es CQRS?', null, 'Separar el modelo de escritura (comandos) del de lectura (consultas), que pueden optimizarse por separado', array['Un protocolo de red', 'Un tipo de cifrado', 'Un framework de Spring']::text[], 'Útil con lecturas muy distintas a las escrituras; añade complejidad si no hace falta.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-05-S4', 'BCK-05', 'Senior', 'open', '¿Partirías un monolito en microservicios? ¿Cómo lo harías?', 'Would you split a monolith into microservices? How would you do it?', null, '{}'::text[], null, null, null, 'only if there''s a real reason (scaling teams, deployment pain, scaling parts); modular monolith first; identify bounded contexts; strangler fig pattern extracting one piece at a time; data ownership; observability and CI/CD first; measure', 'Only if there''s a real problem to solve, like teams blocking each other or one part needing to scale differently. Often a well-structured modular monolith is enough. If we do it, I''d first identify the bounded contexts, then use the strangler fig pattern: extract one service at a time, starting with a well-isolated area, routing traffic to it gradually. Each service owns its data. And before starting, I''d make sure we have good CI/CD and observability, because otherwise distributed systems become very hard to operate.', 'Solo si hay un problema real que resolver, como equipos que se bloquean entre sí o una parte que necesita escalar de forma distinta. Muchas veces basta con un monolito modular bien estructurado. Si se hace, primero identificaría los bounded contexts y después aplicaría el patrón strangler fig: extraer un servicio cada vez, empezando por una zona bien aislada y desviando el tráfico poco a poco. Cada servicio es dueño de sus datos. Y antes de empezar me aseguraría de tener buen CI/CD y observabilidad, porque sin eso los sistemas distribuidos se vuelven muy difíciles de operar.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-J1', 'BCK-06', 'Junior', 'mc', '¿Qué librería se usa para tests unitarios en Java?', null, 'JUnit (normalmente con Mockito para los dobles)', array['Selenium', 'Postman', 'Maven']::text[], 'Spring Boot incluye spring-boot-starter-test con JUnit 5, Mockito y AssertJ.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-J2', 'BCK-06', 'Junior', 'mc', '¿Qué es la inyección SQL?', null, 'Un ataque que mete código SQL a través de datos de entrada mal tratados', array['Una forma de optimizar consultas', 'Un tipo de JOIN', 'Una migración']::text[], 'Se evita con consultas parametrizadas (JPA y JdbcTemplate lo hacen).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-J3', 'BCK-06', 'Junior', 'fill', 'Para crear un doble de una dependencia en Mockito se usa la anotación ___.', null, '@Mock', array['@Spy', '@Test', '@Bean']::text[], '@InjectMocks crea la clase a probar con los mocks inyectados.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-J4', 'BCK-06', 'Junior', 'open', '¿Cómo guardarías las contraseñas de los usuarios?', 'How would you store users'' passwords?', null, '{}'::text[], null, null, null, 'never plain text or reversible encryption; slow adaptive hashing with salt (bcrypt, Argon2); Spring Security PasswordEncoder; never log them', 'Never in plain text, and not with reversible encryption either. I''d hash them with a slow algorithm designed for passwords, like bcrypt or Argon2, which includes a random salt. In Spring this is easy with the PasswordEncoder from Spring Security. And I''d make sure passwords are never written to the logs.', 'Nunca en texto plano, ni con un cifrado reversible. Las guardaría con un algoritmo de hash lento pensado para contraseñas, como bcrypt o Argon2, que incluye una sal aleatoria. En Spring es sencillo con el PasswordEncoder de Spring Security. Y me aseguraría de que las contraseñas nunca se escriben en los logs.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-M1', 'BCK-06', 'Mid', 'mc', '¿Para qué sirve `@WebMvcTest`?', null, 'Para testear solo la capa web (controladores) con MockMvc, sin levantar todo el contexto', array['Para tests E2E con navegador', 'Para testear la base de datos', 'Para tests de carga']::text[], '@DataJpaTest hace lo mismo para la capa de repositorios.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-M2', 'BCK-06', 'Mid', 'mc', '¿Qué aportan los Testcontainers?', null, 'Levantar dependencias reales (PostgreSQL, Kafka…) en Docker durante los tests de integración', array['Tests más rápidos que los unitarios', 'Sustituyen a JUnit', 'Son mocks de bases de datos']::text[], 'Más realista que una base de datos en memoria como H2.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-M3', 'BCK-06', 'Mid', 'mc', '¿Qué contiene un JWT y qué NO debe contener?', null, 'Claims firmados (usuario, roles, expiración); no debe llevar datos sensibles porque el payload solo está codificado, no cifrado', array['Contraseñas cifradas', 'La clave privada', 'Nada, es aleatorio']::text[], 'Cualquiera puede decodificarlo; la firma solo garantiza que no se ha modificado.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-M4', 'BCK-06', 'Mid', 'open', '¿Cómo protegerías una API REST con Spring Security?', 'How would you secure a REST API with Spring Security?', null, '{}'::text[], null, null, null, 'authentication with OAuth2/JWT (resource server); stateless; authorization by roles/scopes at endpoint and method level; HTTPS; CORS config; input validation; rate limiting; security headers; no sensitive data in errors', 'I''d configure the API as an OAuth2 resource server that validates JWT tokens from an identity provider, stateless, without sessions. Authorization by roles or scopes, at endpoint level and with method security for finer rules. HTTPS everywhere, a strict CORS configuration, input validation, and rate limiting. And error responses that don''t leak internal details.', 'Configuraría la API como un resource server de OAuth2 que valida tokens JWT de un proveedor de identidad, sin estado y sin sesiones. Autorización por roles o scopes, a nivel de endpoint y con seguridad en métodos para las reglas más finas. HTTPS en todo, una configuración de CORS estricta, validación de las entradas y límite de peticiones. Y respuestas de error que no revelen detalles internos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-S1', 'BCK-06', 'Senior', 'mc', '¿Qué son los contract tests (p. ej. Pact, Spring Cloud Contract)?', null, 'Tests que verifican que proveedor y consumidor de una API cumplen el contrato acordado, sin levantar todo el sistema', array['Tests legales', 'Tests de carga', 'Tests manuales']::text[], 'Detectan cambios que rompen a otros servicios antes del despliegue.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-S2', 'BCK-06', 'Senior', 'mc', '¿Qué es el OWASP Top 10?', null, 'Una lista de los riesgos de seguridad más críticos en aplicaciones web', array['Un ranking de frameworks', 'Una certificación de Java', 'Un tipo de firewall']::text[], 'Incluye control de acceso roto, inyección, fallos criptográficos…', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-S3', 'BCK-06', 'Senior', 'mc', '¿Qué estrategia usarías para detectar dependencias vulnerables?', null, 'Escaneo automático en el pipeline (Dependabot, OWASP Dependency-Check, Snyk) y actualizaciones regulares', array['Revisarlas a mano una vez al año', 'No usar dependencias', 'Confiar en que Maven lo hace solo']::text[], 'La mayoría del código de una app son dependencias de terceros.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('BCK-06-S4', 'BCK-06', 'Senior', 'open', '¿Cómo integrarías la seguridad en el ciclo de desarrollo de un equipo backend?', 'How would you integrate security into a backend team''s development cycle?', null, '{}'::text[], null, null, null, 'shift-left: threat modeling for new features; secure coding guidelines; SAST and dependency scanning in CI; secrets scanning; DAST in staging; code review checklist; least privilege; security training; incident response; pentests', 'I''d shift security left. For new features, a quick threat modeling session. In the pipeline: static analysis, dependency and secret scanning, and dynamic tests against staging. Security items in the code review checklist, least privilege for every service and database user, and regular training for the team. Plus periodic penetration tests and a clear plan for responding to incidents.', 'Llevaría la seguridad al principio del proceso. Para cada funcionalidad nueva, una sesión rápida de análisis de amenazas. En el pipeline: análisis estático, revisión de dependencias y de secretos, y pruebas dinámicas contra preproducción. Puntos de seguridad en la checklist de code review, mínimo privilegio para cada servicio y usuario de base de datos, y formación periódica para el equipo. Además, tests de penetración periódicos y un plan claro de respuesta ante incidentes.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-J1', 'COM-01', 'Junior', 'mc', '¿Qué significa STAR?', null, 'Situation, Task, Action, Result (Situación, Tarea, Acción, Resultado)', array['Skills, Tools, Achievements, Results', 'Situation, Team, Approach, Review', 'Story, Task, Action, Reflection']::text[], 'Es la estructura que esperan en las preguntas de comportamiento: "Tell me about a time when…".', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-J2', 'COM-01', 'Junior', 'order', 'Ordena esta respuesta STAR', null, 'En las prácticas, el formulario de registro tenía muchos abandonos. | Me pidieron averiguar por qué y proponer una mejora. | Analicé los errores de validación y simplifiqué el formulario de 9 a 5 campos. | Los registros completados subieron un 30% el mes siguiente.', '{}'::text[], 'Situación → Tarea → Acción → Resultado. Cierra siempre con un resultado medible.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-J3', 'COM-01', 'Junior', 'mc', '¿Cuál es la mejor estructura para "Tell me about yourself"?', null, 'Presente → pasado → futuro', array['Infancia → estudios → aficiones', 'Todo el CV, trabajo por trabajo', 'Fortalezas → debilidades → salario']::text[], 'Quién eres hoy, cómo llegaste y por qué este puesto encaja. Entre 60 y 90 segundos.', 'I''m a junior developer who recently finished my training in web development. During my internship I worked on a real product with a team, which taught me a lot about code reviews and teamwork. Now I''m looking for a team where I can keep learning and start contributing from the first weeks.', 'Soy desarrollador junior y acabo de terminar mi formación en desarrollo web. En las prácticas trabajé en un producto real con un equipo, lo que me enseñó mucho sobre code reviews y trabajo en equipo. Ahora busco un equipo donde seguir aprendiendo y empezar a aportar desde las primeras semanas.', null, null, null, 'pending', true, '¿Cuál es la mejor estructura para responder a «Háblame de ti»?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-J4', 'COM-01', 'Junior', 'open', 'Háblame de ti.', 'Tell me about yourself.', null, '{}'::text[], null, null, null, 'current situation and training; relevant projects or internship; skills; motivation; why this role; 60-90 seconds', 'I''m a web developer who recently finished my training, focused on frontend. During my internship I worked on a real application with a small team, building forms and connecting them to an API, and I learned a lot about working with Git and code reviews. In my free time I''ve built a couple of personal projects to practise. Now I''m looking for my first full-time role in a team where I can keep growing, and this position fits exactly what I want to do.', 'Soy desarrollador web y acabo de terminar mi formación, centrada en frontend. En las prácticas trabajé en una aplicación real con un equipo pequeño, creando formularios y conectándolos a una API, y aprendí mucho sobre trabajar con Git y las code reviews. En mi tiempo libre he hecho un par de proyectos personales para practicar. Ahora busco mi primer trabajo a tiempo completo en un equipo donde seguir creciendo, y este puesto encaja justo con lo que quiero hacer.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-M1', 'COM-01', 'Mid', 'mc', '¿Qué respuesta a "What''s your greatest weakness?" funciona mejor?', null, 'I sometimes go too deep into details, so now I timebox research and check in with the team earlier.', array['I''m a perfectionist and I work too hard.', 'I don''t really have weaknesses.', 'I''m not very good at working in teams.']::text[], 'Una debilidad real pero no crítica para el puesto, más lo que haces para mejorarla.', 'Sometimes I go too deep into details before asking for help. Now I timebox my research, and if I''m stuck after an hour or so, I check in with the team. It''s made me much faster.', 'A veces profundizo demasiado en los detalles antes de pedir ayuda. Ahora me pongo un límite de tiempo y, si sigo atascado tras una hora, lo comento con el equipo. Me ha hecho mucho más rápido.', null, null, null, 'pending', true, 'Te preguntan «¿Cuál es tu mayor debilidad?». ¿Qué respuesta funciona mejor?', 'A veces profundizo demasiado en los detalles, así que ahora me pongo un límite de tiempo y consulto antes con el equipo.', array['Soy perfeccionista y trabajo demasiado.', 'La verdad es que no tengo debilidades.', 'No se me da muy bien trabajar en equipo.']::text[], null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-M2', 'COM-01', 'Mid', 'mc', 'Te preguntan por un conflicto con un compañero. ¿Qué enfoque es mejor?', null, 'Contar un desacuerdo real, cómo lo hablasteis con datos y cómo se resolvió, sin culpar a nadie', array['Decir que nunca has tenido conflictos', 'Explicar por qué el compañero estaba equivocado', 'Cambiar de tema']::text[], 'Buscan madurez: escuchar, argumentar con datos y priorizar el objetivo del equipo.', 'In a project, a colleague and I disagreed about how to structure the state. Instead of arguing, we each wrote down pros and cons and built a quick proof of concept. We went with his approach, with one idea from mine, and it worked well. Since then we''ve worked really well together.', 'En un proyecto, un compañero y yo no estábamos de acuerdo en cómo estructurar el estado. En vez de discutir, apuntamos pros y contras y montamos una prueba de concepto rápida. Elegimos su enfoque con una idea del mío y funcionó bien. Desde entonces trabajamos muy bien juntos.', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-M3', 'COM-01', 'Mid', 'fill', 'En una respuesta STAR, habla de lo que hiciste ___, no solo de lo que hizo el equipo.', null, 'tú', array['el jefe', 'el cliente', 'la empresa']::text[], 'Di "I" más que "we": quieren saber cuál fue tu aportación.', null, null, null, null, null, 'pending', true, null, null, null, 'Habla en primera persona («yo propuse», «yo implementé») más que en plural: quieren saber cuál fue tu aportación.') on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-M4', 'COM-01', 'Mid', 'open', 'Cuéntame una situación en la que cometiste un error en el trabajo y cómo lo gestionaste.', 'Tell me about a time you made a mistake at work and how you handled it.', null, '{}'::text[], null, null, null, 'STAR; real but not catastrophic mistake; take ownership; how it was fixed quickly; communication; lesson learned and process change', 'In one release I deployed a change without testing it on a small screen, and the checkout button was hidden on some mobile phones. As soon as support reported it, I told my lead, reverted the change and fixed it within an hour. Afterwards I added mobile viewports to our visual tests, so it couldn''t happen again. I learned to own mistakes quickly and to fix the process, not just the bug.', 'En una release desplegué un cambio sin probarlo en pantallas pequeñas, y el botón de pago quedaba oculto en algunos móviles. En cuanto soporte lo avisó, se lo dije a mi responsable, revertí el cambio y lo arreglé en menos de una hora. Después añadí tamaños de móvil a nuestros tests visuales para que no pudiera repetirse. Aprendí a asumir los errores rápido y a arreglar el proceso, no solo el fallo.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-S1', 'COM-01', 'Senior', 'mc', 'Te preguntan cómo has ayudado a crecer a otras personas. ¿Qué incluyes?', null, 'Un ejemplo concreto de mentoring con acciones (pair programming, feedback, delegar retos) y su resultado', array['Que siempre ayudas cuando te preguntan', 'Que el crecimiento es responsabilidad de cada uno', 'Una lista de cursos que recomiendas']::text[], 'En perfiles senior buscan impacto en el equipo, no solo en el código.', 'I mentored a junior developer who was struggling with RxJS. We did pair programming twice a week, I gave her small but real tasks, and I reviewed her pull requests with explanations, not just corrections. After three months she was leading a feature on her own.', 'Fui mentor de una desarrolladora junior a la que le costaba RxJS. Hacíamos pair programming dos veces por semana, le daba tareas pequeñas pero reales y revisaba sus pull requests explicando, no solo corrigiendo. A los tres meses lideraba ella sola una funcionalidad.', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-S2', 'COM-01', 'Senior', 'mc', '¿Cómo respondes a "Tell me about a technical decision you regret"?', null, 'Con una decisión real, por qué tenía sentido entonces, qué aprendiste y qué harías distinto', array['Diciendo que nunca te arrepientes de nada', 'Culpando al equipo de producto', 'Con un error trivial sin consecuencias']::text[], 'Demuestra criterio y capacidad de aprender, que es lo que se espera de un senior.', 'We added a global state library very early in a project, when the app was still small. It slowed the team down with a lot of boilerplate. Now I start with the simplest option and only add complexity when there''s a clear need.', 'Añadimos una librería de estado global muy pronto en un proyecto, cuando la app aún era pequeña. Ralentizó al equipo con mucho código repetitivo. Ahora empiezo por la opción más sencilla y solo añado complejidad cuando hay una necesidad clara.', null, null, null, 'pending', true, '¿Cómo respondes a «Cuéntame una decisión técnica de la que te arrepientas»?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-S3', 'COM-01', 'Senior', 'fill', 'Para un senior, una buena respuesta STAR muestra el impacto en el ___, no solo en el código.', null, 'negocio', array['framework', 'IDE', 'linter']::text[], 'Habla de usuarios, costes, tiempos de entrega o ventas cuando puedas.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-01-S4', 'COM-01', 'Senior', 'open', 'Cuéntame un proyecto del que estés especialmente orgulloso.', 'Tell me about a project you''re particularly proud of.', null, '{}'::text[], null, null, null, 'context and business goal; own role and leadership; technical decisions and trade-offs; challenges; measurable impact; what they learned; team', 'I''m especially proud of a migration I led for a banking client. The app was slow and hard to change, and the business wanted to release features faster. I proposed migrating it gradually instead of rewriting it, defined the target architecture with the team and set up the pipeline and tests. In six months we cut load time by half and went from monthly releases to weekly ones, without stopping feature work.', 'Estoy especialmente orgulloso de una migración que lideré para un cliente bancario. La aplicación era lenta y difícil de cambiar, y el negocio quería sacar funcionalidades más rápido. Propuse migrarla poco a poco en lugar de reescribirla, definí con el equipo la arquitectura objetivo y monté el pipeline y los tests. En seis meses redujimos el tiempo de carga a la mitad y pasamos de releases mensuales a semanales, sin parar el desarrollo de funcionalidades.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-J1', 'COM-02', 'Junior', 'mc', '"Why should we hire you?" (¿por qué deberíamos contratarte?) ¿Qué enfoque es mejor?', null, 'Unir dos o tres cosas concretas tuyas con lo que pide la oferta, y tu ganas de aprender', array['Decir que necesitas el trabajo', 'Decir que eres el mejor candidato sin más', 'Hablar de lo que no te gusta de tu trabajo actual']::text[], 'Relaciona tus fortalezas con las necesidades del puesto.', 'You''re looking for someone who knows Angular and can learn fast. I''ve built two projects with Angular and TypeScript, I''m used to working with Git in a team from my internship, and I''m someone who asks questions and learns quickly.', 'Buscáis a alguien que conozca Angular y aprenda rápido. He hecho dos proyectos con Angular y TypeScript, estoy acostumbrado a trabajar con Git en equipo desde las prácticas y soy alguien que pregunta y aprende rápido.', null, null, null, 'pending', true, '«¿Por qué deberíamos contratarte?» ¿Qué enfoque es mejor?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-J2', 'COM-02', 'Junior', 'mc', 'Te preguntan algo técnico que no sabes. ¿Qué haces?', null, 'Reconocerlo con naturalidad, explicar cómo lo averiguarías o razonar en voz alta lo que sí sabes', array['Inventarte la respuesta', 'Quedarte en silencio', 'Decir que no es importante']::text[], 'Inventar se nota y resta mucho; razonar suma.', 'I haven''t worked with that directly, but I''d guess it works similarly to X. In a real situation, I''d check the official documentation and try a small example.', 'No he trabajado con eso directamente, pero imagino que funciona de forma parecida a X. En una situación real, miraría la documentación oficial y probaría con un ejemplo pequeño.', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-J3', 'COM-02', 'Junior', 'mc', '¿Qué buena pregunta puedes hacer tú al final?', null, 'What does a typical day look like for someone in this role?', array['How many vacation days do I get?', 'So, what does your company do?', 'No, I don''t have any questions.']::text[], 'Demuestra interés real y te da información para decidir.', 'What does a typical day look like for someone in this role? And how do new people get support during their first months?', '¿Cómo es un día normal en este puesto? ¿Y cómo apoyáis a las personas nuevas durante los primeros meses?', null, null, null, 'pending', true, null, '¿Cómo es un día normal para alguien en este puesto?', array['¿Cuántos días de vacaciones tendría?', 'Entonces, ¿a qué se dedica vuestra empresa?', 'No, no tengo ninguna pregunta.']::text[], null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-J4', 'COM-02', 'Junior', 'open', '¿Dónde te ves dentro de cinco años?', 'Where do you see yourself in five years?', null, '{}'::text[], null, null, null, 'realistic growth path; mastering the role first; more responsibility (mid/senior, mentoring); link to the company; ambition without seeming to leave soon', 'In five years I''d like to be a solid mid or senior developer, someone the team can trust with complex features. First I want to master the basics in a real product, and then take on more responsibility, like making technical decisions and helping new colleagues. I''d love to do that growth here, in a company where I can learn from experienced people.', 'Dentro de cinco años me gustaría ser un desarrollador mid o senior sólido, alguien en quien el equipo pueda confiar para funcionalidades complejas. Primero quiero dominar lo básico en un producto real y después asumir más responsabilidad, como tomar decisiones técnicas y ayudar a los compañeros nuevos. Me encantaría hacer ese camino aquí, en una empresa donde pueda aprender de gente con experiencia.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-M1', 'COM-02', 'Mid', 'mc', '"I see a gap in your recent experience." (veo un hueco en tu experiencia reciente) ¿Cómo lo enfocas?', null, 'Breve y sincero, y luego centrarte en lo que hiciste para seguir en forma y por qué estás listo ahora', array['Cambiar de tema rápido', 'Explicar con detalle todo lo que salió mal', 'Echar la culpa a tu anterior empresa']::text[], 'Una frase de contexto, sin dramas, y enseguida a lo positivo.', 'Yes, my last project had very little development work, so I decided to use that time to retrain. I''ve been learning new technologies and catching up with the latest versions of my stack. Now I''m really keen to get back into a team and build things.', 'Sí, mi último proyecto tenía muy poco desarrollo, así que decidí aprovechar ese tiempo para formarme. He estado aprendiendo tecnologías nuevas y poniéndome al día con las últimas versiones de mi stack. Ahora tengo muchas ganas de volver a un equipo y construir cosas.', null, null, null, 'pending', true, '«Veo un hueco en tu experiencia reciente.» ¿Cómo lo enfocas?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-M2', 'COM-02', 'Mid', 'mc', '"Why did you leave your last job?" (¿por qué dejaste tu último trabajo?) ¿Qué respondes?', null, 'I wanted more hands-on coding and growth, and that wasn''t possible on that project.', array['My manager was terrible.', 'Honestly, I just needed any job.', 'I got bored.']::text[], 'Nunca hables mal de una empresa anterior. Enmárcalo en lo que buscas, no en lo que huyes.', 'I was on a project where I wasn''t getting much hands-on development, and I want to keep growing as a developer. So I''m looking for a team where I can build features every day and learn from good engineers.', 'Estaba en un proyecto donde apenas hacía desarrollo, y quiero seguir creciendo como desarrollador. Por eso busco un equipo donde pueda construir funcionalidades cada día y aprender de buenos ingenieros.', null, null, null, 'pending', true, '«¿Por qué dejaste tu último trabajo?» ¿Qué respondes?', 'Quería programar más y seguir creciendo, y en ese proyecto no era posible.', array['Mi jefe era horrible.', 'Sinceramente, necesitaba cualquier trabajo.', 'Me aburría.']::text[], null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-M3', 'COM-02', 'Mid', 'mc', '"What are your salary expectations?" (¿qué expectativas salariales tienes?) ¿Cómo lo enfocas?', null, 'Dar un rango investigado para el puesto y la ciudad, y mostrar algo de flexibilidad', array['Decir "lo que os parezca justo"', 'Negarte a responder', 'Decir una cifra muy por encima del mercado']::text[], 'Un rango investigado te protege de pedir poco y no cierra la puerta.', 'Based on what I''ve seen for similar roles, I''m looking for something between X and Y a year. But I''m flexible, it depends on the whole package and the remote options.', 'Por lo que he visto en puestos similares, busco algo entre X e Y al año. Pero soy flexible: depende del paquete completo y de las opciones de teletrabajo. (Sustituye X e Y por tu rango real.)', null, null, null, 'pending', true, '«¿Qué expectativas salariales tienes?» ¿Cómo lo enfocas?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-M4', 'COM-02', 'Mid', 'open', '¿Por qué quieres trabajar aquí?', 'Why do you want to work here?', null, '{}'::text[], null, null, null, 'specific things about the company (product, stack, clients, culture); link to own experience; what they would contribute; avoid generic praise', 'I''ve been reading about your projects, and what caught my attention is that you build large applications for clients in sectors I already know. That''s where I have the most experience, so I think I can contribute from day one. I also like that you work with a modern stack, which is the direction I''ve been studying. And I''m looking for a team that cares about code quality, which is what I''ve heard about you.', 'He estado leyendo sobre vuestros proyectos y me ha llamado la atención que desarrolláis aplicaciones grandes para clientes de sectores que ya conozco. Ahí es donde tengo más experiencia, así que creo que puedo aportar desde el primer día. También me gusta que trabajéis con un stack moderno, que es justo hacia donde he estado formándome. Y busco un equipo al que le importe la calidad del código, que es lo que he oído de vosotros.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-S1', 'COM-02', 'Senior', 'mc', 'Tienes otra oferta y te preguntan si estás en otros procesos. ¿Qué haces?', null, 'Ser sincero sin dar detalles innecesarios, y dejar claro por qué te interesa especialmente este puesto', array['Mentir y decir que no', 'Usarlo para presionar de forma agresiva', 'Negarte a responder']::text[], 'La transparencia genera confianza y puede acelerar el proceso.', 'Yes, I''m in a couple of other processes, one of them at an advanced stage. But this role is my first choice because of the product and the team, so I''d be happy to move forward quickly if it works for you.', 'Sí, estoy en un par de procesos más, uno de ellos bastante avanzado. Pero este puesto es mi primera opción por el producto y el equipo, así que me encantaría avanzar rápido si os encaja.', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-S2', 'COM-02', 'Senior', 'mc', '"How do you handle disagreement with your manager about a technical decision?" ¿Qué enfoque es mejor?', null, 'Plantear tu postura con datos y riesgos, escuchar sus motivos y, si se decide lo contrario, comprometerte con la decisión', array['Hacer lo que tú crees sin decir nada', 'Escalar directamente a su jefe', 'Aceptar siempre sin opinar']::text[], 'Es el principio de "disagree and commit".', 'I''d explain my concerns with data, for example the risks or the cost of each option, and listen to the reasons behind the decision. If we still go another way, I commit to it fully, and we agree on a point to review whether it''s working.', 'Explicaría mis dudas con datos, por ejemplo los riesgos o el coste de cada opción, y escucharía los motivos de la decisión. Si aun así se elige otro camino, me comprometo del todo y acordamos un momento para revisar si está funcionando.', null, null, null, 'pending', true, '«¿Cómo gestionas un desacuerdo con tu responsable sobre una decisión técnica?» ¿Qué enfoque es mejor?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-S3', 'COM-02', 'Senior', 'mc', '"Why are you looking for a change after so many years?" ¿Qué respuesta funciona mejor?', null, 'Hablar de lo que buscas ahora (impacto, retos, liderazgo) y por qué este puesto lo ofrece', array['Decir que estás quemado', 'Quejarte de tu empresa actual', 'Decir que es solo por dinero']::text[], 'Enfoque positivo y orientado al futuro.', 'I''ve learned a lot in my current company, but I feel I''ve reached a point where I want a bigger impact, for example shaping the architecture of a product from the start. This role offers exactly that.', 'He aprendido mucho en mi empresa actual, pero siento que he llegado a un punto en el que quiero más impacto, por ejemplo definir la arquitectura de un producto desde el principio. Este puesto me ofrece justo eso.', null, null, null, 'pending', true, '«¿Por qué buscas un cambio después de tantos años?» ¿Qué respuesta funciona mejor?', null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-02-S4', 'COM-02', 'Senior', 'open', '¿Cuál dirías que es tu estilo de liderazgo técnico?', 'How would you describe your technical leadership style?', null, '{}'::text[], null, null, null, 'lead by example and context; explain the why; involve the team in decisions; delegate with support; code reviews as teaching; protect focus; balance quality and delivery; concrete example', 'I''d say I lead by giving context rather than orders: I explain why we make a decision and involve the team, especially the people who will build it. I delegate challenging work with support, and I use code reviews to teach, not just to approve. I try to balance quality with delivering on time. For example, in my last project I set up architecture discussions every two weeks, and the team started proposing improvements on their own.', 'Diría que lidero dando contexto más que órdenes: explico por qué tomamos una decisión e implico al equipo, sobre todo a quienes la van a construir. Delego trabajo con retos, pero con apoyo, y uso las code reviews para enseñar, no solo para aprobar. Intento equilibrar la calidad con entregar a tiempo. Por ejemplo, en mi último proyecto organicé conversaciones de arquitectura cada dos semanas y el equipo empezó a proponer mejoras por su cuenta.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-J1', 'COM-03', 'Junior', 'mc', '"Actualmente trabajo con Angular" →', null, 'I''m currently working with Angular.', array['Actually I work with Angular.', 'Actually I''m working in Angular.', 'In the actual moment I work with Angular.']::text[], 'Actually = en realidad. Actualmente = currently / at the moment.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-J2', 'COM-03', 'Junior', 'fill', 'I''ve been working with Angular ___ 2019.', null, 'since', array['for', 'from', 'during']::text[], 'Since + punto de inicio (since 2019). For + duración (for five years).', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-J3', 'COM-03', 'Junior', 'mc', 'No has entendido la pregunta. Dices:', null, 'Sorry, could you rephrase that, please?', array['What?', 'Repeat.', 'I no understand.']::text[], 'Pedir que lo reformulen es normal y profesional.', 'Sorry, could you rephrase that, please? Just to make sure: do you mean how I would build it, or how I would test it?', 'Perdona, ¿podrías reformularlo? Solo para asegurarme: ¿te refieres a cómo lo construiría o a cómo lo testearía?', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-J4', 'COM-03', 'Junior', 'open', 'Describe el último proyecto en el que trabajaste.', 'Describe the last project you worked on.', null, '{}'::text[], null, null, null, 'what the project was and for whom; team; your role and tasks; technologies; one challenge; past tenses used correctly', 'My last project was a web application for a bank''s internal team. We were five developers, and I was responsible for the frontend of the reporting module. I built the screens with Angular, connected them to a REST API, and wrote unit tests. The biggest challenge was showing large tables quickly, which I solved with pagination and virtual scrolling.', 'Mi último proyecto fue una aplicación web para un equipo interno de un banco. Éramos cinco desarrolladores y yo me encargaba del frontend del módulo de informes. Construí las pantallas con Angular, las conecté a una API REST y escribí tests unitarios. El mayor reto fue mostrar tablas grandes con rapidez, y lo resolví con paginación y virtual scroll.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-M1', 'COM-03', 'Mid', 'mc', '"Asistí a la reunión de planificación" →', null, 'I attended the planning meeting.', array['I assisted the planning meeting.', 'I assisted to the planning meeting.', 'I went in the planning meeting.']::text[], 'Attend = asistir (estar presente). Assist = ayudar.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-M2', 'COM-03', 'Mid', 'mc', '"Me encargaba del módulo de pagos" →', null, 'I was in charge of the payments module.', array['I was charged of the payments module.', 'I encharged the payments module.', 'I was encharged of the payments module.']::text[], 'In charge of / responsible for. "Charge" a secas es cobrar o cargar.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-M3', 'COM-03', 'Mid', 'mc', 'Necesitas unos segundos para pensar. ¿Qué frase es la mejor?', null, 'That''s a good question. Let me think about it for a second.', array['Eh… eh… wait.', 'I don''t know.', 'Next question, please.']::text[], 'Pensar en voz alta está bien visto en entrevistas técnicas.', 'That''s a good question. Let me think about it for a second… OK, so the way I see it is…', 'Buena pregunta. Déjame pensarlo un segundo… Vale, tal y como yo lo veo…', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-M4', 'COM-03', 'Mid', 'open', 'Cuéntame un reto técnico que hayas resuelto.', 'Tell me about a technical challenge you solved.', null, '{}'::text[], null, null, null, 'STAR; specific technical problem; what they personally did; concrete technologies; measurable result; correct natural English', 'In a banking project, our transaction list became very slow once clients had thousands of movements. My task was to fix it without changing the API. I profiled it and saw that every keystroke in the filter re-rendered the whole list. I optimized the change detection, added virtual scrolling and debounced the filter. Rendering time went from about two seconds to under two hundred milliseconds.', 'En un proyecto bancario, la lista de movimientos se volvió muy lenta cuando los clientes tenían miles de operaciones. Mi tarea era arreglarlo sin cambiar la API. Lo analicé y vi que cada pulsación en el filtro volvía a pintar toda la lista. Optimicé la detección de cambios, añadí virtual scroll y un debounce al filtro. El tiempo de pintado pasó de unos dos segundos a menos de doscientos milisegundos.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-S1', 'COM-03', 'Senior', 'mc', 'Para matizar una opinión de forma profesional, ¿qué frase suena mejor?', null, 'I see your point, but I''d push back a little on that, because…', array['You''re wrong.', 'No, no, no.', 'That''s a stupid idea.']::text[], 'En inglés profesional se suaviza el desacuerdo: "I''d push back a bit", "I see it slightly differently".', 'I see your point, but I''d push back a little on that, because in my experience it adds complexity we don''t need yet.', 'Entiendo lo que dices, pero no estoy del todo de acuerdo, porque en mi experiencia añade una complejidad que todavía no necesitamos.', null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-S2', 'COM-03', 'Senior', 'mc', '"Llevé a cabo la migración" →', null, 'I led / carried out the migration.', array['I realized the migration.', 'I made the migration realized.', 'I carried the migration.']::text[], 'Realize = darse cuenta. Para "realizar" usa carry out, do, lead o implement.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-S3', 'COM-03', 'Senior', 'fill', 'If I ___ known about the issue earlier, I would have fixed it before the release.', null, 'had', array['have', 'would', 'was']::text[], 'Tercer condicional: If + had + participio, would have + participio.', null, null, null, null, null, 'pending', true, null, null, null, null) on conflict (id) do nothing;
-insert into public.questions (id, topic_id, level, type, prompt, prompt_en, correct, wrong, explanation, say_en, say_es, keys, model_en, model_es, status, active, es_prompt, es_correct, es_wrong, es_explanation) values ('COM-03-S4', 'COM-03', 'Senior', 'open', 'Explícame un concepto técnico complejo como si yo no fuera técnico.', 'Explain a complex technical concept to me as if I weren''t technical.', null, '{}'::text[], null, null, null, 'pick a real concept (e.g. caching, APIs, load balancing); simple analogy; avoid jargon; check understanding; why it matters for the business; clear structure', 'Let me explain caching. Imagine a library where people keep asking for the same book. Instead of going to the basement every time, the librarian keeps a copy on the front desk. That''s a cache: we keep frequently used data close, so the answer is much faster. The trade-off is that the copy on the desk might be slightly out of date, so we decide how often to refresh it. For the business, it means faster pages and lower server costs.', 'Te explico la caché. Imagina una biblioteca donde la gente pide una y otra vez el mismo libro. En lugar de bajar al sótano cada vez, el bibliotecario deja una copia en el mostrador. Eso es una caché: guardamos cerca los datos que se usan mucho, así la respuesta es mucho más rápida. El inconveniente es que la copia del mostrador puede estar algo desactualizada, así que decidimos cada cuánto renovarla. Para el negocio significa páginas más rápidas y menos coste de servidores.', 'pending', true, null, null, null, null) on conflict (id) do nothing;
-update public.questions set model_es = coalesce(model_es, 'Un componente standalone no necesita declararse en un NgModule. Declara sus propias dependencias en el array imports, así que se ve enseguida qué usa. Supone menos código repetitivo, es más fácil cargarlo de forma diferida con loadComponent y es la forma por defecto de crear aplicaciones en las versiones recientes de Angular.') where id = 'ANG-01-J4';
-update public.questions set model_es = coalesce(model_es, 'Lo haría como un componente de presentación: recibe los datos y la configuración por inputs y emite eventos, como ordenar o hacer clic en una fila, por outputs, sin llamar a servicios. Para celdas personalizadas aceptaría plantillas con ng-template, para que cada pantalla decida cómo pintarlas. Usaría OnPush, tiparía bien la configuración de columnas y cuidaría la accesibilidad. Después documentaría su API y le haría tests de los comportamientos principales.') where id = 'ANG-01-M4';
-update public.questions set model_es = coalesce(model_es, 'Empezaría por los requisitos y el equipo: cuánto va a crecer la aplicación y cuántas personas van a trabajar en ella. Después definiría una estructura por funcionalidades con rutas de carga diferida, una librería de UI o design system compartido y una capa clara de acceso a la API. Para el estado empezaría con signals y servicios, y solo añadiría algo como NgRx si la complejidad lo justifica. Montaría linting, una estrategia de testing y CI desde el primer día, y dejaría por escrito las decisiones clave para que el equipo entienda el porqué.') where id = 'ANG-01-S4';
-update public.questions set model_es = coalesce(model_es, 'La detección de cambios es cómo Angular mantiene la pantalla sincronizada con los datos. Cuando pasa algo, como un clic o la respuesta de una petición HTTP, Angular recorre los componentes, comprueba si ha cambiado algún valor usado en la plantilla y, si es así, actualiza el DOM. Se puede hacer más eficiente con la estrategia OnPush o con signals.') where id = 'ANG-02-J4';
-update public.questions set model_es = coalesce(model_es, 'Primero mediría en vez de suponer. Usaría el profiler de Angular DevTools para ver qué componentes se revisan demasiado, y la pestaña Performance de Chrome y Lighthouse para los problemas de carga. Las causas típicas son llamadas a funciones en las plantillas, detección Default en todas partes, listas muy grandes o bundles pesados. Según la causa, aplicaría OnPush o signals, track, virtual scroll, lazy loading o bloques defer, y volvería a medir para confirmar la mejora.') where id = 'ANG-02-M4';
-update public.questions set model_es = coalesce(model_es, 'Acordaría con el equipo unas pocas métricas, como el tamaño del bundle y las Core Web Vitals, por ejemplo LCP e INP. Después las automatizaría: presupuestos de tamaño en angular.json que rompan el build y Lighthouse CI en el pipeline. Para los usuarios reales añadiría monitorización y vería los datos de campo. Y haría del rendimiento parte de las code reviews, para detectar empeoramientos pronto en lugar de arreglarlos después.') where id = 'ANG-02-S4';
-update public.questions set model_es = coalesce(model_es, 'Una Promise devuelve un único valor, empieza a ejecutarse en cuanto la creas y no se puede cancelar. Un Observable puede emitir muchos valores a lo largo del tiempo, es perezoso, así que no hace nada hasta que te suscribes, y se cancela desuscribiéndote. Además, los Observables tienen operadores como map, filter o switchMap para transformar el flujo.') where id = 'ANG-03-J4';
-update public.questions set model_es = coalesce(model_es, 'Tomaría los valueChanges del input y aplicaría debounceTime para esperar unos cientos de milisegundos, distinctUntilChanged para no repetir términos y un filtro para descartar búsquedas muy cortas. Después, switchMap hacia la llamada HTTP, para cancelar las peticiones anteriores. Dentro del switchMap pondría catchError, para que un error no rompa todo el flujo. Por último, mostraría los resultados con el pipe async o con toSignal.') where id = 'ANG-03-M4';
-update public.questions set model_es = coalesce(model_es, 'Gestionaría los errores en el nivel adecuado: dentro del observable interno con catchError, para que el flujo principal siga funcionando. Para errores de red usaría retry con espera y límite, pero solo en peticiones idempotentes. Los casos comunes, como un 401 o un 500, irían a un interceptor HTTP con un mensaje coherente para el usuario. Y siempre registraría los errores en una herramienta de monitorización en lugar de ocultarlos.') where id = 'ANG-03-S4';
-update public.questions set model_es = coalesce(model_es, 'Los signals son valores reactivos: cuando un signal cambia, todo lo que lo lee, como una plantilla o un valor computed, se entera. Se escriben con set o update y se derivan valores con computed. Angular los añadió porque permiten una detección de cambios mucho más precisa, son más sencillos que RxJS para el estado local y hacen posibles las aplicaciones sin Zone.js.') where id = 'ANG-04-J4';
-update public.questions set model_es = coalesce(model_es, 'Uso signals para el estado: el elemento seleccionado, un filtro, un indicador de carga, y valores derivados con computed. Uso observables para lo que ocurre a lo largo del tiempo y necesita coordinación, como HTTP, websockets o un buscador con debounceTime y switchMap. Se combinan bien: construyo el flujo asíncrono con RxJS y expongo el resultado en la plantilla con toSignal.') where id = 'ANG-04-M4';
-update public.questions set model_es = coalesce(model_es, 'Primero separaría los tipos de estado: el de UI local se queda en el componente, el compartido de una funcionalidad va en servicios con signals, los datos del servidor necesitan caché y gestión de carga y errores, y parte del estado pertenece a la URL. Mantendría cada pieza lo más cerca posible de donde se usa. Solo si muchas funcionalidades comparten un estado complejo añadiría una store como NgRx. En todos los casos: una única fuente de verdad, actualizaciones inmutables y buenos tests.') where id = 'ANG-04-S4';
-update public.questions set model_es = coalesce(model_es, 'La inyección de dependencias significa que una clase recibe lo que necesita en lugar de crearlo ella misma. En Angular, el inyector crea los servicios y se los da a los componentes por el constructor o con la función inject. Reduce el acoplamiento, facilita compartir una única instancia y, sobre todo, facilita los tests, porque puedes sustituir un servicio real por uno falso.') where id = 'ANG-05-J4';
-update public.questions set model_es = coalesce(model_es, 'Escribiría un interceptor funcional y lo registraría con provideHttpClient y withInterceptors. El interceptor inyecta el servicio de autenticación, clona la petición y añade la cabecera Authorization, salvo en endpoints públicos como el login. En la respuesta añado catchError: si llega un 401, intento refrescar el token una vez y repito la petición; si falla, cierro la sesión y redirijo a la pantalla de login.') where id = 'ANG-05-M4';
-update public.questions set model_es = coalesce(model_es, 'Crearía servicios tipados por dominio, idealmente generados a partir de la especificación OpenAPI del backend, para que los contratos estén siempre sincronizados. Transformaría los DTO de la API en los modelos que necesita la interfaz, para que los cambios del backend no se propaguen por todas partes. Lo transversal, como autenticación, errores y reintentos, iría en interceptores, y la URL base vendría de un injection token por entorno. Y testearía los servicios con HttpTestingController.') where id = 'ANG-05-S4';
-update public.questions set model_es = coalesce(model_es, 'Los tests detectan regresiones antes que los usuarios y dan confianza para refactorizar sin romper nada. También documentan cómo debe comportarse un componente. Y cuando se ejecutan en el pipeline de CI, el equipo recibe feedback rápido en cada cambio, que es mucho más barato que encontrar los errores a mano más tarde.') where id = 'ANG-06-J4';
-update public.questions set model_es = coalesce(model_es, 'Configuraría TestBed con el componente y un UserService falso con useValue que devuelva of() con dos usuarios. Llamo a detectChanges, busco los elementos de la lista y compruebo que hay dos con los nombres correctos. Después haría tests aparte para el estado vacío y para un error, haciendo que el servicio falso devuelva throwError y comprobando que aparece el mensaje de error.') where id = 'ANG-06-M4';
-update public.questions set model_es = coalesce(model_es, 'Seguiría la pirámide de tests: tests unitarios de servicios y componentes centrados en el comportamiento, algunos tests de integración de funcionalidades completas y un conjunto pequeño de E2E con Playwright o Cypress para los flujos críticos, como el login o el pago. Todos se ejecutan en CI y bloquean el merge si fallan. La cobertura es una guía, no un objetivo. Y los tests forman parte de la code review, para que todo el equipo se responsabilice de ellos.') where id = 'ANG-06-S4';
-update public.questions set model_es = coalesce(model_es, 'Un componente es una pieza reutilizable de la interfaz. En React moderno es simplemente una función que recibe props y devuelve JSX describiendo lo que hay que mostrar. Puede tener su propio estado con hooks como useState, y la aplicación se construye combinando componentes pequeños en otros más grandes.') where id = 'REA-01-J4';
-update public.questions set model_es = coalesce(model_es, 'Cuando cambia el estado, React programa un nuevo renderizado: vuelve a llamar a la función del componente y obtiene una nueva descripción de la interfaz. Después la compara con la anterior, lo que se llama reconciliación, y solo actualiza en el DOM lo que ha cambiado de verdad. Por defecto también se vuelven a renderizar los hijos, y varias actualizaciones de estado en el mismo evento se agrupan.') where id = 'REA-01-M4';
-update public.questions set model_es = coalesce(model_es, 'La organizaría por funcionalidades en lugar de por tipo de archivo, con un design system compartido para la interfaz común. Separaría el estado del servidor, gestionado con algo como TanStack Query, del estado local de la interfaz. TypeScript en todo el proyecto, una estructura de rutas clara y una capa de datos que oculte los detalles de la API. Además, linting, tests y convenciones por escrito, para que el código siga siendo coherente a medida que crece el equipo.') where id = 'REA-01-S4';
-update public.questions set model_es = coalesce(model_es, 'Los hooks son funciones que permiten a los componentes de función usar características de React como el estado o los efectos secundarios. Los más comunes son useState, useEffect y useContext. Tienen dos reglas: llamarlos siempre en el nivel superior y solo desde componentes u otros hooks. También puedes crear hooks propios para reutilizar lógica entre componentes.') where id = 'REA-02-J4';
-update public.questions set model_es = coalesce(model_es, 'Crearía un hook useFetch con estado para los datos, la carga y el error. Dentro de un useEffect que depende de la URL, lanzaría la petición con un AbortController y la cancelaría en la función de limpieza, para no actualizar el estado tras desmontar el componente ni con respuestas antiguas. Devuelve data, loading y error. Aunque en un proyecto real seguramente usaría TanStack Query, porque ya trae caché, reintentos y recarga de datos.') where id = 'REA-02-M4';
-update public.questions set model_es = coalesce(model_es, 'Se abusa de ellos cuando se envuelve todo por defecto. Memorizar tiene su propio coste y hace el código más difícil de leer. Tienen sentido cuando un cálculo es realmente costoso o cuando necesitas una referencia estable, por ejemplo para un hijo envuelto en memo o una dependencia de un efecto. Primero mediría con el Profiler de React, y con el React Compiler buena parte de esto se hace sola.') where id = 'REA-02-S4';
-update public.questions set model_es = coalesce(model_es, 'El prop drilling es pasar una prop por muchos componentes que no la necesitan solo para que llegue a un hijo profundo. Para evitarlo, primero pruebo con composición, pasando componentes como children. Si el dato es realmente global, como el usuario o el tema, uso Context. Y para un estado compartido complejo, una librería como Zustand o Redux Toolkit.') where id = 'REA-03-J4';
-update public.questions set model_es = coalesce(model_es, 'Lo separo en cuatro tipos. El estado local de interfaz, como si un modal está abierto, se queda en useState. El estado compartido del cliente, como el usuario que ha iniciado sesión, va en Context o en una store pequeña como Zustand. Los datos del servidor van en TanStack Query, que gestiona la caché y la recarga. Y cosas como los filtros o la página actual pertenecen a la URL, para que sobrevivan a una recarga y se puedan compartir.') where id = 'REA-03-M4';
-update public.questions set model_es = coalesce(model_es, 'Usaría una librería de estado del servidor como TanStack Query como única fuente de los datos de la API, con claves de consulta coherentes para que las pantallas compartan la caché en lugar de volver a pedir los datos. Un cliente de API tipado, idealmente generado desde OpenAPI. Reglas claras de invalidación tras cada mutación, actualizaciones optimistas donde aporten y componentes comunes para los estados de carga y error. Y evitaría copiar datos del servidor en una store global, porque crea dos fuentes de verdad.') where id = 'REA-03-S4';
-update public.questions set model_es = coalesce(model_es, 'Primero mediría con el Profiler de React y las herramientas de rendimiento del navegador, para saber si el problema son renderizados innecesarios, un cálculo pesado o un bundle grande. Después aplicaría la solución adecuada: memo para componentes que se renderizan sin motivo, useMemo para cálculos costosos, virtualización para listas largas o carga diferida para páginas grandes. Y volvería a medir para confirmar la mejora.') where id = 'REA-04-J4';
-update public.questions set model_es = coalesce(model_es, 'El code splitting consiste en dividir el bundle de JavaScript en trozos más pequeños que se cargan solo cuando hacen falta. Lo más fácil es dividir por rutas, con lazy y Suspense, para que cada página cargue su propio código. También cargaría de forma diferida componentes pesados como gráficos o editores. Y usaría un analizador de bundle para encontrar las dependencias más grandes.') where id = 'REA-04-M4';
-update public.questions set model_es = coalesce(model_es, 'Empezaría midiendo el LCP y analizando el bundle. Después: dividir el código por rutas, sustituir o cargar de forma diferida las librerías pesadas y asegurarme de que el tree shaking funciona. Si importan el SEO y el primer pintado, consideraría el renderizado en servidor o la generación estática con un framework como Next.js. Imágenes optimizadas y servidas desde un CDN, recursos críticos precargados y presupuestos de rendimiento en CI para no ir hacia atrás.') where id = 'REA-04-S4';
-update public.questions set model_es = coalesce(model_es, 'React es una librería para construir interfaces, así que todavía tienes que elegir router, configuración de build, etc. Next.js es un framework construido sobre React que te da rutas basadas en archivos, renderizado en servidor y generación estática, server components, rutas de API y muchas optimizaciones integradas. Es una solución completa para aplicaciones en producción.') where id = 'REA-05-J4';
-update public.questions set model_es = coalesce(model_es, 'Agruparía por funcionalidades: cada carpeta contiene sus componentes, hooks, llamadas a la API y tests, de modo que el código relacionado está junto. Después, una carpeta compartida para el kit de UI y los hooks comunes, una carpeta lib para utilidades y el cliente de la API, y una carpeta de rutas o páginas. La clave es tener junto lo que va junto y nombrar de forma coherente, sin demasiados niveles de anidación.') where id = 'REA-05-M4';
-update public.questions set model_es = coalesce(model_es, 'Depende del producto. Para una web pública donde importan el SEO y la primera carga, como un e-commerce o un blog, iría con Next.js y renderizado en servidor. Para un panel interno detrás de un login, una SPA es más sencilla y más barata de alojar. También tendría en cuenta la experiencia del equipo y la infraestructura. Y muchos frameworks permiten combinar los dos enfoques página a página.') where id = 'REA-05-S4';
-update public.questions set model_es = coalesce(model_es, 'Comprobaría que los campos de email y contraseña se muestran con etiquetas accesibles, que aparecen los mensajes de validación cuando están vacíos o son incorrectos y que al enviar se llama a la función de login con los valores correctos. También probaría que el botón se desactiva mientras carga y que aparece un mensaje de error si el login falla.') where id = 'REA-06-J4';
-update public.questions set model_es = coalesce(model_es, 'Usaría renderHook de Testing Library, que renderiza el hook dentro de un componente de prueba. Después compruebo los valores que devuelve y envuelvo las actualizaciones en act. Si el hook pide datos, simulo la red con MSW y espero el resultado con waitFor. A veces tiene más sentido probarlo a través de un componente real que lo use.') where id = 'REA-06-M4';
-update public.questions set model_es = coalesce(model_es, 'Combinaría automatización y prácticas de equipo. TypeScript estricto y ESLint detectan muchos problemas pronto. Tests en varios niveles, sobre todo de integración con Testing Library y unos pocos E2E para los flujos críticos, todos en CI y bloqueando el merge. Un design system con Storybook, más pruebas visuales y de accesibilidad. Pautas claras de code review. Y monitorización de errores en producción, para aprender de los problemas reales.') where id = 'REA-06-S4';
-update public.questions set model_es = coalesce(model_es, 'El cloud computing es usar recursos informáticos, como servidores, almacenamiento o bases de datos, bajo demanda a través de internet y pagando solo por lo que usas. Frente a tener tus propios servidores, no compras hardware por adelantado, puedes escalar en minutos, puedes desplegar cerca de los usuarios en cualquier parte del mundo y puedes usar servicios gestionados para dedicar menos tiempo al mantenimiento.') where id = 'CLD-01-J4';
-update public.questions set model_es = coalesce(model_es, 'Usaría Lambda para tareas cortas y basadas en eventos, como procesar un archivo cuando se sube a S3, porque escala sola y solo pagas cuando se ejecuta, aunque tiene un límite de quince minutos. Para servicios de larga duración o microservicios, usaría contenedores en ECS con Fargate, para no gestionar servidores. Y EC2 cuando necesito control total del sistema operativo o software especial.') where id = 'CLD-01-M4';
-update public.questions set model_es = coalesce(model_es, 'Usaría AWS Organizations con una landing zone, por ejemplo con Control Tower. Cuentas separadas para producción, preproducción y desarrollo, agrupadas en unidades organizativas, y cuentas dedicadas para seguridad y logs centralizados. Service Control Policies como barreras, IAM Identity Center para el inicio de sesión único, facturación consolidada y una política de etiquetado para seguir los costes por equipo.') where id = 'CLD-01-S4';
-update public.questions set model_es = coalesce(model_es, 'El usuario escribe el dominio y Route 53 lo resuelve. La petición puede pasar primero por CloudFront, un CDN. Después llega a un Application Load Balancer en una subred pública, que la reenvía a los servidores o contenedores de la aplicación en subredes privadas, permitido por los security groups. La aplicación consulta la base de datos, también en una subred privada, y la respuesta vuelve por el mismo camino.') where id = 'CLD-02-J4';
-update public.questions set model_es = coalesce(model_es, 'Crearía una VPC repartida en al menos dos zonas de disponibilidad. Las subredes públicas tendrían el balanceador y los NAT gateways. Las subredes privadas, la aplicación, y otras subredes privadas separadas, la base de datos. Los security groups irían encadenados: el balanceador llega a la aplicación y solo la aplicación llega a la base de datos. Añadiría VPC endpoints para servicios como S3 y activaría los flow logs para diagnosticar problemas.') where id = 'CLD-02-M4';
-update public.questions set model_es = coalesce(model_es, 'Primero planificaría los rangos de IP para que no se solapen. Para la conectividad, Direct Connect para un ancho de banda estable, con una VPN Site-to-Site de respaldo. Un Transit Gateway como nodo central que conecte las VPC y el centro de datos. Endpoints de Route 53 Resolver para el DNS en ambas direcciones. Y una segmentación clara con tablas de rutas y security groups, además de monitorizar los enlaces.') where id = 'CLD-02-S4';
-update public.questions set model_es = coalesce(model_es, 'Docker da a todo el mundo el mismo entorno, desde el portátil de un desarrollador hasta producción, y evita el problema de «en mi máquina funciona». Las personas nuevas pueden arrancar todo el proyecto con un comando. Cada servicio está aislado con sus dependencias, los builds son reproducibles y la misma imagen puede ejecutarse en CI, en cualquier nube o en Kubernetes.') where id = 'CLD-03-J4';
-update public.questions set model_es = coalesce(model_es, 'Elegiría ECS con Fargate cuando el equipo quiere algo sencillo y nativo de AWS: sin clúster ni nodos que gestionar y bien integrado con el resto de AWS. Elegiría EKS cuando necesitamos Kubernetes específicamente, por portabilidad entre nubes, por su ecosistema como Helm y los operadores, o porque el equipo ya tiene experiencia con Kubernetes. EKS es más potente, pero tiene más coste operativo.') where id = 'CLD-03-M4';
-update public.questions set model_es = coalesce(model_es, 'Usaría un rolling update o, para servicios críticos, un despliegue blue/green o canary. La clave son unas buenas readiness probes, para que el tráfico solo vaya a pods sanos, y un apagado ordenado, para que los pods terminen sus peticiones antes de parar. Las migraciones de base de datos tienen que ser compatibles hacia atrás. Y vigilaría la tasa de errores y la latencia durante el despliegue, con vuelta atrás automática si empeoran.') where id = 'CLD-03-S4';
-update public.questions set model_es = coalesce(model_es, 'Cuando alguien sube código o abre una pull request, arranca el pipeline. Instala las dependencias, pasa el linter y los tests, y construye el artefacto o la imagen de Docker. Después hace un análisis de seguridad y sube la imagen a un registro. Despliega automáticamente en un entorno de preproducción, ejecuta algunas pruebas ahí y, tras una aprobación, despliega en producción. El equipo recibe un aviso si algo falla.') where id = 'CLD-04-J4';
-update public.questions set model_es = coalesce(model_es, 'Escribiría módulos reutilizables para las piezas comunes, como la red o un servicio, y una configuración por entorno que use esos módulos con distintas variables. Cada entorno tiene su propio state remoto en S3 con bloqueo. El pipeline ejecuta terraform plan en cada pull request para que se vean los cambios en la revisión, y apply solo tras la aprobación. Y fijaría las versiones de los providers y de los módulos.') where id = 'CLD-04-M4';
-update public.questions set model_es = coalesce(model_es, 'Primero mediría la situación actual, por ejemplo con las métricas DORA, y hablaría con los equipos sobre los puntos de dolor. Después automatizaría paso a paso: primero builds y tests, luego infraestructura como código y luego despliegues con plantillas de pipeline estándar. Impulsaría releases más pequeñas y frecuentes, con feature flags y despliegues canary para reducir el riesgo. La parte cultural importa tanto como las herramientas.') where id = 'CLD-04-S4';
-update public.questions set model_es = coalesce(model_es, 'Empezaría con top o htop para ver el uso de CPU y memoria y qué proceso los consume. Después free para revisar la memoria y el swap, df para ver si algún disco está lleno, e iostat si sospecho de la actividad del disco. Miraría los logs del sistema y de la aplicación, y revisaría la red si parece relacionado. El objetivo es encontrar qué recurso es el cuello de botella y qué proceso lo provoca.') where id = 'CLD-05-J4';
-update public.questions set model_es = coalesce(model_es, 'Cron se ejecuta con un entorno mínimo, así que lo primero es revisar el PATH y las variables de entorno: usaría rutas absolutas para comandos y archivos. También el directorio de trabajo, que no es el mismo que cuando lo lanzo a mano, y el usuario y los permisos. Y redirigiría la salida y los errores a un archivo de log para ver qué falla realmente.') where id = 'CLD-05-M4';
-update public.questions set model_es = coalesce(model_es, 'Primero identificaría el trabajo manual repetitivo: las tareas que más repite el equipo y cuánto tiempo consumen. Después las automatizaría con scripts versionados e idempotentes, o con herramientas como SSM Automation o Lambda activadas por eventos, por ejemplo para reiniciar un servicio o limpiar discos automáticamente. Todo con logs y alertas si la automatización falla. Y, donde se pueda, daría herramientas de autoservicio a los desarrolladores para que no tengan que abrir tickets.') where id = 'CLD-05-S4';
-update public.questions set model_es = coalesce(model_es, 'Primero confirmaría el problema y su impacto, y avisaría al equipo de que me ocupo. Después revisaría qué ha cambiado recientemente, porque un despliegue nuevo es la causa más habitual, y miraría los dashboards, los health checks y los logs. Si lo ha provocado un despliegue, volvería atrás primero e investigaría después. La prioridad es recuperar el servicio y, después, hacer un postmortem sin culpables para que no se repita.') where id = 'CLD-06-J4';
-update public.questions set model_es = coalesce(model_es, 'Me centraría en los síntomas que notan los usuarios: la tasa de errores, sobre todo respuestas 5xx, la latencia en p95 o p99 y la disponibilidad. Después, métricas de saturación como CPU, memoria, conexiones a la base de datos o profundidad de las colas, que avisan antes de que algo se rompa. Cada alerta debe permitir actuar y enlazar a un runbook, con distintos niveles de gravedad, para que el equipo no acabe saturado de alertas.') where id = 'CLD-06-M4';
-update public.questions set model_es = coalesce(model_es, 'Eliminaría los puntos únicos de fallo: servicios sin estado detrás de un balanceador con autoescalado en al menos dos zonas de disponibilidad, y una base de datos Multi-AZ, como Aurora. Desacoplaría componentes con colas, para que un servicio lento no tumbe todo. Un plan de recuperación ante desastres según el RTO y el RPO acordados, y varias regiones solo si el negocio lo necesita. Además, buena observabilidad y pruebas de fallos periódicas para asegurar que realmente funciona.') where id = 'CLD-06-S4';
-update public.questions set model_es = coalesce(model_es, 'Los cuatro pilares son la encapsulación, que consiste en ocultar el estado interno y exponer métodos; la herencia, que permite a una clase reutilizar el comportamiento de otra; el polimorfismo, que permite tratar objetos distintos a través de la misma interfaz; y la abstracción, que consiste en exponer solo lo necesario y ocultar los detalles.') where id = 'BCK-01-J4';
-update public.questions set model_es = coalesce(model_es, 'Me gustan los records para clases de datos inmutables, porque eliminan mucho código repetitivo. El pattern matching en instanceof y switch hace el código más limpio, y las sealed classes permiten controlar qué clases pueden extender un tipo. Los text blocks son útiles para SQL o JSON. Y en Java 21, los virtual threads facilitan mucho atender muchas peticiones concurrentes.') where id = 'BCK-01-M4';
-update public.questions set model_es = coalesce(model_es, 'Mi primera regla es evitar el estado mutable compartido: los objetos inmutables y los servicios sin estado eliminan la mayoría de los problemas. Cuando hay que compartir estado, uso estructuras seguras para hilos como ConcurrentHashMap o las clases atómicas, y bloqueos solo donde son realmente necesarios. Para trabajo asíncrono uso executors, CompletableFuture o virtual threads. Y para la consistencia de los datos, a menudo el sitio correcto es la base de datos, con transacciones o bloqueo optimista.') where id = 'BCK-01-S4';
-update public.questions set model_es = coalesce(model_es, 'Spring Boot se construye sobre Spring para que arrancar un proyecto sea mucho más rápido. Te da autoconfiguración según las dependencias que añades, starters que agrupan librerías habituales y un servidor embebido, así que solo ejecutas un jar. Sigue el principio de convención sobre configuración, y con Actuator tienes health checks y métricas listos para producción.') where id = 'BCK-02-J4';
-update public.questions set model_es = coalesce(model_es, 'Spring Boot incluye muchas clases de autoconfiguración. Al arrancar comprueba condiciones: por ejemplo, si hay un driver de base de datos en el classpath y no has definido tú un DataSource, crea uno con tus propiedades. Esas condiciones usan anotaciones como ConditionalOnClass o ConditionalOnMissingBean. Así que siempre puedes sustituir lo que viene por defecto definiendo tu propio bean, y puedes ver qué se ha aplicado con el informe de depuración.') where id = 'BCK-02-M4';
-update public.questions set model_es = coalesce(model_es, 'Sacaría la configuración fuera del código y guardaría los secretos en un gestor de secretos. Endpoints de salud de Actuator para el balanceador y apagado ordenado. Logs estructurados con IDs de correlación, métricas con Micrometer y trazas con OpenTelemetry. Gestión de errores coherente y seguridad desde el principio. Timeouts, reintentos y circuit breakers en cada llamada externa. Y buenos tests ejecutándose en CI antes de cada despliegue.') where id = 'BCK-02-S4';
-update public.questions set model_es = coalesce(model_es, 'Una API REST es una forma de diseñar servicios web sobre HTTP. Cada recurso, como un usuario o un pedido, tiene una URL, y se usan los métodos HTTP para trabajar con él: GET para leer, POST para crear, PUT o PATCH para actualizar y DELETE para borrar. No guarda estado entre peticiones, así que cada petición lleva toda la información necesaria; los datos suelen intercambiarse en JSON y los códigos de estado indican el resultado.') where id = 'BCK-03-J4';
-update public.questions set model_es = coalesce(model_es, 'Para la paginación usaría parámetros de página y tamaño con un tamaño máximo, y devolvería metadatos como el total. Para datos muy grandes o que cambian constantemente, es mejor la paginación por cursor. Para el versionado prefiero la versión en la URL, como v1, porque es sencilla y visible. El objetivo principal es evitar cambios que rompan a los clientes: añadir campos en lugar de modificarlos y, cuando no haya más remedio, publicar una nueva versión con un periodo de retirada, todo documentado con OpenAPI.') where id = 'BCK-03-M4';
-update public.questions set model_es = coalesce(model_es, 'Diseñaría primero el contrato: definir la API en OpenAPI y revisarla antes de escribir código. Nombres coherentes, errores en un formato estándar y autenticación con OAuth2 o API keys. Límites de peticiones y cuotas por cliente, claves de idempotencia para las operaciones críticas y paginación en todas partes. Una política clara de versionado y de retirada, porque los clientes externos no pueden actualizarse rápido. Y buena documentación, además de monitorizar cómo la usa cada cliente.') where id = 'BCK-03-S4';
-update public.questions set model_es = coalesce(model_es, 'Un ORM, como Hibernate con JPA, relaciona objetos Java con tablas de la base de datos, así que trabajas con objetos en lugar de escribir todo el SQL a mano. Ahorra mucho código repetitivo y acelera el desarrollo. El inconveniente es que oculta las consultas, y puedes tener problemas de rendimiento como el N+1 si no entiendes qué está haciendo por debajo.') where id = 'BCK-04-J4';
-update public.questions set model_es = coalesce(model_es, 'Primero obtendría el SQL exacto, desde el log de consultas lentas o los logs de la aplicación, y ejecutaría EXPLAIN ANALYZE para ver el plan de ejecución. Normalmente la causa es un índice que falta, un recorrido completo de la tabla o el ORM generando demasiadas consultas. Según lo que encuentre, añadiría un índice, reescribiría la consulta, traería solo las columnas necesarias o añadiría paginación. Después volvería a medir con datos parecidos a los de producción.') where id = 'BCK-04-M4';
-update public.questions set model_es = coalesce(model_es, 'Primero mediría para saber si el problema son las lecturas, las escrituras o unas pocas consultas malas, y optimizaría esas consultas e índices, que a menudo es suficiente. Después, una caché como Redis para las lecturas frecuentes y réplicas de lectura para repartir esa carga. Un pool de conexiones bien ajustado y una instancia más grande si hace falta. Particionar o archivar los datos antiguos ayuda con tablas muy grandes. El sharding lo dejaría como último recurso, porque añade mucha complejidad.') where id = 'BCK-04-S4';
-update public.questions set model_es = coalesce(model_es, 'Un monolito es una aplicación que se despliega como una sola unidad, lo que al principio es más sencillo de desarrollar, probar y desplegar. Los microservicios dividen la aplicación en servicios independientes que se despliegan y escalan por separado, lo que da más autonomía a los equipos. Pero añaden la complejidad de un sistema distribuido: fallos de red, consistencia de los datos y una depuración mucho más difícil.') where id = 'BCK-05-J4';
-update public.questions set model_es = coalesce(model_es, 'Evitaría las transacciones distribuidas y usaría el patrón saga. El servicio de pedidos crea el pedido como pendiente y publica un evento; los servicios de pago y de stock reaccionan y, si un paso falla, los demás ejecutan acciones de compensación, como devolver el pago. Para publicar los eventos de forma fiable usaría el patrón outbox, y haría idempotentes a todos los consumidores, porque un mensaje puede llegar dos veces. El resultado es consistente a la larga, así que la interfaz debe mostrar los estados intermedios.') where id = 'BCK-05-M4';
-update public.questions set model_es = coalesce(model_es, 'Solo si hay un problema real que resolver, como equipos que se bloquean entre sí o una parte que necesita escalar de forma distinta. Muchas veces basta con un monolito modular bien estructurado. Si se hace, primero identificaría los bounded contexts y después aplicaría el patrón strangler fig: extraer un servicio cada vez, empezando por una zona bien aislada y desviando el tráfico poco a poco. Cada servicio es dueño de sus datos. Y antes de empezar me aseguraría de tener buen CI/CD y observabilidad, porque sin eso los sistemas distribuidos se vuelven muy difíciles de operar.') where id = 'BCK-05-S4';
-update public.questions set model_es = coalesce(model_es, 'Nunca en texto plano, ni con un cifrado reversible. Las guardaría con un algoritmo de hash lento pensado para contraseñas, como bcrypt o Argon2, que incluye una sal aleatoria. En Spring es sencillo con el PasswordEncoder de Spring Security. Y me aseguraría de que las contraseñas nunca se escriben en los logs.') where id = 'BCK-06-J4';
-update public.questions set model_es = coalesce(model_es, 'Configuraría la API como un resource server de OAuth2 que valida tokens JWT de un proveedor de identidad, sin estado y sin sesiones. Autorización por roles o scopes, a nivel de endpoint y con seguridad en métodos para las reglas más finas. HTTPS en todo, una configuración de CORS estricta, validación de las entradas y límite de peticiones. Y respuestas de error que no revelen detalles internos.') where id = 'BCK-06-M4';
-update public.questions set model_es = coalesce(model_es, 'Llevaría la seguridad al principio del proceso. Para cada funcionalidad nueva, una sesión rápida de análisis de amenazas. En el pipeline: análisis estático, revisión de dependencias y de secretos, y pruebas dinámicas contra preproducción. Puntos de seguridad en la checklist de code review, mínimo privilegio para cada servicio y usuario de base de datos, y formación periódica para el equipo. Además, tests de penetración periódicos y un plan claro de respuesta ante incidentes.') where id = 'BCK-06-S4';
-update public.questions set es_prompt = coalesce(es_prompt, '¿Cuál es la mejor estructura para responder a «Háblame de ti»?') where id = 'COM-01-J3';
-update public.questions set model_es = coalesce(model_es, 'Soy desarrollador web y acabo de terminar mi formación, centrada en frontend. En las prácticas trabajé en una aplicación real con un equipo pequeño, creando formularios y conectándolos a una API, y aprendí mucho sobre trabajar con Git y las code reviews. En mi tiempo libre he hecho un par de proyectos personales para practicar. Ahora busco mi primer trabajo a tiempo completo en un equipo donde seguir creciendo, y este puesto encaja justo con lo que quiero hacer.') where id = 'COM-01-J4';
-update public.questions set es_prompt = coalesce(es_prompt, 'Te preguntan «¿Cuál es tu mayor debilidad?». ¿Qué respuesta funciona mejor?'), es_correct = coalesce(es_correct, 'A veces profundizo demasiado en los detalles, así que ahora me pongo un límite de tiempo y consulto antes con el equipo.'), es_wrong = coalesce(es_wrong, array['Soy perfeccionista y trabajo demasiado.', 'La verdad es que no tengo debilidades.', 'No se me da muy bien trabajar en equipo.']::text[]) where id = 'COM-01-M1';
-update public.questions set es_explanation = coalesce(es_explanation, 'Habla en primera persona («yo propuse», «yo implementé») más que en plural: quieren saber cuál fue tu aportación.') where id = 'COM-01-M3';
-update public.questions set model_es = coalesce(model_es, 'En una release desplegué un cambio sin probarlo en pantallas pequeñas, y el botón de pago quedaba oculto en algunos móviles. En cuanto soporte lo avisó, se lo dije a mi responsable, revertí el cambio y lo arreglé en menos de una hora. Después añadí tamaños de móvil a nuestros tests visuales para que no pudiera repetirse. Aprendí a asumir los errores rápido y a arreglar el proceso, no solo el fallo.') where id = 'COM-01-M4';
-update public.questions set es_prompt = coalesce(es_prompt, '¿Cómo respondes a «Cuéntame una decisión técnica de la que te arrepientas»?') where id = 'COM-01-S2';
-update public.questions set model_es = coalesce(model_es, 'Estoy especialmente orgulloso de una migración que lideré para un cliente bancario. La aplicación era lenta y difícil de cambiar, y el negocio quería sacar funcionalidades más rápido. Propuse migrarla poco a poco en lugar de reescribirla, definí con el equipo la arquitectura objetivo y monté el pipeline y los tests. En seis meses redujimos el tiempo de carga a la mitad y pasamos de releases mensuales a semanales, sin parar el desarrollo de funcionalidades.') where id = 'COM-01-S4';
-update public.questions set es_prompt = coalesce(es_prompt, '«¿Por qué deberíamos contratarte?» ¿Qué enfoque es mejor?') where id = 'COM-02-J1';
-update public.questions set es_correct = coalesce(es_correct, '¿Cómo es un día normal para alguien en este puesto?'), es_wrong = coalesce(es_wrong, array['¿Cuántos días de vacaciones tendría?', 'Entonces, ¿a qué se dedica vuestra empresa?', 'No, no tengo ninguna pregunta.']::text[]) where id = 'COM-02-J3';
-update public.questions set model_es = coalesce(model_es, 'Dentro de cinco años me gustaría ser un desarrollador mid o senior sólido, alguien en quien el equipo pueda confiar para funcionalidades complejas. Primero quiero dominar lo básico en un producto real y después asumir más responsabilidad, como tomar decisiones técnicas y ayudar a los compañeros nuevos. Me encantaría hacer ese camino aquí, en una empresa donde pueda aprender de gente con experiencia.') where id = 'COM-02-J4';
-update public.questions set es_prompt = coalesce(es_prompt, '«Veo un hueco en tu experiencia reciente.» ¿Cómo lo enfocas?') where id = 'COM-02-M1';
-update public.questions set es_prompt = coalesce(es_prompt, '«¿Por qué dejaste tu último trabajo?» ¿Qué respondes?'), es_correct = coalesce(es_correct, 'Quería programar más y seguir creciendo, y en ese proyecto no era posible.'), es_wrong = coalesce(es_wrong, array['Mi jefe era horrible.', 'Sinceramente, necesitaba cualquier trabajo.', 'Me aburría.']::text[]) where id = 'COM-02-M2';
-update public.questions set es_prompt = coalesce(es_prompt, '«¿Qué expectativas salariales tienes?» ¿Cómo lo enfocas?') where id = 'COM-02-M3';
-update public.questions set model_es = coalesce(model_es, 'He estado leyendo sobre vuestros proyectos y me ha llamado la atención que desarrolláis aplicaciones grandes para clientes de sectores que ya conozco. Ahí es donde tengo más experiencia, así que creo que puedo aportar desde el primer día. También me gusta que trabajéis con un stack moderno, que es justo hacia donde he estado formándome. Y busco un equipo al que le importe la calidad del código, que es lo que he oído de vosotros.') where id = 'COM-02-M4';
-update public.questions set es_prompt = coalesce(es_prompt, '«¿Cómo gestionas un desacuerdo con tu responsable sobre una decisión técnica?» ¿Qué enfoque es mejor?') where id = 'COM-02-S2';
-update public.questions set es_prompt = coalesce(es_prompt, '«¿Por qué buscas un cambio después de tantos años?» ¿Qué respuesta funciona mejor?') where id = 'COM-02-S3';
-update public.questions set model_es = coalesce(model_es, 'Diría que lidero dando contexto más que órdenes: explico por qué tomamos una decisión e implico al equipo, sobre todo a quienes la van a construir. Delego trabajo con retos, pero con apoyo, y uso las code reviews para enseñar, no solo para aprobar. Intento equilibrar la calidad con entregar a tiempo. Por ejemplo, en mi último proyecto organicé conversaciones de arquitectura cada dos semanas y el equipo empezó a proponer mejoras por su cuenta.') where id = 'COM-02-S4';
-update public.questions set model_es = coalesce(model_es, 'Mi último proyecto fue una aplicación web para un equipo interno de un banco. Éramos cinco desarrolladores y yo me encargaba del frontend del módulo de informes. Construí las pantallas con Angular, las conecté a una API REST y escribí tests unitarios. El mayor reto fue mostrar tablas grandes con rapidez, y lo resolví con paginación y virtual scroll.') where id = 'COM-03-J4';
-update public.questions set model_es = coalesce(model_es, 'En un proyecto bancario, la lista de movimientos se volvió muy lenta cuando los clientes tenían miles de operaciones. Mi tarea era arreglarlo sin cambiar la API. Lo analicé y vi que cada pulsación en el filtro volvía a pintar toda la lista. Optimicé la detección de cambios, añadí virtual scroll y un debounce al filtro. El tiempo de pintado pasó de unos dos segundos a menos de doscientos milisegundos.') where id = 'COM-03-M4';
-update public.questions set model_es = coalesce(model_es, 'Te explico la caché. Imagina una biblioteca donde la gente pide una y otra vez el mismo libro. En lugar de bajar al sótano cada vez, el bibliotecario deja una copia en el mostrador. Eso es una caché: guardamos cerca los datos que se usan mucho, así la respuesta es mucho más rápida. El inconveniente es que la copia del mostrador puede estar algo desactualizada, así que decidimos cada cuánto renovarla. Para el negocio significa páginas más rápidas y menos coste de servidores.') where id = 'COM-03-S4';

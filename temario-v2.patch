+/* Escalones de nivel en cada tema */
+.steps-row { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
+.step { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; border: 2px solid var(--line);
+  background: var(--surface); font-size: .8rem; font-weight: 700; text-decoration: none; color: var(--ink); }
+.step.done { border-color: var(--navy); background: color-mix(in srgb, var(--navy) 10%, var(--surface)); }
+.step.next { border-color: var(--accent-deep); background: var(--accent); color: var(--accent-ink); }
+.step.locked { color: var(--muted); border-style: dashed; cursor: not-allowed; }
+.step .pips { display: inline-flex; gap: 2px; }
+.step .pips i { width: 6px; height: 6px; border-radius: 50%; background: var(--line); animation: none; margin: 0; }
+.step .pips i.on { background: var(--accent); }
+.block-head { margin-top: 26px; font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
+  display: flex; align-items: center; gap: 10px; }
+.block-head::after { content: ""; flex: 1; height: 2px; background: var(--line); }
+.code-input { font-family: var(--f-mono); font-size: .86rem; white-space: pre; tab-size: 2; }
